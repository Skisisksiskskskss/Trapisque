        "ClockTime": 14.5,
        "GlobalShadows": true,
        "Technology": "ShadowMap"
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true
      }
    }
