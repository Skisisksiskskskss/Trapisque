-- The brainrot catalog. Every brainrot is an original character assembled from part kits by BrainrotBuilder:
-- an everyday object body + animal features + legs + a face. Factor scales the rarity's base power and income.

export type BrainrotDef = {
	Id: string,
	Name: string,
	Rarity: number,
	Factor: number,
	Body: string,
	BodyColor: Color3,
	Accent: Color3,
	Features: { string },
	FeatureColor: Color3,
	Legs: string,
	Face: string,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

