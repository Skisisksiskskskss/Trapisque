local byId: { [string]: BrainrotDef } = {}
local byRarity: { [number]: { BrainrotDef } } = {}
for _, def in list do
	assert(byId[def.Id] == nil, "duplicate brainrot id " .. def.Id)
	byId[def.Id] = def
	local bucket = byRarity[def.Rarity]
	if bucket == nil then
		bucket = {}
		byRarity[def.Rarity] = bucket
	end
	table.insert(bucket, def)
end

local Brainrots = {
	List = list,
	ById = byId,
	ByRarity = byRarity,
}

function Brainrots.Get(id: string): BrainrotDef?
	return byId[id]
end

function Brainrots.OfRarity(rarity: number): { BrainrotDef }
	local bucket = byRarity[rarity]
	if bucket then
		return bucket
	end
	local empty: { BrainrotDef } = {}
	return empty
end

return Brainrots
