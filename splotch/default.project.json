        "$properties": {
          "Intensity": 0.6,
          "Size": 24,
          "Threshold": 1.4
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": 0.12,
          "Contrast": 0.06
        }
      }
    },
    "Players": {
      "$properties": {
        "RespawnTime": 3
      }
    }
