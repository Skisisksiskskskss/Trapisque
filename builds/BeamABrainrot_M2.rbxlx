---------------------------------------------------------------------------------------------------------------
-- Legs
---------------------------------------------------------------------------------------------------------------

local legHeights: { [string]: number } = {
	Stick = 1.6,
	Stubby = 0.8,
	Webbed = 0.9,
	Frog = 1.0,
	Flamingo = 3.0,
	Chicken = 1.6,
	Crab = 1.0,
	Tentacles = 1.4,
	None = 1.0,
}

local function buildLegs(ctx: Ctx, style: string)
	local a = ctx.a
	local h = ctx.legH
	local spread = math.clamp(a.legSpread, 0.5, 1.2)
	if style == "Stick" then
		for _, side in { -1, 1 } do
			vcyl(ctx, h, 0.3, Vector3.new(side * spread, h / 2, 0), BLACK)
			box(ctx, Vector3.new(0.6, 0.35, 0.95), CFrame.new(side * spread, 0.18, -0.15), WHITE)
		end
	elseif style == "Stubby" then
		for _, side in { -1, 1 } do
			vcyl(ctx, h + 0.1, 0.9, Vector3.new(side * spread, h / 2, 0), ctx.feature)
		end
	elseif style == "Webbed" or style == "Frog" then
		local color = if style == "Frog" then ctx.feature else ORANGE
		for _, side in { -1, 1 } do
			vcyl(ctx, h, 0.3, Vector3.new(side * spread, h / 2 + 0.1, 0), color)
			wedge(
				ctx,
				Vector3.new(0.8, 0.2, 0.9),
				CFrame.new(side * spread, 0.1, -0.35) * CFrame.Angles(0, rad(180), 0),
				color
			)
		end
	elseif style == "Flamingo" then
		local color = if ctx.feature == BLACK then PINK else Color3.fromRGB(255, 130, 170)
		for _, side in { -1, 1 } do
			vcyl(ctx, h * 0.5, 0.2, Vector3.new(side * spread * 0.6, h * 0.75, 0), color)
			ball(ctx, Vector3.one * 0.3, CFrame.new(side * spread * 0.6, h * 0.5, 0), color)
			vcyl(ctx, h * 0.5, 0.2, Vector3.new(side * spread * 0.6, h * 0.25, 0), color)
			wedge(
				ctx,
				Vector3.new(0.5, 0.15, 0.6),
				CFrame.new(side * spread * 0.6, 0.08, -0.25) * CFrame.Angles(0, rad(180), 0),
				color
			)
		end
	elseif style == "Chicken" then
		local yellow = Color3.fromRGB(250, 190, 40)
		for _, side in { -1, 1 } do
			vcyl(ctx, h, 0.25, Vector3.new(side * spread, h / 2, 0), yellow)
			for _, angle in { -30, 0, 30 } do
				box(
					ctx,
					Vector3.new(0.12, 0.12, 0.6),
					CFrame.new(side * spread, 0.06, 0) * CFrame.Angles(0, rad(angle), 0) * CFrame.new(0, 0, -0.3),
					yellow
				)
			end
		end
	elseif style == "Crab" then
		for _, side in { -1, 1 } do
			for i = -1, 1 do
				chain(ctx, {
					Vector3.new(side * a.width * 0.35, h, i * 0.5),
					Vector3.new(side * (a.width * 0.35 + 0.7), h * 0.6, i * 0.6),
					Vector3.new(side * (a.width * 0.35 + 0.9), 0.05, i * 0.7),
				}, 0.18, 0.14, ctx.feature)
			end
		end
	elseif style == "Tentacles" then
		for i = 0, 5 do
			local angle = i * math.pi / 3
			local dx, dz = math.cos(angle), math.sin(angle)
			chain(ctx, {
				Vector3.new(dx * 0.6, h + 0.2, dz * 0.6),
				Vector3.new(dx * 0.9, h * 0.5, dz * 0.9),
				Vector3.new(dx * 1.3, 0.15, dz * 1.3),
				Vector3.new(dx * 1.7, 0.25, dz * 1.7),
			}, 0.45, 0.2, ctx.feature)
		end
	end
end

---------------------------------------------------------------------------------------------------------------
-- Face
---------------------------------------------------------------------------------------------------------------

local function buildFace(ctx: Ctx, style: string)
	local a = ctx.a
	local s = a.faceScale
	local x, y, z = a.faceX, a.faceY, a.faceZ
	if not a.hideEyes then
		local eyeSize = (if a.bigEyes then 0.85 else 0.62) * s
		for _, side in { -1, 1 } do
			local ex = x + side * 0.42 * s
			if a.bigEyes then
				local ring =
					zcyl(ctx, 0.08, eyeSize * 1.45, Vector3.new(ex, y, z - 0.02), Color3.fromRGB(255, 220, 120))
				keep(ring)
			end
			local eye = ball(ctx, Vector3.new(eyeSize, eyeSize, eyeSize * 0.5), CFrame.new(ex, y, z - 0.05), WHITE)
			keep(eye)
			local px = ex
			local py = y
			if style == "Derp" then
				px += side * 0.08 * s
				py += side * 0.08 * s
			end
			local pupil = ball(
				ctx,
				Vector3.new(eyeSize * 0.48, eyeSize * 0.48, eyeSize * 0.3),
				CFrame.new(px, py, z - 0.2 * s),
				BLACK
			)
			keep(pupil)
			if style == "Angry" then
				local brow = box(
					ctx,
					Vector3.new(0.5 * s, 0.12 * s, 0.08),
					CFrame.new(ex, y + 0.42 * s, z - 0.08) * CFrame.Angles(0, 0, rad(side * 20)),
					BLACK
				)
				keep(brow)
			end
		end
		if style == "Cool" then
			local shades = box(ctx, Vector3.new(1.5 * s, 0.38 * s, 0.1), CFrame.new(x, y + 0.02, z - 0.28 * s), BLACK)
			shades.Reflectance = 0.3
			keep(shades)
		end
	end
	if not a.hideMouth then
		local my = y - 0.55 * s
		if style == "Happy" or style == "Cool" then
			for i = -1, 1 do
				local seg = box(
					ctx,
					Vector3.new(0.28 * s, 0.1 * s, 0.06),
					CFrame.new(x + i * 0.24 * s, my + math.abs(i) * 0.08 * s, z - 0.04)
						* CFrame.Angles(0, 0, rad(i * 25)),
					BLACK
				)
				keep(seg)
			end
		elseif style == "Derp" then
			local mouth = ball(
				ctx,
				Vector3.new(0.45 * s, 0.35 * s, 0.08),
				CFrame.new(x + 0.1 * s, my, z - 0.04),
				Color3.fromRGB(120, 20, 30)
			)
			keep(mouth)
			local tongue =
				ball(ctx, Vector3.new(0.22 * s, 0.18 * s, 0.06), CFrame.new(x + 0.12 * s, my - 0.1 * s, z - 0.07), PINK)
			keep(tongue)
		else
			local mouth = box(ctx, Vector3.new(0.6 * s, 0.1 * s, 0.06), CFrame.new(x, my, z - 0.04), BLACK)
			keep(mouth)
		end
	end
end

---------------------------------------------------------------------------------------------------------------
-- Mutation + rarity dressing
---------------------------------------------------------------------------------------------------------------

local function applyMutation(model: Model, parts: { BasePart }, mutationName: string)
	local mutation = Mutations.Get(mutationName)
	if mutation.Name == "None" or mutation.Color == nil then
		return
	end
	local tint = mutation.Color :: Color3
	for _, part in parts do
		if part:GetAttribute("KeepColor") then
			continue
		end
		if mutation.Name == "Gold" then
			part.Color = part.Color:Lerp(tint, 0.75)
			part.Material = Enum.Material.SmoothPlastic
			part.Reflectance = 0.35
		elseif mutation.Name == "Diamond" then
			part.Color = part.Color:Lerp(tint, 0.7)
			part.Material = Enum.Material.Glass
			part.Transparency = math.max(part.Transparency, 0.12)
		elseif mutation.Name == "Rainbow" then
			part.Material = Enum.Material.SmoothPlastic
		elseif mutation.Name == "Galaxy" then
			part.Color = part.Color:Lerp(tint, 0.8)
			part.Material = Enum.Material.Glass
		end
	end
	if mutation.Name == "Rainbow" then
		for i, part in parts do
			if not part:GetAttribute("KeepColor") then
				part.Color = Color3.fromHSV((i * 0.07) % 1, 0.75, 1)
			end
		end
		model:SetAttribute("Rainbow", true)
	end
end

local function addAura(root: BasePart, color: Color3, rate: number, texture: string)
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, 2, 0)
	attachment.Parent = root
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = texture
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.8
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.8, 1.6)
	emitter.Speed = NumberRange.new(1, 3)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = rate
	emitter.Parent = attachment
end

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local function dress(model: Model, root: BasePart, rarityIndex: number, mutationName: string)
	local rarity = Rarities.Get(rarityIndex)
	if rarityIndex >= 5 then
		local light = Instance.new("PointLight")
		light.Color = if rarityIndex == 8 then Color3.new(1, 1, 1) else rarity.Color
		light.Range = 12
		light.Brightness = 1.4
		light.Parent = root
		addAura(
			root,
			if rarityIndex == 8 then Color3.new(1, 1, 1) else rarity.Color,
			4 + (rarityIndex - 5) * 4,
			SPARKLE
		)
	end
	if mutationName == "Diamond" then
		addAura(root, Color3.fromRGB(200, 240, 255), 6, SPARKLE)
	elseif mutationName == "Galaxy" then
		addAura(root, Color3.fromRGB(200, 160, 255), 12, SPARKLE)
	elseif mutationName == "Gold" then
		addAura(root, Color3.fromRGB(255, 220, 90), 3, SPARKLE)
	end
	model:SetAttribute("RarityIndex", rarityIndex)
end

---------------------------------------------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------------------------------------------

export type BuildOptions = {
	Mutation: string?,
	Scale: number?,
	Effects: boolean?, -- particles/lights (off for tiny UI previews)
}

-- Returns a Model whose pivot is the feet centre, facing -Z, with an anchored invisible Root as PrimaryPart.
function BrainrotBuilder.Build(id: string, options: BuildOptions?): Model
	local def = Brainrots.Get(id)
	assert(def ~= nil, "unknown brainrot " .. id)
	local opts: BuildOptions = options or {}
	local mutation = opts.Mutation or "None"
	local scale = opts.Scale or 1

	local model = Instance.new("Model")
	model.Name = def.Name
	local ctx: Ctx = {
		model = model,
		parts = {},
		color = def.BodyColor,
		accent = def.Accent,
		feature = def.FeatureColor,
		legH = legHeights[def.Legs] or 1,
		a = defaultAnchors(0, 2, 2, 2),
	}

	local bodyBuilder = bodies[def.Body]
	assert(bodyBuilder ~= nil, "unknown body kit " .. def.Body)
	ctx.a = bodyBuilder(ctx)
	for _, featureName in def.Features do
		local featureBuilder = features[featureName]
		assert(featureBuilder ~= nil, "unknown feature kit " .. featureName)
		featureBuilder(ctx)
	end
	buildFace(ctx, def.Face)
	buildLegs(ctx, def.Legs)

	-- Scale every part around the feet origin.
	if scale ~= 1 then
		for _, part in ctx.parts do
			local cf = part.CFrame
			part.Size *= scale
			part.CFrame = CFrame.new(cf.Position * scale) * cf.Rotation
		end
	end

	applyMutation(model, ctx.parts, mutation)

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.one
	root.CFrame = CFrame.identity
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Parent = model
	model.PrimaryPart = root

	for _, part in ctx.parts do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
	end

	if opts.Effects ~= false then
		dress(model, root, def.Rarity, mutation)
	end

	model:SetAttribute("BrainrotId", id)
	model:SetAttribute("Mutation", mutation)
	model:SetAttribute("Height", (ctx.a.top + 0.3) * scale)
	model:SetAttribute("Width", math.max(ctx.a.width, ctx.a.depth) * scale)
	return model
end

local dimensionCache: { [string]: Vector2 } = {}

-- Natural (unscaled) width/height of a brainrot, measured once and cached.
function BrainrotBuilder.Dimensions(id: string): Vector2
	local cached = dimensionCache[id]
	if cached then
		return cached
	end
	local probe = BrainrotBuilder.Build(id, { Effects = false })
	local dims = Vector2.new(probe:GetAttribute("Width") :: number, probe:GetAttribute("Height") :: number)
	probe:Destroy()
	dimensionCache[id] = dims
	return dims
end

-- Scale that fits a brainrot inside a box of the given height and width (used for pedestals and UI).
function BrainrotBuilder.FitScale(id: string, maxHeight: number, maxWidth: number): number
	local dims = BrainrotBuilder.Dimensions(id)
	return math.min(maxHeight / dims.Y, maxWidth / dims.X, 1.4)
end

function BrainrotBuilder.HasKits(def: Brainrots.BrainrotDef): (boolean, string?)
	if bodies[def.Body] == nil then
		return false, "body " .. def.Body
	end
	for _, featureName in def.Features do
		if features[featureName] == nil then
			return false, "feature " .. featureName
		end
	end
	if legHeights[def.Legs] == nil then
		return false, "legs " .. def.Legs
	end
	return true, nil
end

return BrainrotBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">BrainrotStats</string>
            <string name="Source"><![CDATA[--!strict
-- Pure stat math for a brainrot instance (catalog entry + mutation + size).

local Brainrots = require(script.Parent.Parent.Config.Brainrots)
local Mutations = require(script.Parent.Parent.Config.Mutations)
local Rarities = require(script.Parent.Parent.Config.Rarities)
local Sizes = require(script.Parent.Parent.Config.Sizes)

local BrainrotStats = {}

function BrainrotStats.Power(id: string, mutation: string, size: string): number
	local def = Brainrots.Get(id)
	if def == nil then
		return 0
	end
	local rarity = Rarities.Get(def.Rarity)
	return rarity.BasePower * def.Factor * Mutations.Get(mutation).PowerMult * Sizes.Get(size).Mult
end

function BrainrotStats.Income(id: string, mutation: string, size: string): number
	local def = Brainrots.Get(id)
	if def == nil then
		return 0
	end
	local rarity = Rarities.Get(def.Rarity)
	return rarity.BaseIncome * def.Factor * Mutations.Get(mutation).IncomeMult * Sizes.Get(size).Mult
end

-- Display name, e.g. "Huge Gold Toastino Pinguino".
function BrainrotStats.DisplayName(id: string, mutation: string, size: string): string
	local def = Brainrots.Get(id)
	local name = if def then def.Name else "???"
	if mutation ~= "None" then
		name = mutation .. " " .. name
	end
	if size ~= "Normal" then
		name = size .. " " .. name
	end
	return name
end

-- Key used by the Index (collection book).
function BrainrotStats.IndexKey(id: string, mutation: string): string
	return id .. "|" .. mutation
end

return BrainrotStats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">DataSchema</string>
            <string name="Source"><![CDATA[--!strict
-- Player save schema: template, versioned migrations and reconciliation. Pure (no Roblox APIs) and unit-tested.

export type BrainrotRecord = {
	Uid: string,
	Id: string,
	Mutation: string,
	Size: string,
	Obtained: number,
	StolenAt: number?,
}

export type PlayerData = {
	Version: number,
	Cash: number,
	LifetimeCash: number,
	Tier: number,
	CrystalLevel: number,
	DoorLevel: number,
	Rebirths: number,
	Brainrots: { [string]: BrainrotRecord },
	Slots: { [string]: string },
	NextUid: number,
	Index: { [string]: boolean },
	IndexClaimed: { [string]: boolean },
	Boosts: { [string]: number },
	Daily: { Streak: number, LastClaim: number },
	Codes: { [string]: boolean },
	Stats: { [string]: number },
	Tutorial: number,
	LastOnline: number,
	FirstJoin: number,
	Receipts: { string },
	Settings: { Music: boolean, Sfx: boolean },
	PlaytimeGiftDay: number,
	PlaytimeClaimed: { [string]: boolean },
}

local DataSchema = {}

DataSchema.CurrentVersion = 2
DataSchema.MaxReceipts = 100

local function template(): PlayerData
	return {
		Version = DataSchema.CurrentVersion,
		Cash = 0,
		LifetimeCash = 0,
		Tier = 1,
		CrystalLevel = 1,
		DoorLevel = 1,
		Rebirths = 0,
		Brainrots = {},
		Slots = {},
		NextUid = 1,
		Index = {},
		IndexClaimed = {},
		Boosts = { Overcharge = 0, IronDoor = 0, LuckyWave = 0, GoldenWave = 0, InstantRepair = 0 },
		Daily = { Streak = 0, LastClaim = 0 },
		Codes = {},
		Stats = { Captures = 0, Steals = 0, Stolen = 0, Bosses = 0, Playtime = 0, DoorsBroken = 0 },
		Tutorial = 0,
		LastOnline = 0,
		FirstJoin = 0,
		Receipts = {},
		Settings = { Music = true, Sfx = true },
		PlaytimeGiftDay = 0,
		PlaytimeClaimed = {},
	}
end

DataSchema.Template = template

-- Migrations[n] upgrades a version-n save to version n+1.
local migrations: { [number]: (any) -> any } = {
	[1] = function(data: any): any
		-- v1 -> v2: adds per-day playtime gift tracking.
		data.PlaytimeGiftDay = 0
		data.PlaytimeClaimed = {}
		data.Version = 2
		return data
	end,
}
DataSchema.Migrations = migrations

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end
DataSchema.DeepCopy = deepCopy

-- Fills any missing keys from the template without touching existing values. Only recurses into
-- dictionary-shaped template tables that have keys (empty template tables are treated as opaque maps).
local function reconcile(target: any, source: any)
	for key, value in source do
		if target[key] == nil then
			target[key] = deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(target[key], value)
		end
	end
end

function DataSchema.Migrate(raw: any): (PlayerData, boolean)
	-- Returns the migrated data and whether it was upgraded from an older version.
	if type(raw) ~= "table" then
		return template(), false
	end
	local data = raw
	local version = tonumber(data.Version) or 1
	local upgraded = false
	while version < DataSchema.CurrentVersion do
		local step = migrations[version]
		assert(step ~= nil, "missing migration from version " .. version)
		data = step(data)
		version = tonumber(data.Version) or version + 1
		upgraded = true
	end
	reconcile(data, template())
	return data :: PlayerData, upgraded
end

function DataSchema.IsNewer(raw: any): boolean
	-- True when a save was written by a newer build than this server knows. Such saves must not be touched.
	return type(raw) == "table" and (tonumber(raw.Version) or 0) > DataSchema.CurrentVersion
end

function DataSchema.AddReceipt(data: PlayerData, purchaseId: string)
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > DataSchema.MaxReceipts do
		table.remove(data.Receipts, 1)
	end
end

function DataSchema.HasReceipt(data: PlayerData, purchaseId: string): boolean
	return table.find(data.Receipts, purchaseId) ~= nil
end

function DataSchema.NewUid(data: PlayerData): string
	local uid = tostring(data.NextUid)
	data.NextUid += 1
	return uid
end

function DataSchema.CountBrainrots(data: PlayerData): number
	local count = 0
	for _ in data.Brainrots do
		count += 1
	end
	return count
end

return DataSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Number and time formatting for UI.

local Format = {}

local suffixes = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234 -> "1.23K", 15 -> "15", 999999 -> "1M"
function Format.Short(value: number): string
	if value ~= value then
		return "0"
	end
	local negative = value < 0
	local n = math.abs(value)
	if n < 1000 then
		local text = if n >= 100 or n == math.floor(n) then tostring(math.floor(n)) else string.format("%.1f", n)
		return (if negative then "-" else "") .. text
	end
	local index = 1
	while n >= 999.5 and index < #suffixes do
		n /= 1000
		index += 1
	end
	local text
	if n >= 100 then
		text = string.format("%d", math.floor(n + 0.5))
	elseif n >= 10 then
		text = string.format("%.1f", math.floor(n * 10 + 0.5) / 10)
	else
		text = string.format("%.2f", math.floor(n * 100 + 0.5) / 100)
	end
	text = string.gsub(text, "%.?0+$", "")
	return (if negative then "-" else "") .. text .. suffixes[index]
end

function Format.Cash(value: number): string
	return "$" .. Format.Short(value)
end

function Format.Commas(value: number): string
	local text = tostring(math.floor(value))
	local result = string.reverse(text)
	result = string.gsub(result, "(%d%d%d)", "%1,")
	result = string.reverse(result)
	if string.sub(result, 1, 1) == "," then
		result = string.sub(result, 2)
	end
	return result
end

-- 75 -> "1:15", 3725 -> "1:02:05"
function Format.Clock(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	local h = s // 3600
	local m = (s % 3600) // 60
	local sec = s % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, sec)
	end
	return string.format("%d:%02d", m, sec)
end

-- 3725 -> "1h 2m", 75 -> "1m 15s"
function Format.Duration(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	local h = s // 3600
	local m = (s % 3600) // 60
	local sec = s % 60
	if h > 0 then
		return string.format("%dh %dm", h, m)
	elseif m > 0 then
		return string.format("%dm %ds", m, sec)
	end
	return string.format("%ds", sec)
end

function Format.Percent(fraction: number): string
	local pct = fraction * 100
	if pct >= 10 then
		return string.format("%d%%", math.floor(pct + 0.5))
	elseif pct >= 1 then
		return string.format("%.1f%%", pct)
	elseif pct >= 0.01 then
		return string.format("%.2f%%", pct)
	end
	return string.format("%.4f%%", pct)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">MapGeometry</string>
            <string name="Source"><![CDATA[--!strict
-- Map layout math shared by the server (building, outcomes) and clients (animating waves and escapes).

local GameConfig = require(script.Parent.Parent.Config.GameConfig)

local MapGeometry = {}

function MapGeometry.PlotAngle(index: number): number
	return (index - 1) * (2 * math.pi / GameConfig.MaxPlots)
end

function MapGeometry.PlotCFrame(index: number): CFrame
	local angle = MapGeometry.PlotAngle(index)
	local radius = GameConfig.BaseFrontRadius + GameConfig.BaseSize / 2
	local center = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
	return CFrame.lookAt(center, Vector3.new(0, 0, 0))
end

-- Where a plot's wave brainrot stops for the showdown (in front of the door).
function MapGeometry.StopPosition(index: number): Vector3
	local angle = MapGeometry.PlotAngle(index)
	local r = GameConfig.BaseFrontRadius - GameConfig.BeamStopDistance
	return Vector3.new(math.cos(angle) * r, 0.3, math.sin(angle) * r)
end

function MapGeometry.PortalEdge(index: number): Vector3
	local angle = MapGeometry.PlotAngle(index)
	local r = GameConfig.PortalRadius
	return Vector3.new(math.cos(angle) * r, 0.3, math.sin(angle) * r)
end

function MapGeometry.RingPosition(angle: number, radius: number): Vector3
	return Vector3.new(math.cos(angle) * radius, 0.3, math.sin(angle) * radius)
end

function MapGeometry.DoorPosition(index: number): Vector3
	local angle = MapGeometry.PlotAngle(index)
	local r = GameConfig.BaseFrontRadius
	return Vector3.new(math.cos(angle) * r, 0.3, math.sin(angle) * r)
end

return MapGeometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
-- Remote definitions. The server creates every remote at boot; clients wait for them by name.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.EventNames = {
	-- server -> client
	"State", -- full player state snapshot
	"Notify", -- toast for one player
	"Announce", -- big banner for everyone
	"WaveStart", -- list of incoming brainrots
	"WaveResult", -- outcome per plot
	"EscapeStart", -- an escaped brainrot starts its lap
	"EscapeEnd", -- escaped brainrot captured or gone
	"Knockback", -- bonk impulse to apply locally
	"Effect", -- generic VFX cue (cash pop, tier up, etc.)
	"OfflineEarnings", -- welcome-back popup
	"ServerInfo", -- event + timers broadcast
	-- client -> server
	"Charge", -- one tap of the charge button
	"Settings", -- toggle music / sfx
	"TutorialStep", -- tutorial progress
	"Repair", -- hold-to-repair tick at your own broken door
	"Steal", -- (plotIndex, slot) grab a brainrot from a raidable base
}

Net.FunctionNames = {
	"Upgrade", -- ("Crystal" | "Door" | "Tier") -> (ok, message)
	"Rebirth",
	"Inventory", -- (action, uid) -> (ok, message)
	"ClaimDaily",
	"RedeemCode",
	"ClaimGift",
	"UseBoost",
	"GetShopInfo", -- odds + scaled cash amounts for the shop UI
	"ClaimIndex", -- (rarityIndex) claim an Index set reward
}

local FOLDER_NAME = "Remotes"

function Net.Setup()
	assert(RunService:IsServer(), "Net.Setup is server-only")
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	for _, name in Net.EventNames do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	for _, name in Net.FunctionNames do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
	end
	folder.Parent = ReplicatedStorage
end

local function folder(): Instance
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

function Net.Event(name: string): RemoteEvent
	return folder():WaitForChild(name) :: RemoteEvent
end

function Net.Function(name: string): RemoteFunction
	return folder():WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal synchronous signal. Handlers run in order; errors in one handler don't stop the others.

export type Connection = {
	Disconnect: (self: Connection) -> (),
	Connected: boolean,
}

export type Signal<T...> = {
	Connect: (self: Signal<T...>, handler: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	Once: (self: Signal<T...>, handler: (T...) -> ()) -> Connection,
}

local Signal = {}

function Signal.new<T...>(): Signal<T...>
	local handlers: { { fn: (T...) -> (), conn: Connection } } = {}
	local self = {} :: Signal<T...>

	function self.Connect(_: Signal<T...>, handler: (T...) -> ()): Connection
		local entry = { fn = handler, conn = (nil :: any) :: Connection }
		local conn = {} :: Connection
		conn.Connected = true
		function conn.Disconnect(c: Connection)
			if not c.Connected then
				return
			end
			c.Connected = false
			local index = table.find(handlers, entry)
			if index then
				table.remove(handlers, index)
			end
		end
		entry.conn = conn
		table.insert(handlers, entry)
		return conn
	end

	function self.Once(s: Signal<T...>, handler: (T...) -> ()): Connection
		local conn: Connection
		conn = s:Connect(function(...: T...)
			conn:Disconnect()
			handler(...)
		end)
		return conn
	end

	function self.Fire(_: Signal<T...>, ...: T...)
		local snapshot = table.clone(handlers)
		for _, entry in snapshot do
			if entry.conn.Connected then
				local ok, err = pcall(entry.fn :: any, ...)
				if not ok then
					warn("[Signal] handler error: " .. tostring(err))
				end
			end
		end
	end

	return self
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">WaveRoll</string>
            <string name="Source"><![CDATA[--!strict
-- Pure, deterministic-given-RNG wave rolls. Used by the server; covered by tests/waveroll.spec.luau.

local Brainrots = require(script.Parent.Parent.Config.Brainrots)
local Mutations = require(script.Parent.Parent.Config.Mutations)
local Rarities = require(script.Parent.Parent.Config.Rarities)
local Sizes = require(script.Parent.Parent.Config.Sizes)
local BrainrotStats = require(script.Parent.BrainrotStats)

export type Rng = {
	NextNumber: (self: Rng) -> number,
}

export type Roll = {
	Id: string,
	Mutation: string,
	Size: string,
	Power: number,
	Income: number,
	Rarity: number,
	Boss: boolean,
	Guaranteed: boolean,
}

export type RollParams = {
	Tier: number,
	Rebirths: number,
	Luck: number, -- 1 = normal
	MutationMult: { [string]: number }?, -- per-mutation chance multipliers from events / luck
	ForcedMutation: string?,
}

local WaveRoll = {}

local function pickWeighted<T>(rng: Rng, items: { T }, weights: { number }): T
	local total = 0
	for _, w in weights do
		total += w
	end
	local roll = rng:NextNumber() * total
	for i, w in weights do
		roll -= w
		if roll <= 0 then
			return items[i]
		end
	end
	return items[#items]
end

local function pickFromList<T>(rng: Rng, items: { T }): T
	local index = math.clamp(math.floor(rng:NextNumber() * #items) + 1, 1, #items)
	return items[index]
end

function WaveRoll.RarityOdds(tier: number, rebirths: number, luck: number): { { Rarity: number, Chance: number } }
	local window = Rarities.Window(tier, rebirths)
	local weights = {}
	local total = 0
	for position, rarityIndex in window do
		local w = Rarities.Get(rarityIndex).Weight * luck ^ (position - 1)
		weights[position] = w
		total += w
	end
	local odds = {}
	for position, rarityIndex in window do
		table.insert(odds, { Rarity = rarityIndex, Chance = weights[position] / total })
	end
	return odds
end

function WaveRoll.RollRarity(rng: Rng, tier: number, rebirths: number, luck: number): number
	local odds = WaveRoll.RarityOdds(tier, rebirths, luck)
	local items = {}
	local weights = {}
	for _, entry in odds do
		table.insert(items, entry.Rarity)
		table.insert(weights, entry.Chance)
	end
	return pickWeighted(rng, items, weights)
end

function WaveRoll.RollSize(rng: Rng): string
	local items = {}
	local weights = {}
	for _, size in Sizes.List do
		table.insert(items, size.Name)
		table.insert(weights, size.Weight)
	end
	return pickWeighted(rng, items, weights)
end

function WaveRoll.RollMutation(rng: Rng, mult: { [string]: number }?): string
	-- Check rarest first so a lucky roll is never shadowed by a common one.
	for i = #Mutations.List, 2, -1 do
		local mutation = Mutations.List[i]
		local factor = if mult then (mult[mutation.Name] or 1) else 1
		if rng:NextNumber() * 100 < mutation.Chance * factor then
			return mutation.Name
		end
	end
	return "None"
end

local function finish(id: string, mutation: string, size: string, boss: boolean, guaranteed: boolean): Roll
	local def = Brainrots.ById[id]
	return {
		Id = id,
		Mutation = mutation,
		Size = size,
		Power = BrainrotStats.Power(id, mutation, size),
		Income = BrainrotStats.Income(id, mutation, size),
		Rarity = def.Rarity,
		Boss = boss,
		Guaranteed = guaranteed,
	}
end

function WaveRoll.RollNormal(rng: Rng, params: RollParams): Roll
	local rarity = WaveRoll.RollRarity(rng, params.Tier, params.Rebirths, params.Luck)
	local def = pickFromList(rng, Brainrots.ByRarity[rarity])
	local size = WaveRoll.RollSize(rng)
	local mutation = params.ForcedMutation or WaveRoll.RollMutation(rng, params.MutationMult)
	return finish(def.Id, mutation, size, false, false)
end

-- Boss: a brainrot whose power lands in [minMult, maxMult] x the player's crystal power.
function WaveRoll.RollBoss(rng: Rng, params: RollParams, crystalPower: number, minMult: number, maxMult: number): Roll
	local window = Rarities.Window(params.Tier, params.Rebirths)
	local top = window[#window]
	local highest = math.min(Rarities.Count, top + 1)
	local lowest = math.max(1, top - 2)
	local mutation = params.ForcedMutation or WaveRoll.RollMutation(rng, params.MutationMult)
	local candidates: { { id: string, size: string } } = {}
	local bestId, bestSize, bestDistance = "", "Normal", math.huge
	for rarity = lowest, highest do
		local bucket: { Brainrots.BrainrotDef } = Brainrots.OfRarity(rarity)
		for _, def in bucket do
			for _, size in Sizes.List do
				local power = BrainrotStats.Power(def.Id, mutation, size.Name)
				local ratio = power / math.max(crystalPower, 1)
				if ratio >= minMult and ratio <= maxMult then
					table.insert(candidates, { id = def.Id, size = size.Name })
				end
				local distance = math.abs(math.log(math.max(ratio, 1e-9) / ((minMult + maxMult) / 2)))
				if distance < bestDistance then
					bestDistance = distance
					bestId = def.Id
					bestSize = size.Name
				end
			end
		end
	end
	if #candidates > 0 then
		local pick = pickFromList(rng, candidates)
		return finish(pick.id, mutation, pick.size, true, false)
	end
	return finish(bestId, mutation, bestSize, true, false)
end

-- Lucky Wave odds: rarities at or above the window's top, weighted by base rarity weight.
function WaveRoll.LuckyOdds(tier: number, rebirths: number): { { Rarity: number, Chance: number } }
	local window = Rarities.Window(tier, rebirths)
	local anchor = window[#window]
	if #window >= 2 and Rarities.Get(anchor).Weight < 0.05 then
		-- Secret jackpot at the end of the window: anchor on the rarity before it, keep Secret as a jackpot.
		anchor = window[#window - 1]
	end
	local highest = Rarities.HighestUnlocked(tier, rebirths)
	local entries = {}
	local total = 0
	for rarity = anchor, highest do
		local w = Rarities.Get(rarity).Weight
		total += w
		table.insert(entries, { Rarity = rarity, Chance = w })
	end
	for _, entry in entries do
		entry.Chance = entry.Chance / total
	end
	return entries
end

function WaveRoll.RollLucky(rng: Rng, params: RollParams): Roll
	local odds = WaveRoll.LuckyOdds(params.Tier, params.Rebirths)
	local items = {}
	local weights = {}
	for _, entry in odds do
		table.insert(items, entry.Rarity)
		table.insert(weights, entry.Chance)
	end
	local rarity = pickWeighted(rng, items, weights)
	local def = pickFromList(rng, Brainrots.ByRarity[rarity])
	local mutation = params.ForcedMutation or WaveRoll.RollMutation(rng, params.MutationMult)
	return finish(def.Id, mutation, "Normal", false, true)
end

function WaveRoll.Tutorial(): Roll
	return finish("toastino_pinguino", "None", "Normal", false, true)
end

function WaveRoll.FromSpec(id: string, mutation: string, size: string): Roll
	return finish(id, mutation, size, false, false)
end

return WaveRoll
]]></string>
