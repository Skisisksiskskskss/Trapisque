        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">BaseBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Builds a themed base (walls, door, pillar, crystal, pedestals) from parts. Pure geometry: no game state.
-- Local space: origin = plot centre on the ground, -Z faces the map centre (the door side), floor top at y = 1.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Themes = require(Shared.Config.Themes)
local Economy = require(Shared.Config.Economy)

local BaseBuilder = {}

BaseBuilder.Size = 64
BaseBuilder.WallHeight = 12
BaseBuilder.DoorWidth = 12
BaseBuilder.FloorTop = 1
BaseBuilder.CrystalHeight = 30

local SLOT_POSITIONS: { Vector3 } = {}
do
	local rows = { -20, -12, -4, 4, 12, 20 }
	for _, column in { 16, 25 } do
		for _, z in rows do
			table.insert(SLOT_POSITIONS, Vector3.new(-column, 0, z))
			table.insert(SLOT_POSITIONS, Vector3.new(column, 0, z))
		end
	end
end
BaseBuilder.SlotPositions = SLOT_POSITIONS
BaseBuilder.MaxSlots = #SLOT_POSITIONS

type Builder = {
	root: CFrame,
	parent: Instance,
}

local function part(
	b: Builder,
	size: Vector3,
	localCf: CFrame,
	color: Color3,
	material: Enum.Material,
	name: string?,
	className: string?
): BasePart
	local p = Instance.new(className or "Part") :: BasePart
	p.Name = name or "Part"
	p.Size = size
	p.CFrame = b.root * localCf
	p.Color = color
	p.Material = material
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = b.parent
	return p
end

local function cylinder(
	b: Builder,
	height: number,
	diameter: number,
	localPos: Vector3,
	color: Color3,
	material: Enum.Material,
	name: string?
): BasePart
	local p = part(
		b,
		Vector3.new(height, diameter, diameter),
		CFrame.new(localPos) * CFrame.Angles(0, 0, math.rad(90)),
		color,
		material,
		name
	);
	(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

local function sphere(b: Builder, size: Vector3, localCf: CFrame, color: Color3, material: Enum.Material): BasePart
	local p = part(b, size, localCf, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function noCollide(p: BasePart)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
end

---------------------------------------------------------------------------------------------------------------
-- Crystal styles. Each builds around local origin (crystal centre) and returns nothing; parts go in b.parent.
---------------------------------------------------------------------------------------------------------------

local crystalStyles: { [string]: (Builder, Themes.Theme, number) -> () } = {}

local function shard(
	b: Builder,
	height: number,
	width: number,
	localCf: CFrame,
	color: Color3,
	material: Enum.Material?
)
	local mat = material or Enum.Material.Glass
	local body = part(b, Vector3.new(width, height, width), localCf, color, mat)
	body.Transparency = 0.15
	noCollide(body)
	local tip = part(
		b,
		Vector3.new(width, width * 1.2, width),
		localCf * CFrame.new(0, height / 2 + width * 0.6, 0) * CFrame.Angles(0, math.rad(45), 0),
		color,
		mat,
		"Tip",
		"WedgePart"
	)
	tip.Transparency = 0.15
	noCollide(tip)
end

crystalStyles.Totem = function(b, theme, s)
	local wood = Color3.fromRGB(110, 75, 45)
	local c1 = cylinder(b, 3 * s, 2.2 * s, Vector3.new(0, -2.5 * s, 0), wood, Enum.Material.Wood)
	noCollide(c1)
	shard(b, 3.2 * s, 2.2 * s, CFrame.new(0, 0.6 * s, 0) * CFrame.Angles(0, math.rad(20), math.rad(8)), theme.Crystal)
	shard(b, 2 * s, 1.2 * s, CFrame.new(1.2 * s, 0, 0.3 * s) * CFrame.Angles(0, 0, math.rad(-25)), theme.Crystal)
	shard(
		b,
		1.8 * s,
		1.1 * s,
		CFrame.new(-1.1 * s, -0.2 * s, -0.4 * s) * CFrame.Angles(0, 0, math.rad(25)),
		theme.Crystal
	)
end

crystalStyles.Obelisk = function(b, theme, s)
	shard(b, 6 * s, 2.4 * s, CFrame.new(0, 0, 0), theme.Crystal)
	for i = 0, 3 do
		local angle = i * math.pi / 2 + math.pi / 4
		shard(
			b,
			2.2 * s,
			1 * s,
			CFrame.new(math.cos(angle) * 1.6 * s, -2 * s, math.sin(angle) * 1.6 * s)
				* CFrame.Angles(math.sin(angle) * 0.4, 0, -math.cos(angle) * 0.4),
			theme.Crystal
		)
	end
end

crystalStyles.Prism = function(b, theme, s)
	for i = 0, 2 do
		local angle = i * math.pi * 2 / 3
		shard(
			b,
			6.5 * s,
			1.5 * s,
			CFrame.new(math.cos(angle) * 0.9 * s, 0, math.sin(angle) * 0.9 * s) * CFrame.Angles(0, angle, math.rad(6)),
			theme.Crystal
		)
	end
	local ring =
		cylinder(b, 0.4 * s, 5 * s, Vector3.new(0, -1.5 * s, 0), Color3.fromRGB(70, 72, 80), Enum.Material.Metal)
	noCollide(ring)
end

crystalStyles.Gem = function(b, theme, s)
	local gem = part(
		b,
		Vector3.one * 4 * s,
		CFrame.Angles(math.rad(45), 0, math.rad(35.26)),
		theme.Crystal,
		Enum.Material.Glass
	)
	gem.Transparency = 0.1
	gem.Reflectance = 0.2
	noCollide(gem)
	for i = 0, 3 do
		local angle = i * math.pi / 2
		local small = part(
			b,
			Vector3.one * 1.1 * s,
			CFrame.new(math.cos(angle) * 3.4 * s, -1 * s, math.sin(angle) * 3.4 * s)
				* CFrame.Angles(math.rad(45), angle, math.rad(35)),
			Color3.fromRGB(255, 255, 255),
			Enum.Material.Glass
		)
		small.Transparency = 0.2
		noCollide(small)
	end
end

crystalStyles.Shards = function(b, theme, s)
	shard(b, 5.5 * s, 1.8 * s, CFrame.new(0, 0, 0), theme.Crystal, Enum.Material.Ice)
	for i = 0, 5 do
		local angle = i * math.pi / 3
		shard(
			b,
			(2.5 + (i % 2)) * s,
			1.1 * s,
			CFrame.new(math.cos(angle) * 1.4 * s, -1.2 * s, math.sin(angle) * 1.4 * s)
				* CFrame.Angles(math.sin(angle) * 0.6, 0, -math.cos(angle) * 0.6),
			theme.Crystal,
			Enum.Material.Ice
		)
	end
end

crystalStyles.Core = function(b, theme, s)
	local core = sphere(b, Vector3.one * 4 * s, CFrame.identity, theme.Crystal, Enum.Material.Neon)
	noCollide(core)
	for i = 0, 2 do
		local ring = part(
			b,
			Vector3.new(0.35 * s, 6.5 * s, 6.5 * s),
			CFrame.Angles(i * 1.05, i * 0.7, 0),
			Color3.fromRGB(40, 35, 35),
			Enum.Material.Basalt
		);
		(ring :: Part).Shape = Enum.PartType.Cylinder
		ring.Transparency = 0.1
		noCollide(ring)
	end
end

crystalStyles.Emerald = function(b, theme, s)
	shard(b, 7 * s, 2 * s, CFrame.new(0, 0.5 * s, 0) * CFrame.Angles(0, math.rad(45), 0), theme.Crystal)
	for i = 0, 3 do
		local angle = i * math.pi / 2
		local leaf = part(
			b,
			Vector3.new(0.3 * s, 2.5 * s, 1.6 * s),
			CFrame.new(math.cos(angle) * 1.6 * s, -2.6 * s, math.sin(angle) * 1.6 * s)
				* CFrame.Angles(0, -angle, math.rad(-35)),
			Color3.fromRGB(60, 140, 50),
			Enum.Material.Grass,
			"Leaf",
			"WedgePart"
		)
		noCollide(leaf)
	end
end

crystalStyles.Rings = function(b, theme, s)
	local core =
		part(b, Vector3.one * 3 * s, CFrame.Angles(math.rad(45), 0, math.rad(35.26)), theme.Crystal, Enum.Material.Neon)
	noCollide(core)
	for i = 0, 1 do
		local ring = cylinder(
			b,
			0.3 * s,
			(5.5 + i * 2) * s,
			Vector3.zero,
			if i == 0 then Color3.fromRGB(60, 230, 255) else theme.Crystal,
			Enum.Material.Neon
		)
		ring.CFrame = b.root
			* CFrame.Angles(math.rad(70 - i * 40), math.rad(i * 60), 0)
			* CFrame.Angles(0, 0, math.rad(90))
		ring.Transparency = 0.35
		noCollide(ring)
	end
end

crystalStyles.Lollipop = function(b, theme, s)
	local stick = cylinder(
		b,
		4 * s,
		0.5 * s,
		Vector3.new(0, -3 * s, 0),
		Color3.fromRGB(255, 255, 255),
		Enum.Material.SmoothPlastic
	)
	noCollide(stick)
	for i = 0, 4 do
		local disc = part(
			b,
			Vector3.new(0.6 * s, (5 - i * 0.9) * s, (5 - i * 0.9) * s),
			CFrame.new(0, 0.8 * s, -i * 0.05 * s) * CFrame.Angles(0, math.rad(90), 0),
			if i % 2 == 0 then theme.Crystal else Color3.fromRGB(255, 255, 255),
			Enum.Material.SmoothPlastic
		);
		(disc :: Part).Shape = Enum.PartType.Cylinder
		noCollide(disc)
	end
end

crystalStyles.Star = function(b, theme, s)
	local core = sphere(b, Vector3.one * 3.6 * s, CFrame.identity, theme.Crystal, Enum.Material.Neon)
	noCollide(core)
	for i = 0, 5 do
		local angle = i * math.pi / 3
		local spike = part(
			b,
			Vector3.new(0.9 * s, 2.6 * s, 0.9 * s),
			CFrame.Angles(0, 0, angle) * CFrame.new(0, 2.6 * s, 0),
			Color3.fromRGB(255, 255, 255),
			Enum.Material.Neon,
			"Spike"
		)
		noCollide(spike)
	end
	for i = 0, 2 do
		local angle = i * math.pi * 2 / 3
		local moon = sphere(
			b,
			Vector3.one * 0.9 * s,
			CFrame.new(math.cos(angle) * 4.2 * s, math.sin(angle * 2) * s, math.sin(angle) * 4.2 * s),
			Color3.fromRGB(120, 200, 255),
			Enum.Material.Neon
		)
		noCollide(moon)
	end
end

function BaseBuilder.BuildCrystal(
	theme: Themes.Theme,
	tier: number,
	rebirths: number,
	worldCf: CFrame,
	parent: Instance
): Model
	local model = Instance.new("Model")
	model.Name = "Crystal"
	local core = Instance.new("Part")
	core.Name = "Core"
	core.Size = Vector3.one
	core.Transparency = 1
	core.Anchored = true
	noCollide(core)
	core.CFrame = worldCf
	core.Parent = model
	model.PrimaryPart = core

	local scale = 1 + (tier - 1) * 0.07
	local b: Builder = { root = worldCf, parent = model }
	local style = crystalStyles[theme.CrystalStyle] or crystalStyles.Obelisk
	style(b, theme, scale)

	-- Everything except Core becomes unanchored and welded so clients can spin the whole crystal by moving Core.
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") and child ~= core then
			child.Anchored = false
			child.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = core
			weld.Part1 = child
			weld.Parent = child
		end
	end

	local beamOrigin = Instance.new("Attachment")
	beamOrigin.Name = "BeamOrigin"
	beamOrigin.Parent = core

	local light = Instance.new("PointLight")
	light.Color = theme.Glow
	light.Range = 22 + tier
	light.Brightness = 2
	light.Shadows = false
	light.Parent = core

	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(theme.Glow)
	sparkle.LightEmission = 1
	sparkle.Size =
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6 + rebirths * 0.05), NumberSequenceKeypoint.new(1, 0) })
	sparkle.Lifetime = NumberRange.new(1, 2)
	sparkle.Speed = NumberRange.new(1, 3)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Rate = 6 + tier
	sparkle.Parent = beamOrigin

	model:SetAttribute("Style", theme.CrystalStyle)
	model.Parent = parent
	return model
end

---------------------------------------------------------------------------------------------------------------
-- Decorations per theme
---------------------------------------------------------------------------------------------------------------

local function wallTopPoints(): { CFrame }
	-- Points along the top of every wall (outer perimeter), skipping the door opening.
	local points = {}
	local half = BaseBuilder.Size / 2 - 1
	local y = BaseBuilder.FloorTop + BaseBuilder.WallHeight
	for x = -half + 3, half - 3, 6 do
		table.insert(points, CFrame.new(x, y, half))
		if math.abs(x) > BaseBuilder.DoorWidth / 2 + 2 then
			table.insert(points, CFrame.new(x, y, -half))
		end
	end
	for z = -half + 3, half - 3, 6 do
		table.insert(points, CFrame.new(half, y, z) * CFrame.Angles(0, math.rad(90), 0))
		table.insert(points, CFrame.new(-half, y, z) * CFrame.Angles(0, math.rad(90), 0))
	end
	return points
end

local function decorate(b: Builder, theme: Themes.Theme)
	local decor = theme.Decor
	local points = wallTopPoints()
	if decor == "Crenels" then
		for _, cf in points do
			part(b, Vector3.new(2.5, 1.6, 2.2), cf * CFrame.new(0, 0.8, 0), theme.Trim, theme.TrimMaterial)
		end
	elseif decor == "Fence" then
		for _, cf in points do
			part(b, Vector3.new(0.6, 2.2, 0.6), cf * CFrame.new(0, 1.1, 0), theme.Trim, theme.TrimMaterial)
		end
	elseif decor == "Spikes" then
		for _, cf in points do
			local spike = part(
				b,
				Vector3.new(1.4, 2.4, 1.4),
				cf * CFrame.new(0, 1.2, 0) * CFrame.Angles(0, math.rad(45), 0),
				theme.Trim,
				theme.TrimMaterial,
				"Spike",
				"WedgePart"
			)
			noCollide(spike)
		end
	elseif decor == "Domes" then
		for i, cf in points do
			if i % 2 == 0 then
				sphere(b, Vector3.new(2.6, 2.6, 2.6), cf * CFrame.new(0, 0.6, 0), theme.Trim, theme.TrimMaterial)
			end
		end
	elseif decor == "Icicles" then
		for _, cf in points do
			local icicle = part(
				b,
				Vector3.new(0.8, 2.2, 0.8),
				cf * CFrame.new(0, -BaseBuilder.WallHeight * 0.2, -1.4) * CFrame.Angles(math.rad(180), 0, 0),
				theme.Trim,
				Enum.Material.Ice,
				"Icicle",
				"WedgePart"
			)
			noCollide(icicle)
			part(
				b,
				Vector3.new(2.6, 0.8, 2.6),
				cf * CFrame.new(0, 0.4, 0),
				Color3.fromRGB(250, 252, 255),
				Enum.Material.Snow
			)
		end
	elseif decor == "Vines" then
		for i, cf in points do
			if i % 2 == 1 then
				local vine = part(
					b,
					Vector3.new(0.5, BaseBuilder.WallHeight * 0.7, 0.5),
					cf * CFrame.new(0, -BaseBuilder.WallHeight * 0.35, -1.1),
					theme.Trim,
					Enum.Material.Grass
				)
				noCollide(vine)
				sphere(b, Vector3.new(2, 1.2, 2), cf * CFrame.new(0, 0.4, 0), theme.Trim, Enum.Material.Grass)
			end
		end
	elseif decor == "NeonStrips" then
		local half = BaseBuilder.Size / 2 - 1
		local y = BaseBuilder.FloorTop + BaseBuilder.WallHeight * 0.55
		for _, z in { half + 1.05 } do
			part(b, Vector3.new(BaseBuilder.Size, 0.4, 0.1), CFrame.new(0, y, z), theme.Trim, Enum.Material.Neon)
		end
		for _, x in { half + 1.05, -half - 1.05 } do
			part(
				b,
				Vector3.new(0.1, 0.4, BaseBuilder.Size),
				CFrame.new(x, y, 0),
				Color3.fromRGB(60, 230, 255),
				Enum.Material.Neon
			)
		end
		for _, cf in points do
			part(b, Vector3.new(1.6, 0.4, 2.2), cf * CFrame.new(0, 0.2, 0), theme.Trim, Enum.Material.Neon)
		end
	elseif decor == "Candy" then
		for i, cf in points do
			local color = if i % 2 == 0 then Color3.fromRGB(255, 90, 140) else Color3.fromRGB(255, 255, 255)
			sphere(b, Vector3.new(2.2, 2.2, 2.2), cf * CFrame.new(0, 1.1, 0), color, Enum.Material.SmoothPlastic)
		end
	elseif decor == "Stars" then
		for i, cf in points do
			if i % 2 == 0 then
				local star = sphere(
					b,
					Vector3.one * 1.2,
					cf * CFrame.new(0, 2.2, 0),
					Color3.fromRGB(255, 255, 220),
					Enum.Material.Neon
				)
				noCollide(star)
			end
			part(b, Vector3.new(2.2, 0.6, 2.2), cf * CFrame.new(0, 0.3, 0), theme.Trim, Enum.Material.Neon)
		end
	end
end

local function towers(b: Builder, theme: Themes.Theme)
	local half = BaseBuilder.Size / 2 - 1
	local height = BaseBuilder.WallHeight + 5
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local pos = Vector3.new(sx * half, BaseBuilder.FloorTop + height / 2, sz * half)
			cylinder(b, height, 7, pos, theme.Wall, theme.WallMaterial, "Tower")
			local capY = BaseBuilder.FloorTop + height
			if theme.Decor == "Domes" or theme.Decor == "Candy" or theme.Decor == "Stars" then
				sphere(
					b,
					Vector3.new(7.4, 6, 7.4),
					CFrame.new(pos.X, capY + 0.5, pos.Z),
					theme.Trim,
					theme.TrimMaterial
				)
			else
				for i = 0, 3 do
					local d = 8 - i * 2
					cylinder(b, 1.2, d, Vector3.new(pos.X, capY + 0.6 + i * 1.1, pos.Z), theme.Trim, theme.TrimMaterial)
				end
			end
		end
	end
end

---------------------------------------------------------------------------------------------------------------
-- Base
---------------------------------------------------------------------------------------------------------------

export type BaseParts = {
	Model: Model,
	Door: Model,
	Crystal: Model,
	Sign: BasePart,
	Spawn: BasePart,
	Pedestals: { [number]: { Stand: BasePart, Pad: BasePart, Locked: boolean } },
	Kiosk: BasePart,
}

function BaseBuilder.SlotLocalCFrame(slot: number): CFrame
	local pos = SLOT_POSITIONS[slot]
	-- Brainrots face the central aisle.
	local facing = if pos.X < 0 then math.rad(-90) else math.rad(90)
	return CFrame.new(pos.X, BaseBuilder.FloorTop + 1.2, pos.Z) * CFrame.Angles(0, facing, 0)
end

function BaseBuilder.PadLocalPosition(slot: number): Vector3
	local pos = SLOT_POSITIONS[slot]
	local towardAisle = if pos.X < 0 then 1 else -1
	return Vector3.new(pos.X + towardAisle * 4.2, BaseBuilder.FloorTop + 0.13, pos.Z)
end

function BaseBuilder.Build(
	plotCf: CFrame,
	tier: number,
	rebirths: number,
	ownerName: string,
	parent: Instance
): BaseParts
	local theme = Themes.Get(tier)
	local model = Instance.new("Model")
	model.Name = "Base"
	local b: Builder = { root = plotCf, parent = model }
	local size = BaseBuilder.Size
	local half = size / 2
	local wallH = BaseBuilder.WallHeight
	local floorTop = BaseBuilder.FloorTop

	-- Floor and trim
	part(b, Vector3.new(size, 1, size), CFrame.new(0, 0.5, 0), theme.Floor, theme.FloorMaterial, "Floor")
	part(b, Vector3.new(size + 1, 0.6, 1), CFrame.new(0, 1.05, -half), theme.Trim, theme.TrimMaterial)
	-- Central aisle
	part(b, Vector3.new(10, 0.1, size - 6), CFrame.new(0, floorTop + 0.05, 0), theme.Trim, theme.TrimMaterial, "Aisle")

	-- Walls
	local wallY = floorTop + wallH / 2
	part(b, Vector3.new(size, wallH, 2), CFrame.new(0, wallY, half - 1), theme.Wall, theme.WallMaterial, "Wall")
	part(b, Vector3.new(2, wallH, size), CFrame.new(half - 1, wallY, 0), theme.Wall, theme.WallMaterial, "Wall")
	part(b, Vector3.new(2, wallH, size), CFrame.new(-half + 1, wallY, 0), theme.Wall, theme.WallMaterial, "Wall")
	local segment = (size - BaseBuilder.DoorWidth) / 2
	for _, side in { -1, 1 } do
		part(
			b,
			Vector3.new(segment, wallH, 2),
			CFrame.new(side * (BaseBuilder.DoorWidth / 2 + segment / 2), wallY, -half + 1),
			theme.Wall,
			theme.WallMaterial,
			"Wall"
		)
	end
	-- Wall caps
	for _, cf in { CFrame.new(0, floorTop + wallH + 0.3, half - 1), CFrame.new(0, floorTop + wallH + 0.3, -half + 1) } do
		part(b, Vector3.new(size + 0.6, 0.6, 2.6), cf, theme.Trim, theme.TrimMaterial)
	end
	for _, x in { half - 1, -half + 1 } do
		part(
			b,
			Vector3.new(2.6, 0.6, size + 0.6),
			CFrame.new(x, floorTop + wallH + 0.3, 0),
			theme.Trim,
			theme.TrimMaterial
		)
	end
	towers(b, theme)
	decorate(b, theme)

	-- Invisible tall barrier so nobody jumps over walls (doors are the only way in)
	local barrierH = 40
	local barrierY = floorTop + wallH + barrierH / 2
	local barrierSizes = {
		Vector3.new(size, barrierH, 1),
		Vector3.new(1, barrierH, size),
		Vector3.new(1, barrierH, size),
		Vector3.new(size, barrierH, 1),
	}
	local barrierFrames = {
		CFrame.new(0, barrierY, half - 1),
		CFrame.new(half - 1, barrierY, 0),
		CFrame.new(-half + 1, barrierY, 0),
		CFrame.new(0, barrierY, -half + 1),
	}
	for i, barrierSize in barrierSizes do
		local barrier =
			part(b, barrierSize, barrierFrames[i], Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, "Barrier")
		barrier.Transparency = 1
		barrier.CanQuery = false
		barrier.CanTouch = false
	end

	-- Door frame + door
	for _, side in { -1, 1 } do
		part(
			b,
			Vector3.new(1.2, wallH + 1.5, 2.8),
			CFrame.new(side * (BaseBuilder.DoorWidth / 2 + 0.3), floorTop + (wallH + 1.5) / 2, -half + 1),
			theme.Trim,
			theme.TrimMaterial,
			"DoorFrame"
		)
	end
	part(
		b,
		Vector3.new(BaseBuilder.DoorWidth + 2.6, 1.6, 2.8),
		CFrame.new(0, floorTop + wallH + 0.8, -half + 1),
		theme.Trim,
		theme.TrimMaterial,
		"DoorFrame"
	)

	local door = Instance.new("Model")
	door.Name = "Door"
	local doorB: Builder = { root = plotCf, parent = door }
	local panel = part(
		doorB,
		Vector3.new(BaseBuilder.DoorWidth, wallH, 1.2),
		CFrame.new(0, floorTop + wallH / 2, -half + 1),
		theme.Door,
		theme.DoorMaterial,
		"Panel"
	)
	for i = 0, 2 do
		local plank = part(
			doorB,
			Vector3.new(BaseBuilder.DoorWidth - 0.6, 0.8, 0.3),
			CFrame.new(0, floorTop + 2 + i * 4, -half + 0.3),
			theme.Trim,
			theme.TrimMaterial,
			"Brace"
		)
		plank.CanCollide = false
	end
	local knob = part(
		doorB,
		Vector3.new(0.8, 0.8, 0.5),
		CFrame.new(3.8, floorTop + wallH * 0.45, -half + 0.2),
		Color3.fromRGB(255, 210, 80),
		Enum.Material.Foil,
		"Knob"
	)
	knob.CanCollide = false
	door.PrimaryPart = panel
	door.Parent = model
	for _, child in door:GetDescendants() do
		if child:IsA("BasePart") then
			child:SetAttribute("BaseTransparency", child.Transparency)
		end
	end

	-- Owner sign above the door
	local sign = part(
		b,
		Vector3.new(22, 4, 0.6),
		CFrame.new(0, floorTop + wallH + 3.6, -half - 0.2),
		theme.Trim,
		theme.TrimMaterial,
		"Sign"
	)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(660, 120)
	gui.LightInfluence = 0
	gui.Parent = sign
	local title = Instance.new("TextLabel")
	title.Name = "Owner"
	title.Size = UDim2.new(1, 0, 0.62, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextStrokeTransparency = 0
	title.Text = string.upper(ownerName) .. "'S BASE"
	title.Parent = gui
	local subtitle = Instance.new("TextLabel")
	subtitle.Name = "Tier"
	subtitle.Position = UDim2.new(0, 0, 0.62, 0)
	subtitle.Size = UDim2.new(1, 0, 0.38, 0)
	subtitle.BackgroundTransparency = 1
	subtitle.Font = Enum.Font.FredokaOne
	subtitle.TextScaled = true
	subtitle.TextColor3 = theme.Glow
	subtitle.TextStrokeTransparency = 0
	subtitle.Text = string.format("Tier %d · %s", tier, theme.Name)
	subtitle.Parent = gui

	-- Pillar + crystal
	cylinder(b, 1, 9, Vector3.new(0, floorTop + 0.5, 0), theme.Trim, theme.TrimMaterial, "PillarBase")
	cylinder(b, 1, 7, Vector3.new(0, floorTop + 1.5, 0), theme.Pillar, theme.PillarMaterial, "PillarBase")
	local pillarHeight = BaseBuilder.CrystalHeight - 5 - floorTop - 2
	cylinder(
		b,
		pillarHeight,
		4,
		Vector3.new(0, floorTop + 2 + pillarHeight / 2, 0),
		theme.Pillar,
		theme.PillarMaterial,
		"Pillar"
	)
	cylinder(
		b,
		1,
		6.5,
		Vector3.new(0, floorTop + 2 + pillarHeight + 0.5, 0),
		theme.Trim,
		theme.TrimMaterial,
		"PillarTop"
	)
	local crystal =
		BaseBuilder.BuildCrystal(theme, tier, rebirths, plotCf * CFrame.new(0, BaseBuilder.CrystalHeight, 0), model)

	-- Pedestals
	local pedestals = {}
	local pedestalFolder = folder("Pedestals", model)
	local unlocked = Economy.Slots(tier)
	for slot = 1, BaseBuilder.MaxSlots do
		local pos = SLOT_POSITIONS[slot]
		local locked = slot > unlocked
		local slotB: Builder = { root = plotCf, parent = pedestalFolder }
		local stand = cylinder(
			slotB,
			1.2,
			5,
			Vector3.new(pos.X, floorTop + 0.6, pos.Z),
			if locked then Color3.fromRGB(90, 90, 95) else theme.Trim,
			if locked then Enum.Material.Slate else theme.TrimMaterial,
			"Stand" .. slot
		)
		stand:SetAttribute("Slot", slot)
		if locked then
			stand.Transparency = 0.5
			local lockGui = Instance.new("BillboardGui")
			lockGui.Name = "Lock"
			lockGui.Size = UDim2.fromOffset(110, 40)
			lockGui.StudsOffset = Vector3.new(0, 2.2, 0)
			lockGui.MaxDistance = 60
			lockGui.Parent = stand
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextColor3 = Color3.fromRGB(230, 230, 230)
			label.TextStrokeTransparency = 0.2
			local needed = tier
			while needed < Economy.MaxTier and Economy.Slots(needed) < slot do
				needed += 1
			end
			label.Text = "🔒 Tier " .. needed
			label.Parent = lockGui
		end
		local padPos = BaseBuilder.PadLocalPosition(slot)
		local pad =
			part(slotB, Vector3.new(2.6, 0.25, 3.4), CFrame.new(padPos), theme.Glow, Enum.Material.Neon, "Pad" .. slot)
		pad.CanCollide = false
		pad:SetAttribute("Slot", slot)
		pad.Transparency = if locked then 1 else 0.25
		pedestals[slot] = { Stand = stand, Pad = pad, Locked = locked }
	end

	-- Upgrade kiosk in the aisle, facing the door
	local kiosk = part(
		b,
		Vector3.new(5, 3.2, 1.2),
		CFrame.new(0, floorTop + 1.6, -13) * CFrame.Angles(math.rad(-15), 0, 0),
		theme.Trim,
		theme.TrimMaterial,
		"Kiosk"
	)
	local kioskGui = Instance.new("SurfaceGui")
	kioskGui.Face = Enum.NormalId.Front
	kioskGui.CanvasSize = Vector2.new(250, 160)
	kioskGui.LightInfluence = 0
	kioskGui.Parent = kiosk
	local kioskLabel = Instance.new("TextLabel")
	kioskLabel.Size = UDim2.fromScale(1, 1)
	kioskLabel.BackgroundTransparency = 1
	kioskLabel.Font = Enum.Font.FredokaOne
	kioskLabel.TextScaled = true
	kioskLabel.TextColor3 = Color3.new(1, 1, 1)
	kioskLabel.TextStrokeTransparency = 0
	kioskLabel.Text = "⬆️ UPGRADE"
	kioskLabel.Parent = kioskGui

	-- Spawn point just inside the door
	local spawn = part(
		b,
		Vector3.new(4, 1, 4),
		CFrame.new(0, floorTop + 0.5, -half + 8),
		Color3.new(1, 1, 1),
		Enum.Material.SmoothPlastic,
		"SpawnPoint"
	)
	spawn.Transparency = 1
	noCollide(spawn)

	model:SetAttribute("Tier", tier)
	model:SetAttribute("Theme", theme.Name)
	model.Parent = parent

	return {
		Model = model,
		Door = door,
		Crystal = crystal,
		Sign = sign,
		Spawn = spawn,
		Pedestals = pedestals,
		Kiosk = kiosk,
	}
end

-- Empty plot placeholder (shown when nobody owns the plot).
function BaseBuilder.BuildEmpty(plotCf: CFrame, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = "EmptyPlot"
	local b: Builder = { root = plotCf, parent = model }
	local p = part(
		b,
		Vector3.new(BaseBuilder.Size, 0.6, BaseBuilder.Size),
		CFrame.new(0, 0.3, 0),
		Color3.fromRGB(120, 170, 90),
		Enum.Material.Grass,
		"Floor"
	)
	p.Transparency = 0
	local sign = part(
		b,
		Vector3.new(14, 3, 0.5),
		CFrame.new(0, 3, -BaseBuilder.Size / 2 + 4),
		Color3.fromRGB(140, 100, 60),
		Enum.Material.Wood,
		"Sign"
	)
	local gui = Instance.new("SurfaceGui")
	gui.CanvasSize = Vector2.new(420, 90)
	gui.LightInfluence = 0
	gui.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Text = "Waiting for a player..."
	label.Parent = gui
	part(
		b,
		Vector3.new(0.6, 3, 0.6),
		CFrame.new(0, 1.2, -BaseBuilder.Size / 2 + 4.3),
		Color3.fromRGB(110, 75, 45),
		Enum.Material.Wood
	)
	model.Parent = parent
	return model
end

return BaseBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">PlayerStats</string>
            <string name="Source"><![CDATA[--!strict
-- Derived player stats: every multiplier from rebirths, gamepasses, index and events in one place.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local DataSchema = require(Shared.Modules.DataSchema)
local ServerState = require(script.Parent.ServerState)

type Passes = { [string]: boolean }

local PlayerStats = {}

local function indexCount(data: DataSchema.PlayerData): number
	-- Only base (non-mutated) entries count toward the index cash bonus.
	local count = 0
	for key in data.Index do
		if string.sub(key, -5) == "|None" then
			count += 1
		end
	end
	return count
end
PlayerStats.IndexCount = indexCount

function PlayerStats.CashMultiplier(data: DataSchema.PlayerData, passes: Passes): number
	local mult = 1 + data.Rebirths * Economy.RebirthCashBonus
	mult *= 1 + indexCount(data) * Economy.IndexBonusPerEntry
	if passes.DoubleCash then
		mult *= 2
	end
	if passes.VIP then
		mult *= 1.25
	end
	mult *= ServerState.CashEventMult
	return mult
end

function PlayerStats.PowerMultiplier(data: DataSchema.PlayerData): number
	return 1 + data.Rebirths * Economy.RebirthPowerBonus
end

function PlayerStats.CrystalPower(data: DataSchema.PlayerData, passes: Passes): number
	local mult = PlayerStats.PowerMultiplier(data)
	if passes.SuperCrystal then
		mult *= 1.25
	end
	return Economy.CrystalPower(data.CrystalLevel, mult)
end

function PlayerStats.DoorStrength(data: DataSchema.PlayerData, passes: Passes): number
	local mult = PlayerStats.PowerMultiplier(data)
	if passes.Fortress then
		mult *= 1.5
	end
	return Economy.DoorStrength(data.DoorLevel, mult)
end

function PlayerStats.Luck(passes: Passes): number
	local luck = 1
	if passes.VIP then
		luck *= 1.1
	end
	if os.time() < ServerState.ServerLuckUntil then
		luck *= 2
	end
	luck *= ServerState.LuckEventMult
	return luck
end

function PlayerStats.MutationMultipliers(passes: Passes): { [string]: number }
	local mult: { [string]: number } = table.clone(ServerState.MutationMult)
	if os.time() < ServerState.ServerLuckUntil then
		for _, name in { "Gold", "Diamond", "Rainbow", "Galaxy" } do
			mult[name] = (mult[name] or 1) * 1.5
		end
	end
	if passes.VIP then
		mult.Gold = (mult.Gold or 1) * 1.1
	end
	return mult
end

return PlayerStats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">SaveStore</string>
            <string name="Source"><![CDATA[--!strict
-- Session-locked DataStore wrapper. Guarantees one server owns a player's save at a time so progress can't be
-- overwritten by a stale server, retries every call with exponential backoff, and falls back to an in-memory
-- backend in Studio when API access is disabled. Core logic is backend-agnostic and unit-tested
-- (tests/savestore.spec.luau) with a fake backend and multiple simulated servers.
--
-- Record layout stored under "Player_<userId>":
--   { Data = <PlayerData>, Lock = { JobId, Session, Time }?, SavedAt = <unix> }

export type LoadStatus = "ok" | "locked" | "error"

export type Store = {
	Load: (self: Store, userId: number) -> (any?, LoadStatus),
	Save: (self: Store, userId: number, data: any, release: boolean) -> (boolean, boolean),
	IsMemory: (self: Store) -> boolean,
}

export type Backend = {
	-- Atomically transforms the value at key. transform returns the new value, or nil to cancel the write.
	-- Returns (success, resulting value).
	Update: (key: string, transform: (any) -> any?) -> (boolean, any),
}

export type Options = {
	JobId: string,
	Guid: () -> string,
	Now: () -> number,
	Wait: (seconds: number) -> (),
	IsMemory: boolean,
}

local SaveStore = {}

SaveStore.LockStaleSeconds = 600 -- a lock not refreshed for this long belongs to a dead server
SaveStore.LoadAttempts = 7
SaveStore.LockedRetryDelay = 5
SaveStore.SaveAttempts = 4

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- In-memory backend (Studio without API access, and tests).
function SaveStore.MemoryBackend(): Backend
	local storage: { [string]: any } = {}
	return {
		Update = function(key: string, transform: (any) -> any?): (boolean, any)
			local result = transform(deepCopy(storage[key]))
			if result ~= nil then
				storage[key] = deepCopy(result)
			end
			return true, if result ~= nil then result else storage[key]
		end,
	}
end

function SaveStore.fromBackend(backend: Backend, options: Options): Store
	local sessions: { [number]: string } = {}
	local self = {} :: Store

	function self.IsMemory(_: Store): boolean
		return options.IsMemory
	end

	function self.Load(_: Store, userId: number): (any?, LoadStatus)
		local key = "Player_" .. userId
		local session = options.Guid()
		for attempt = 1, SaveStore.LoadAttempts do
			local lockedOut = false
			local loadedData: any = nil
			local ok, _ = backend.Update(key, function(old: any): any?
				local record = if type(old) == "table" then old else {}
				local lock = record.Lock
				if type(lock) == "table" and lock.Session ~= session then
					local age = options.Now() - (tonumber(lock.Time) or 0)
					local sameServer = lock.JobId == options.JobId and options.JobId ~= ""
					if age < SaveStore.LockStaleSeconds and not sameServer then
						lockedOut = true
						return nil
					end
				end
				record.Lock = { JobId = options.JobId, Session = session, Time = options.Now() }
				loadedData = record.Data
				return record
			end)
			if ok and not lockedOut then
				sessions[userId] = session
				return loadedData, "ok"
			end
			if attempt < SaveStore.LoadAttempts then
				if lockedOut then
					options.Wait(SaveStore.LockedRetryDelay)
				else
					options.Wait(math.min(2 ^ attempt, 16))
				end
			end
		end
		return nil, "locked"
	end

	-- Returns (success, lockLost). lockLost means another server owns this save now; stop saving this player.
	function self.Save(_: Store, userId: number, data: any, release: boolean): (boolean, boolean)
		local key = "Player_" .. userId
		local session = sessions[userId]
		if session == nil then
			return false, true
		end
		for attempt = 1, SaveStore.SaveAttempts do
			local lockLost = false
			local ok, _ = backend.Update(key, function(old: any): any?
				local record = if type(old) == "table" then old else {}
				local lock = record.Lock
				if type(lock) == "table" and lock.Session ~= session then
					lockLost = true
					return nil
				end
				record.Data = data
				record.SavedAt = options.Now()
				if release then
					record.Lock = nil
				else
					record.Lock = { JobId = options.JobId, Session = session, Time = options.Now() }
				end
				return record
			end)
			if lockLost then
				sessions[userId] = nil
				return false, true
			end
			if ok then
				if release then
					sessions[userId] = nil
				end
				return true, false
			end
			if attempt < SaveStore.SaveAttempts then
				options.Wait(math.min(2 ^ attempt, 8))
			end
		end
		return false, false
	end

	return self
end

-- Production constructor: real DataStore when available, memory backend in Studio without API access.
function SaveStore.new(name: string): Store
	local DataStoreService = game:GetService("DataStoreService")
	local HttpService = game:GetService("HttpService")
	local RunService = game:GetService("RunService")

	local function waitForBudget()
		local waited = 0
		while
			DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync) < 1
			and waited < 10
		do
			task.wait(0.5)
			waited += 0.5
		end
	end

	local function dataStoreBackend(store: GlobalDataStore): Backend
		return {
			Update = function(key: string, transform: (any) -> any?): (boolean, any)
				waitForBudget()
				local ok, result = pcall(function()
					return store:UpdateAsync(key, function(old)
						return transform(old)
					end)
				end)
				return ok, result
			end,
		}
	end

	local backend: Backend? = nil
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(name)
	end)
	if ok and store then
		local probeOk, probeErr = pcall(function()
			return store:GetAsync("__probe")
		end)
		if probeOk then
			backend = dataStoreBackend(store)
		else
			local message = tostring(probeErr)
			local isAccess = string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
				or string.find(message, "403", 1, true) ~= nil
				or string.find(message, "publish", 1, true) ~= nil
			if not isAccess and not RunService:IsStudio() then
				-- Live server with a transient error: still use the real store; every call retries.
				backend = dataStoreBackend(store)
			end
		end
	end
	local isMemory = backend == nil
	if isMemory then
		warn("[SaveStore] DataStores unavailable (Studio without API access?). Using in-memory saves for this session.")
	end
	return SaveStore.fromBackend(backend or SaveStore.MemoryBackend(), {
		JobId = game.JobId,
		Guid = function()
			return HttpService:GenerateGUID(false)
		end,
		Now = os.time,
		Wait = function(seconds: number)
			task.wait(seconds)
		end,
		IsMemory = isMemory,
	})
end

return SaveStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">ServerState</string>
            <string name="Source"><![CDATA[--!strict
-- Shared mutable server-wide state (events, timers). Written by EventService/WaveService, read everywhere.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Modules.Net)

local ServerState = {
	WaveNumber = 0,
	NextWaveAt = 0, -- workspace:GetServerTimeNow() timestamp
	CashEventMult = 1, -- e.g. weekend 2x cash
	LuckEventMult = 1,
	MutationMult = {} :: { [string]: number },
	ServerLuckUntil = 0, -- purchased Server Luck (os.time)
	ServerLuckBy = "",
	ActiveEvent = "", -- "" | "GoldenHour" | "Stampede" | ...
	EventEndsAt = 0, -- server time
	NextEventName = "",
	NextEventAt = 0, -- server time
	StampedeNextWave = false,
	WeekendBoost = false,
}

function ServerState.Snapshot(): { [string]: any }
	return {
		WaveNumber = ServerState.WaveNumber,
		NextWaveAt = ServerState.NextWaveAt,
		ActiveEvent = ServerState.ActiveEvent,
		EventEndsAt = ServerState.EventEndsAt,
		NextEventName = ServerState.NextEventName,
		NextEventAt = ServerState.NextEventAt,
		ServerLuckUntil = ServerState.ServerLuckUntil,
		ServerLuckBy = ServerState.ServerLuckBy,
		StampedeNextWave = ServerState.StampedeNextWave,
		WeekendBoost = ServerState.WeekendBoost,
	}
end

function ServerState.Broadcast()
	Net.Event("ServerInfo"):FireAllClients(ServerState.Snapshot())
end

function ServerState.SendTo(player: Player)
	Net.Event("ServerInfo"):FireClient(player, ServerState.Snapshot())
end

return ServerState
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">BoostService</string>
            <string name="Source"><![CDATA[--!strict
-- Consumable boosts the player owns (from codes, daily rewards, gifts or purchases) and activates on demand.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Modules.Net)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)

local BoostService = {}

BoostService.IronDoorSeconds = 300

function BoostService.Grant(player: Player, name: string, amount: number)
	local data = DataService.Get(player)
	if not data then
		return
	end
	data.Boosts[name] = (data.Boosts[name] or 0) + amount
	DataService.MarkDirty(player)
end

-- Applies a boost effect immediately (used for activations and purchases).
function BoostService.Apply(player: Player, name: string): (boolean, string)
	local session = DataService.GetSession(player)
	if not session then
		return false, "Not ready"
	end
	if name == "Overcharge" then
		if session.Overcharge then
			return false, "Overcharge is already active!"
		end
		session.Overcharge = true
		return true, "⚡ OVERCHARGE armed: +50% crystal power on your next showdown!"
	elseif name == "IronDoor" then
		session.IronDoorUntil = math.max(session.IronDoorUntil, os.time()) + BoostService.IronDoorSeconds
		local plot = PlotService.ForPlayer(player)
		if plot and PlotService.IsDoorBroken(plot) then
			PlotService.RepairDoor(plot)
		end
		return true, "🛡️ IRON DOOR: your door can't break for 5 minutes!"
	elseif name == "LuckyWave" then
		if session.LuckyPending then
			return false, "A Lucky Wave is already on its way!"
		end
		session.LuckyPending = true
		return true, "🍀 LUCKY WAVE: your next brainrot is extra rare and guaranteed!"
	elseif name == "GoldenWave" then
		if session.GoldenPending then
			return false, "A Golden Wave is already on its way!"
		end
		session.GoldenPending = true
		return true, "✨ GOLDEN WAVE: your next brainrot will be GOLD!"
	elseif name == "InstantRepair" then
		local plot = PlotService.ForPlayer(player)
		if not plot or not PlotService.IsDoorBroken(plot) then
			return false, "Your door isn't broken"
		end
		PlotService.RepairDoor(plot)
		return true, "🔧 Door repaired!"
	end
	return false, "Unknown boost"
end

local function onUseBoost(player: Player, name: unknown): (boolean, string)
	if not DataService.Throttle(player, "UseBoost", 0.3) then
		return false, "Slow down!"
	end
	local data = DataService.Get(player)
	if not data or type(name) ~= "string" then
		return false, "Not ready"
	end
	local count = data.Boosts[name] or 0
	if count <= 0 then
		return false, "You don't have any"
	end
	local ok, message = BoostService.Apply(player, name)
	if ok then
		data.Boosts[name] = count - 1
		DataService.MarkDirty(player)
		PlotService.PublishStats(player)
	end
	return ok, message
end

function BoostService.Start()
	Net.Function("UseBoost").OnServerInvoke = onUseBoost
end

return BoostService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">BrainrotService</string>
            <string name="Source"><![CDATA[--!strict
-- Owned brainrots: adding/removing, auto-placement on pedestals, storage, selling, pedestal models,
-- per-second income and collection pads.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Brainrots = require(Shared.Config.Brainrots)
local Economy = require(Shared.Config.Economy)
local GameConfig = require(Shared.Config.GameConfig)
local Rarities = require(Shared.Config.Rarities)
local Sizes = require(Shared.Config.Sizes)
local BrainrotBuilder = require(Shared.Modules.BrainrotBuilder)
local BrainrotStats = require(Shared.Modules.BrainrotStats)
local DataSchema = require(Shared.Modules.DataSchema)
local Format = require(Shared.Modules.Format)
local Net = require(Shared.Modules.Net)
local Signal = require(Shared.Modules.Signal)
local BaseBuilder = require(script.Parent.Parent.Modules.BaseBuilder)
local PlayerStats = require(script.Parent.Parent.Modules.PlayerStats)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)

local BrainrotService = {}

BrainrotService.Added = Signal.new() :: Signal.Signal<Player, DataSchema.BrainrotRecord, string>
BrainrotService.Discovered = Signal.new() :: Signal.Signal<Player, string, string>

type Spawned = { Model: Model, Uid: string }

-- spawned[player][slot]
local spawned: { [Player]: { [number]: Spawned } } = {}
-- Slots whose brainrot is currently being carried by a thief: income paused, model hidden.
local carried: { [Player]: { [number]: boolean } } = {}

local function notify(player: Player, text: string, kind: string?)
	Net.Event("Notify"):FireClient(player, text, kind or "info")
end
BrainrotService.Notify = notify

function BrainrotService.Income(record: DataSchema.BrainrotRecord): number
	return BrainrotStats.Income(record.Id, record.Mutation, record.Size)
end

local function placedSlots(data: DataSchema.PlayerData): { [number]: string }
	local result = {}
	local unlocked = Economy.Slots(data.Tier)
	for key, uid in data.Slots do
		local slot = tonumber(key)
		if slot and slot <= unlocked and data.Brainrots[uid] then
			result[slot] = uid
		end
	end
	return result
end
BrainrotService.PlacedSlots = placedSlots

local function slotOf(data: DataSchema.PlayerData, uid: string): number?
	for key, slotUid in data.Slots do
		if slotUid == uid then
			return tonumber(key)
		end
	end
	return nil
end
BrainrotService.SlotOf = slotOf

local function storageCount(data: DataSchema.PlayerData): number
	local placed: { [string]: boolean } = {}
	for _, uid in data.Slots do
		placed[uid] = true
	end
	local count = 0
	for uid in data.Brainrots do
		if not placed[uid] then
			count += 1
		end
	end
	return count
end
BrainrotService.StorageCount = storageCount

local function rarityColor(id: string): Color3
	local def = Brainrots.Get(id)
	return if def then Rarities.Get(def.Rarity).Color else Color3.new(1, 1, 1)
end

local function makeLabel(parent: Instance, name: string, text: string, color: Color3, order: number, height: number)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.LayoutOrder = order
	label.Size = UDim2.new(1, 0, height, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.1
	label.Text = text
	label.Parent = parent
end

local function despawnSlot(player: Player, slot: number)
	local bySlot = spawned[player]
	local entry = bySlot and bySlot[slot]
	if bySlot and entry then
		entry.Model:Destroy()
		bySlot[slot] = nil
	end
end

local function spawnSlot(player: Player, slot: number)
	despawnSlot(player, slot)
	local data = DataService.Get(player)
	local plot = PlotService.ForPlayer(player)
	if not data or not plot or not plot.Parts then
		return
	end
	local uid = data.Slots[tostring(slot)]
	local record = uid and data.Brainrots[uid]
	if not record or not uid then
		return
	end
	local sizeIndex = 1
	for i, size in Sizes.List do
		if size.Name == record.Size then
			sizeIndex = i
		end
	end
	local fit = BrainrotBuilder.FitScale(record.Id, 5.2, 4.6) * (1 + (sizeIndex - 1) * 0.12)
	local model = BrainrotBuilder.Build(record.Id, { Mutation = record.Mutation, Scale = fit })
	model:PivotTo(plot.CFrame * BaseBuilder.SlotLocalCFrame(slot) * CFrame.new(0, 0.6, 0))
	model:SetAttribute("Uid", uid)
	model:SetAttribute("Slot", slot)
	model:SetAttribute("OwnerId", player.UserId)
	model:SetAttribute("PlotIndex", plot.Index)
	model:SetAttribute("Size", record.Size)
	model:SetAttribute("StealImmuneUntil", (record.StolenAt or 0) + GameConfig.StealImmunitySeconds)

	local root = model.PrimaryPart
	if root then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "Tag"
		billboard.Size = UDim2.fromOffset(190, 70)
		billboard.StudsOffsetWorldSpace = Vector3.new(0, (model:GetAttribute("Height") :: number) + 1.6, 0)
		billboard.MaxDistance = 75
		billboard.LightInfluence = 0
		billboard.Parent = root
		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.Parent = billboard
		local def = Brainrots.Get(record.Id)
		local tags = {}
		if record.Size ~= "Normal" then
			table.insert(tags, string.upper(record.Size))
		end
		if record.Mutation ~= "None" then
			table.insert(tags, string.upper(record.Mutation))
		end
		if #tags > 0 then
			makeLabel(billboard, "Tags", table.concat(tags, " · "), Color3.fromRGB(255, 235, 140), 1, 0.24)
		end
		makeLabel(billboard, "Name", if def then def.Name else record.Id, rarityColor(record.Id), 2, 0.38)
		makeLabel(
			billboard,
			"Income",
			Format.Cash(BrainrotService.Income(record)) .. "/s",
			Color3.fromRGB(120, 255, 120),
			3,
			0.3
		)
	end

	model.Parent = plot.Parts.Model
	local bySlot = spawned[player]
	if not bySlot then
		bySlot = {}
		spawned[player] = bySlot
	end
	bySlot[slot] = { Model = model, Uid = uid }
	if carried[player] and carried[player][slot] then
		BrainrotService.SetCarried(player, slot, true)
	end
end

function BrainrotService.SpawnAll(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local bySlot = spawned[player]
	if bySlot then
		for slot in bySlot do
			despawnSlot(player, slot)
		end
	end
	spawned[player] = {}
	-- Drop slot assignments that point at missing brainrots or pedestals locked by a lower tier (after rebirth).
	local unlocked = Economy.Slots(data.Tier)
	for key, uid in data.Slots do
		local slot = tonumber(key)
		if slot == nil or slot > unlocked or data.Brainrots[uid] == nil then
			data.Slots[key] = nil
		end
	end
	for slot in placedSlots(data) do
		spawnSlot(player, slot)
	end
end

function BrainrotService.ModelAt(player: Player, slot: number): Model?
	local bySlot = spawned[player]
	local entry = bySlot and bySlot[slot]
	return if entry then entry.Model else nil
end

function BrainrotService.SetCarried(player: Player, slot: number, isCarried: boolean)
	local map = carried[player]
	if not map then
		map = {}
		carried[player] = map
	end
	if isCarried then
		map[slot] = true
	else
		map[slot] = nil
	end
	local model = BrainrotService.ModelAt(player, slot)
	if model then
		for _, child in model:GetDescendants() do
			if child:IsA("BasePart") and child.Name ~= "Root" then
				if isCarried then
					child:SetAttribute("PrevTransparency", child.Transparency)
					child.Transparency = 1
				else
					local prev = child:GetAttribute("PrevTransparency")
					child.Transparency = if type(prev) == "number" then prev else 0
				end
			elseif child:IsA("BillboardGui") or child:IsA("ParticleEmitter") or child:IsA("PointLight") then
				(child :: any).Enabled = not isCarried
			end
		end
	end
end

-- Recomputes cached income/s and publishes it.
function BrainrotService.RefreshIncome(player: Player)
	local data = DataService.Get(player)
	local session = DataService.GetSession(player)
	if not data or not session then
		return
	end
	local total = 0
	for _, uid in placedSlots(data) do
		total += BrainrotService.Income(data.Brainrots[uid])
	end
	session.CashMultiplier = PlayerStats.CashMultiplier(data, session.Passes)
	session.IncomeCache = total * session.CashMultiplier
	player:SetAttribute("Income", session.IncomeCache)
	DataService.MarkDirty(player)
end

local function weakestPlaced(data: DataSchema.PlayerData): (number?, number)
	local weakestSlot, weakestIncome = nil, math.huge
	for slot, uid in placedSlots(data) do
		local income = BrainrotService.Income(data.Brainrots[uid])
		if income < weakestIncome then
			weakestSlot, weakestIncome = slot, income
		end
	end
	return weakestSlot, weakestIncome
end

local function firstFreeSlot(data: DataSchema.PlayerData): number?
	local unlocked = Economy.Slots(data.Tier)
	for slot = 1, unlocked do
		local uid = data.Slots[tostring(slot)]
		if uid == nil or data.Brainrots[uid] == nil then
			return slot
		end
	end
	return nil
end
BrainrotService.FirstFreeSlot = firstFreeSlot

local function placeInto(player: Player, data: DataSchema.PlayerData, uid: string, slot: number)
	data.Slots[tostring(slot)] = uid
	spawnSlot(player, slot)
end

-- Adds a brainrot. Auto-places it in a free slot, or swaps out the weakest placed brainrot if the new one earns
-- more. If there is no room anywhere it is sold instantly. Returns the new uid (or nil if sold) and the slot.
function BrainrotService.Add(
	player: Player,
	id: string,
	mutation: string,
	size: string,
	source: string,
	stolenAt: number?
): (string?, number?)
	local data = DataService.Get(player)
	if not data or Brainrots.Get(id) == nil then
		return nil, nil
	end
	local record: DataSchema.BrainrotRecord = {
		Uid = DataSchema.NewUid(data),
		Id = id,
		Mutation = mutation,
		Size = size,
		Obtained = os.time(),
		StolenAt = stolenAt,
	}
	local income = BrainrotService.Income(record)

	-- Index discovery
	local baseKey = BrainrotStats.IndexKey(id, "None")
	local mutationKey = BrainrotStats.IndexKey(id, mutation)
	local newBase = not data.Index[baseKey]
	if newBase then
		data.Index[baseKey] = true
		BrainrotService.Discovered:Fire(player, id, "None")
	end
	if mutation ~= "None" and not data.Index[mutationKey] then
		data.Index[mutationKey] = true
		BrainrotService.Discovered:Fire(player, id, mutation)
	end

	local slot = firstFreeSlot(data)
	if slot == nil then
		local weakSlot, weakIncome = weakestPlaced(data)
		if weakSlot and income > weakIncome and storageCount(data) < GameConfig.StorageMax then
			slot = weakSlot
		end
	end
	if slot == nil and storageCount(data) >= GameConfig.StorageMax then
		local value =
			Economy.SellValue(income * PlayerStats.CashMultiplier(data, (DataService.GetSession(player) :: any).Passes))
		DataService.AddCash(player, value)
		notify(
			player,
			string.format(
				"Storage full! Auto-sold %s for %s",
				BrainrotStats.DisplayName(id, mutation, size),
				Format.Cash(value)
			),
			"warn"
		)
		BrainrotService.RefreshIncome(player)
		return nil, nil
	end

	data.Brainrots[record.Uid] = record
	if slot then
		placeInto(player, data, record.Uid, slot)
	end
	if newBase then
		notify(
			player,
			string.format(
				"NEW! %s added to your Index (+%d%% cash)",
				Brainrots.ById[id].Name,
				math.floor(Economy.IndexBonusPerEntry * 100)
			),
			"new"
		)
	end
	BrainrotService.RefreshIncome(player)
	BrainrotService.Added:Fire(player, record, source)
	return record.Uid, slot
end

-- Removes a brainrot entirely (sold or stolen). Returns the removed record.
function BrainrotService.Remove(player: Player, uid: string): DataSchema.BrainrotRecord?
	local data = DataService.Get(player)
	local session = DataService.GetSession(player)
	if not data or not session then
		return nil
	end
	local record = data.Brainrots[uid]
	if not record then
		return nil
	end
	local slot = slotOf(data, uid)
	if slot then
		data.Slots[tostring(slot)] = nil
		session.Pending[slot] = nil
		despawnSlot(player, slot)
		local map = carried[player]
		if map then
			map[slot] = nil
		end
	end
	data.Brainrots[uid] = nil
	BrainrotService.RefreshIncome(player)
	return record
end

-- Arranges the highest-earning brainrots onto the unlocked pedestals.
function BrainrotService.PlaceBest(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local busy = carried[player]
	if busy and next(busy) ~= nil then
		notify(player, "Can't rearrange while a brainrot is being stolen!", "warn")
		return
	end
	local list: { DataSchema.BrainrotRecord } = {}
	for _, record in data.Brainrots do
		table.insert(list, record)
	end
	table.sort(list, function(a, b)
		return BrainrotService.Income(a) > BrainrotService.Income(b)
	end)
	data.Slots = {}
	local unlocked = Economy.Slots(data.Tier)
	for i = 1, math.min(unlocked, #list) do
		data.Slots[tostring(i)] = list[i].Uid
	end
	BrainrotService.SpawnAll(player)
	BrainrotService.RefreshIncome(player)
end

function BrainrotService.CollectSlot(player: Player, slot: number)
	local session = DataService.GetSession(player)
	if not session then
		return
	end
	local amount = session.Pending[slot]
	if amount and amount >= 1 then
		session.Pending[slot] = 0
		DataService.AddCash(player, amount)
		Net.Event("Effect"):FireClient(player, "Collect", { Slot = slot, Amount = amount })
	end
end

function BrainrotService.CollectAll(player: Player): number
	local session = DataService.GetSession(player)
	if not session then
		return 0
	end
	local total = 0
	for slot, amount in session.Pending do
		total += amount
		session.Pending[slot] = 0
	end
	if total > 0 then
		DataService.AddCash(player, total)
	end
	return total
end

local function onInventory(player: Player, action: unknown, uid: unknown): (boolean, string)
	if not DataService.Throttle(player, "Inventory", 0.15) then
		return false, "Slow down!"
	end
	if type(action) ~= "string" then
		return false, "Bad request"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "Not loaded"
	end
	if action == "PlaceBest" then
		BrainrotService.PlaceBest(player)
		return true, "Placed your best brainrots!"
	end
	if type(uid) ~= "string" or data.Brainrots[uid] == nil then
		return false, "Brainrot not found"
	end
	local record = data.Brainrots[uid]
	local slot = slotOf(data, uid)
	local busy = carried[player]
	if slot and busy and busy[slot] then
		return false, "That brainrot is being stolen!"
	end
	if action == "Place" then
		if slot then
			return false, "Already placed"
		end
		local free = firstFreeSlot(data)
		if not free then
			return false, "Your base is full! Store one first."
		end
		placeInto(player, data, uid, free)
		BrainrotService.RefreshIncome(player)
		return true, "Placed!"
	elseif action == "Store" then
		if not slot then
			return false, "Already in storage"
		end
		if storageCount(data) >= GameConfig.StorageMax then
			return false, "Storage is full"
		end
		BrainrotService.CollectSlot(player, slot)
		data.Slots[tostring(slot)] = nil
		despawnSlot(player, slot)
		BrainrotService.RefreshIncome(player)
		return true, "Moved to storage"
	elseif action == "Sell" then
		local session = DataService.GetSession(player)
		local mult = if session then session.CashMultiplier else 1
		local value = Economy.SellValue(BrainrotService.Income(record) * mult)
		if slot then
			BrainrotService.CollectSlot(player, slot)
		end
		BrainrotService.Remove(player, uid)
		DataService.AddCash(player, value)
		return true, "Sold for " .. Format.Cash(value)
	end
	return false, "Unknown action"
end

local function hookPads(player: Player, plot: PlotService.Plot)
	local parts = plot.Parts
	if not parts then
		return
	end
	for slot, pedestal in parts.Pedestals do
		if pedestal.Locked then
			continue
		end
		local pad = pedestal.Pad
		pad.CanTouch = true
		local label = Instance.new("BillboardGui")
		label.Name = "PendingTag"
		label.Size = UDim2.fromOffset(120, 34)
		label.StudsOffset = Vector3.new(0, 1.4, 0)
		label.MaxDistance = 45
		label.LightInfluence = 0
		label.Parent = pad
		local text = Instance.new("TextLabel")
		text.Name = "Amount"
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.FredokaOne
		text.TextScaled = true
		text.TextColor3 = Color3.fromRGB(130, 255, 130)
		text.TextStrokeTransparency = 0.1
		text.Text = ""
		text.Parent = label
		pad.Touched:Connect(function(hit)
			local character = player.Character
			if character and hit:IsDescendantOf(character) then
				if DataService.Throttle(player, "Pad" .. slot, 0.25) then
					BrainrotService.CollectSlot(player, slot)
				end
			end
		end)
	end
end

local function updatePadLabels(plot: PlotService.Plot, pending: { [number]: number })
	local parts = plot.Parts
	if not parts then
		return
	end
	for slot, pedestal in parts.Pedestals do
		local tag = pedestal.Pad:FindFirstChild("PendingTag")
		local label = tag and tag:FindFirstChild("Amount") :: TextLabel?
		if label then
			local amount = pending[slot] or 0
			local text = if amount >= 1 then Format.Cash(amount) else ""
			if label.Text ~= text then
				label.Text = text
			end
		end
	end
end

function BrainrotService.Start()
	Net.Function("Inventory").OnServerInvoke = onInventory

	PlotService.BaseBuilt:Connect(function(player, plot)
		hookPads(player, plot)
		BrainrotService.SpawnAll(player)
		BrainrotService.RefreshIncome(player)
	end)

	DataService.Releasing:Connect(function(player)
		-- Bank anything left on the pads so leaving never loses money.
		BrainrotService.CollectAll(player)
		spawned[player] = nil
		carried[player] = nil
	end)
	Players.PlayerRemoving:Connect(function(player)
		spawned[player] = nil
		carried[player] = nil
	end)

	-- Income tick
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in DataService.Players() do
				local data = DataService.Get(player)
				local session = DataService.GetSession(player)
				local plot = PlotService.ForPlayer(player)
				if not data or not session or not plot then
					continue
				end
				local mult = session.CashMultiplier
				local busy = carried[player] or {}
				local direct = 0
				for slot, uid in placedSlots(data) do
					if busy[slot] then
						continue
					end
					local amount = BrainrotService.Income(data.Brainrots[uid]) * mult
					if session.Passes.AutoCollect then
						direct += amount
					else
						session.Pending[slot] = (session.Pending[slot] or 0) + amount
					end
				end
				if direct > 0 then
					DataService.AddCash(player, direct)
				end
				updatePadLabels(plot, session.Pending)
			end
		end
	end)
end

return BrainrotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Owns every player's save data and per-session runtime state.
-- Loading: session-locked via SaveStore, migrated + reconciled via DataSchema.
-- Saving: autosave every GameConfig.AutosaveInterval, on leave (with lock release) and on shutdown.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DataSchema = require(Shared.Modules.DataSchema)
local GameConfig = require(Shared.Config.GameConfig)
local Signal = require(Shared.Modules.Signal)
local SaveStore = require(script.Parent.Parent.Modules.SaveStore)

export type Session = {
	Plot: number?,
	Charge: number,
	LastTap: number,
	Overcharge: boolean,
	IronDoorUntil: number,
	LuckyPending: boolean,
	GoldenPending: boolean,
	Pending: { [number]: number }, -- uncollected cash per pedestal slot
	Passes: { [string]: boolean },
	JoinTime: number,
	WaveCount: number,
	LastBonk: number,
	Throttles: { [string]: number },
	IncomeCache: number,
	CashMultiplier: number,
	PlaytimeAtJoin: number,
	Released: boolean,
	InGroup: boolean,
	ShieldNoticeShown: boolean,
	WelcomeSent: boolean,
}

type Profile = {
	Data: DataSchema.PlayerData,
	Session: Session,
	Dirty: boolean,
	LockLost: boolean,
}

local DataService = {}

DataService.Loaded = Signal.new() :: Signal.Signal<Player, DataSchema.PlayerData>
DataService.Releasing = Signal.new() :: Signal.Signal<Player, DataSchema.PlayerData>
DataService.Changed = Signal.new() :: Signal.Signal<Player>

local profiles: { [Player]: Profile } = {}
local releasing: { [number]: boolean } = {}
local store: SaveStore.Store

local function newSession(data: DataSchema.PlayerData): Session
	return {
		Plot = nil,
		Charge = 0,
		LastTap = 0,
		Overcharge = false,
		IronDoorUntil = 0,
		LuckyPending = false,
		GoldenPending = false,
		Pending = {},
		Passes = {},
		JoinTime = os.clock(),
		WaveCount = 0,
		LastBonk = 0,
		Throttles = {},
		IncomeCache = 0,
		CashMultiplier = 1,
		PlaytimeAtJoin = data.Stats.Playtime or 0,
		Released = false,
		InGroup = false,
		ShieldNoticeShown = false,
		WelcomeSent = false,
	}
end

function DataService.Get(player: Player): DataSchema.PlayerData?
	local profile = profiles[player]
	return if profile then profile.Data else nil
end

function DataService.GetSession(player: Player): Session?
	local profile = profiles[player]
	return if profile then profile.Session else nil
end

function DataService.IsLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

function DataService.WaitForData(player: Player, timeout: number?): DataSchema.PlayerData?
	local deadline = os.clock() + (timeout or 30)
	while player.Parent and os.clock() < deadline do
		local profile = profiles[player]
		if profile then
			return profile.Data
		end
		task.wait(0.1)
	end
	return nil
end

function DataService.Players(): { Player }
	local list = {}
	for player in profiles do
		table.insert(list, player)
	end
	return list
end

function DataService.MarkDirty(player: Player)
	local profile = profiles[player]
	if profile then
		profile.Dirty = true
		DataService.Changed:Fire(player)
	end
end

-- Returns true when the action is allowed (at most once per interval seconds).
function DataService.Throttle(player: Player, key: string, interval: number): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	local now = os.clock()
	local last = profile.Session.Throttles[key] or 0
	if now - last < interval then
		return false
	end
	profile.Session.Throttles[key] = now
	return true
end

function DataService.AddCash(player: Player, amount: number)
	local profile = profiles[player]
	if not profile or amount ~= amount or amount == math.huge then
		return
	end
	local data = profile.Data
	data.Cash = math.max(0, data.Cash + amount)
	if amount > 0 then
		data.LifetimeCash += amount
	end
	DataService.MarkDirty(player)
end

function DataService.SpendCash(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or amount < 0 or profile.Data.Cash < amount then
		return false
	end
	profile.Data.Cash -= amount
	DataService.MarkDirty(player)
	return true
end

function DataService.AddStat(player: Player, stat: string, amount: number)
	local profile = profiles[player]
	if profile then
		profile.Data.Stats[stat] = (profile.Data.Stats[stat] or 0) + amount
	end
end

local function updatePlaytime(profile: Profile)
	local session = profile.Session
	profile.Data.Stats.Playtime = session.PlaytimeAtJoin + math.floor(os.clock() - session.JoinTime)
end

-- Saves immediately (used after purchases). Returns true when the save is confirmed.
function DataService.SaveNow(player: Player): boolean
	local profile = profiles[player]
	if not profile or profile.LockLost then
		return false
	end
	updatePlaytime(profile)
	profile.Data.LastOnline = os.time()
	local ok, lockLost = store:Save(player.UserId, profile.Data, false)
	if lockLost then
		profile.LockLost = true
		player:Kick("Your progress was loaded on another server. Please rejoin!")
		return false
	end
	if ok then
		profile.Dirty = false
	end
	return ok
end

local function release(player: Player)
	local profile = profiles[player]
	if not profile or profile.Session.Released then
		return
	end
	profile.Session.Released = true
	releasing[player.UserId] = true
	pcall(function()
		DataService.Releasing:Fire(player, profile.Data)
	end)
	updatePlaytime(profile)
	profile.Data.LastOnline = os.time()
	if not profile.LockLost then
		store:Save(player.UserId, profile.Data, true)
	end
	profiles[player] = nil
	releasing[player.UserId] = nil
end

local function load(player: Player)
	-- If this player is still being released on this server (fast rejoin), wait so we read the final save.
	local waited = 0
	while releasing[player.UserId] and waited < 30 do
		task.wait(0.25)
		waited += 0.25
	end
	local raw, status = store:Load(player.UserId)
	if not player.Parent then
		if status == "ok" then
			store:Save(player.UserId, raw, true)
		end
		return
	end
	if status ~= "ok" then
		player:Kick("Your data is still saving on another server. Please rejoin in a minute!")
		return
	end
	if DataSchema.IsNewer(raw) then
		store:Save(player.UserId, raw, true)
		player:Kick("This server is out of date. Please rejoin to get the latest version!")
		return
	end
	local data = DataSchema.Migrate(raw)
	local now = os.time()
	if data.FirstJoin == 0 then
		data.FirstJoin = now
	end
	local profile: Profile = {
		Data = data,
		Session = newSession(data),
		Dirty = true,
		LockLost = false,
	}
	profiles[player] = profile
	DataService.Loaded:Fire(player, data)
	DataService.MarkDirty(player)
end

function DataService.Init()
	store = SaveStore.new(GameConfig.DataStoreName)
end

function DataService.IsMemoryStore(): boolean
	return store:IsMemory()
end

-- Called by the bootstrap after every service has started, so no Loaded/Releasing listener can miss a player
-- (in Studio the in-memory store loads instantly, without yielding).
function DataService.BeginLoading()
	Players.PlayerAdded:Connect(function(player)
		load(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		release(player)
	end)
end

function DataService.Start()
	-- Autosave loop, staggered across players.
	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveInterval)
			for player, profile in profiles do
				if not profile.Session.Released and player.Parent then
					task.spawn(function()
						DataService.SaveNow(player)
					end)
					task.wait(0.5)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				release(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--!strict
-- Generates the world at boot: ground, plaza, ring road, radial paths, the Brainrot Portal, scenery and lighting.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local MapGeometry = require(Shared.Modules.MapGeometry)

local MapService = {}

local mapFolder: Folder
local plotsFolder: Folder

local function part(
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material,
	parent: Instance,
	name: string?
): Part
	local p = Instance.new("Part")
	p.Name = name or "Part"
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function disc(
	diameter: number,
	thickness: number,
	y: number,
	color: Color3,
	material: Enum.Material,
	parent: Instance,
	name: string?
): Part
	local p = part(
		Vector3.new(thickness, diameter, diameter),
		CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90)),
		color,
		material,
		parent,
		name
	)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function ball(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, parent: Instance): Part
	local p = part(size, cf, color, material, parent)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

MapService.PlotAngle = MapGeometry.PlotAngle
MapService.PlotCFrame = MapGeometry.PlotCFrame
MapService.StopPosition = MapGeometry.StopPosition
MapService.PortalEdge = MapGeometry.PortalEdge

function MapService.PlotsFolder(): Folder
	return plotsFolder
end

local function buildGround()
	local ground = part(
		Vector3.new(720, 4, 720),
		CFrame.new(0, -2, 0),
		Color3.fromRGB(110, 185, 85),
		Enum.Material.Grass,
		mapFolder,
		"Ground"
	)
	ground:SetAttribute("Ground", true)
	-- Road ring (under the plaza disc so only an annulus shows)
	disc(
		2 * (GameConfig.BaseFrontRadius - 2),
		0.3,
		0.1,
		Color3.fromRGB(70, 72, 82),
		Enum.Material.Asphalt,
		mapFolder,
		"RingRoad"
	)
	disc(
		2 * (GameConfig.RingRoadRadius - 8),
		0.34,
		0.12,
		Color3.fromRGB(225, 215, 195),
		Enum.Material.Pavement,
		mapFolder,
		"Plaza"
	)
	-- Dashed centre line on the ring road
	local dashes = 72
	for i = 0, dashes - 1 do
		local angle = i * 2 * math.pi / dashes
		local pos =
			Vector3.new(math.cos(angle) * GameConfig.RingRoadRadius, 0.27, math.sin(angle) * GameConfig.RingRoadRadius)
		local dash = part(
			Vector3.new(0.6, 0.05, 3.2),
			CFrame.lookAt(pos, pos + Vector3.new(-math.sin(angle), 0, math.cos(angle))),
			Color3.fromRGB(255, 210, 60),
			Enum.Material.SmoothPlastic,
			mapFolder,
			"Dash"
		)
		dash.CanCollide = false
	end
	-- Radial carpets from the portal to every base
	for index = 1, GameConfig.MaxPlots do
		local a = MapService.PortalEdge(index)
		local bPos = MapService.StopPosition(index) + (MapService.StopPosition(index) - a).Unit * 6
		local mid = (a + bPos) / 2
		local length = (bPos - a).Magnitude
		local carpet = part(
			Vector3.new(7, 0.1, length),
			CFrame.lookAt(Vector3.new(mid.X, 0.33, mid.Z), Vector3.new(bPos.X, 0.33, bPos.Z)),
			Color3.fromRGB(200, 55, 70),
			Enum.Material.Fabric,
			mapFolder,
			"Carpet"
		)
		carpet.CanCollide = false
		for _, side in { -1, 1 } do
			local edge = part(
				Vector3.new(0.4, 0.12, length),
				carpet.CFrame * CFrame.new(side * 3.6, 0.01, 0),
				Color3.fromRGB(255, 215, 80),
				Enum.Material.Neon,
				mapFolder,
				"CarpetEdge"
			)
			edge.CanCollide = false
		end
	end
end

local function buildPortal()
	local portal = Instance.new("Model")
	portal.Name = "Portal"
	local base = disc(
		GameConfig.PortalRadius * 2 + 4,
		1.2,
		0.6,
		Color3.fromRGB(60, 45, 90),
		Enum.Material.Slate,
		portal,
		"PortalBase"
	)
	base.CanCollide = true
	local pit = disc(
		GameConfig.PortalRadius * 2 - 4,
		0.2,
		1.25,
		Color3.fromRGB(150, 70, 255),
		Enum.Material.Neon,
		portal,
		"Pit"
	)
	pit.Transparency = 0.15
	pit.CanCollide = false
	local segments = 24
	for i = 0, segments - 1 do
		local angle = i * 2 * math.pi / segments
		local pos = Vector3.new(
			math.cos(angle) * (GameConfig.PortalRadius - 0.5),
			1.6,
			math.sin(angle) * (GameConfig.PortalRadius - 0.5)
		)
		local seg = part(
			Vector3.new(1, 0.8, 3.6),
			CFrame.lookAt(pos, pos + Vector3.new(-math.sin(angle), 0, math.cos(angle))),
			if i % 2 == 0 then Color3.fromRGB(255, 80, 220) else Color3.fromRGB(80, 220, 255),
			Enum.Material.Neon,
			portal,
			"Rim"
		)
		seg.CanCollide = false
	end
	-- Four arches over the portal
	for i = 0, 3 do
		local angle = i * math.pi / 2 + math.pi / 8
		local pos = Vector3.new(
			math.cos(angle) * (GameConfig.PortalRadius + 1),
			9,
			math.sin(angle) * (GameConfig.PortalRadius + 1)
		)
		part(Vector3.new(2, 18, 2), CFrame.new(pos), Color3.fromRGB(70, 55, 110), Enum.Material.Slate, portal, "Spire")
		ball(
			Vector3.one * 3,
			CFrame.new(pos + Vector3.new(0, 10, 0)),
			Color3.fromRGB(190, 120, 255),
			Enum.Material.Neon,
			portal
		)
	end
	local beacon =
		part(Vector3.one, CFrame.new(0, 26, 0), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, portal, "Beacon")
	beacon.Transparency = 1
	beacon.CanCollide = false
	local swirlAttachment = Instance.new("Attachment")
	swirlAttachment.Position = Vector3.new(0, -24, 0)
	swirlAttachment.Parent = beacon
	local swirl = Instance.new("ParticleEmitter")
	swirl.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	swirl.Color = ColorSequence.new(Color3.fromRGB(200, 120, 255), Color3.fromRGB(90, 220, 255))
	swirl.LightEmission = 1
	swirl.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	swirl.Lifetime = NumberRange.new(1.5, 2.5)
	swirl.Speed = NumberRange.new(4, 8)
	swirl.SpreadAngle = Vector2.new(25, 25)
	swirl.EmissionDirection = Enum.NormalId.Top
	swirl.Rate = 25
	swirl.Parent = swirlAttachment
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(190, 120, 255)
	light.Range = 40
	light.Brightness = 2
	light.Parent = beacon
	portal.Parent = mapFolder
end

local function buildTree(pos: Vector3, scale: number, parent: Instance)
	local trunk = part(
		Vector3.new(1.6, 8, 1.6) * scale,
		CFrame.new(pos + Vector3.new(0, 4 * scale, 0)),
		Color3.fromRGB(110, 75, 45),
		Enum.Material.Wood,
		parent,
		"Trunk"
	)
	trunk.CanCollide = true
	local green = Color3.fromRGB(70 + math.floor(scale * 20), 160, 70)
	ball(
		Vector3.new(8, 7, 8) * scale,
		CFrame.new(pos + Vector3.new(0, 9 * scale, 0)),
		green,
		Enum.Material.Grass,
		parent
	)
	ball(
		Vector3.new(6, 5, 6) * scale,
		CFrame.new(pos + Vector3.new(1.5 * scale, 12 * scale, 0.5 * scale)),
		green,
		Enum.Material.Grass,
		parent
	)
end

local function buildScenery()
	local scenery = Instance.new("Folder")
	scenery.Name = "Scenery"
	local rng = Random.new(1337)
	for i = 0, 47 do
		local angle = i * 2 * math.pi / 48 + rng:NextNumber(-0.05, 0.05)
		local radius = rng:NextNumber(205, 300)
		buildTree(Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius), rng:NextNumber(0.9, 1.6), scenery)
	end
	-- Trees in the gaps between bases (outside the ring)
	for index = 1, GameConfig.MaxPlots do
		local angle = (index - 0.5) * (2 * math.pi / GameConfig.MaxPlots)
		for _, radius in { 104, 140, 170 } do
			buildTree(
				Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius),
				rng:NextNumber(0.8, 1.2),
				scenery
			)
		end
	end
	-- Flower clusters on the plaza
	for i = 0, 15 do
		local angle = i * 2 * math.pi / 16 + math.pi / 16
		local pos = Vector3.new(math.cos(angle) * 46, 0.4, math.sin(angle) * 46)
		disc(5, 0.6, 0, Color3.fromRGB(120, 85, 60), Enum.Material.Ground, scenery).CFrame = CFrame.new(pos)
			* CFrame.Angles(0, 0, math.rad(90))
		for j = 0, 4 do
			local fa = j * 1.3
			ball(
				Vector3.one * 0.9,
				CFrame.new(pos + Vector3.new(math.cos(fa) * 1.4, 0.8, math.sin(fa) * 1.4)),
				Color3.fromHSV((i * 0.13 + j * 0.05) % 1, 0.6, 1),
				Enum.Material.SmoothPlastic,
				scenery
			)
		end
	end
	-- Invisible world boundary
	local walls = 32
	for i = 0, walls - 1 do
		local angle = i * 2 * math.pi / walls
		local pos = Vector3.new(math.cos(angle) * 330, 60, math.sin(angle) * 330)
		local wall = part(
			Vector3.new(70, 120, 2),
			CFrame.lookAt(pos, Vector3.new(0, 60, 0)),
			Color3.new(1, 1, 1),
			Enum.Material.SmoothPlastic,
			scenery,
			"Boundary"
		)
		wall.Transparency = 1
	end
	scenery.Parent = mapFolder
end

local function buildLighting()
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(200, 220, 255)
	atmosphere.Decay = Color3.fromRGB(110, 130, 190)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.18
	color.Contrast = 0.05
	color.Brightness = 0.02
	color.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
	local sky = Instance.new("Sky")
	sky.SunAngularSize = 14
	sky.Parent = Lighting
end

function MapService.Init()
	mapFolder = Instance.new("Folder")
	mapFolder.Name = "Map"
	mapFolder.Parent = Workspace
	plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = Workspace

	buildGround()
	buildPortal()
	buildScenery()
	buildLighting()

	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "PlazaSpawn"
	spawnLocation.Size = Vector3.new(8, 0.4, 8)
	spawnLocation.CFrame = CFrame.new(math.cos(math.pi / 8) * 34, 0.3, math.sin(math.pi / 8) * 34)
	spawnLocation.Transparency = 1
	spawnLocation.CanCollide = false
	spawnLocation.Anchored = true
	spawnLocation.Duration = 0
	spawnLocation.Neutral = true
	spawnLocation.Parent = mapFolder

	-- Leaderboard anchor positions are exposed for LeaderboardService.
	local boards = Instance.new("Folder")
	boards.Name = "LeaderboardAnchors"
	for i, angle in { math.rad(22.5), math.rad(157.5), math.rad(292.5) } do
		local pos = Vector3.new(math.cos(angle) * 58, 0, math.sin(angle) * 58)
		local anchor = Instance.new("Part")
		anchor.Name = "Anchor" .. i
		anchor.Size = Vector3.one
		anchor.Transparency = 1
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CFrame = CFrame.lookAt(pos, Vector3.new(0, 0, 0)) * CFrame.Angles(0, math.rad(180), 0)
		anchor.Parent = boards
	end
	boards.Parent = mapFolder
end

function MapService.LeaderboardAnchors(): { BasePart }
	local list = {}
	for _, child in (mapFolder:WaitForChild("LeaderboardAnchors")):GetChildren() do
		if child:IsA("BasePart") then
			table.insert(list, child)
		end
	end
	table.sort(list, function(a, b)
		return a.Name < b.Name
	end)
	return list
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--!strict
-- Assigns plots, builds/rebuilds bases, owns door state (broken / repaired / shielded) and keeps intruders out
-- of bases whose door is intact.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Modules.Net)
local Signal = require(Shared.Modules.Signal)
local BaseBuilder = require(script.Parent.Parent.Modules.BaseBuilder)
local PlayerStats = require(script.Parent.Parent.Modules.PlayerStats)
local DataService = require(script.Parent.DataService)
local MapService = require(script.Parent.MapService)

export type Plot = {
	Index: number,
	CFrame: CFrame,
	Folder: Folder,
	Owner: Player?,
	Parts: BaseBuilder.BaseParts?,
	Empty: Model?,
	DoorBrokenUntil: number, -- server time
}

local PlotService = {}

PlotService.BaseBuilt = Signal.new() :: Signal.Signal<Player, Plot>
PlotService.DoorChanged = Signal.new() :: Signal.Signal<Plot>

local plots: { Plot } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

function PlotService.Get(index: number): Plot?
	return plots[index]
end

function PlotService.All(): { Plot }
	return plots
end

function PlotService.ForPlayer(player: Player): Plot?
	local session = DataService.GetSession(player)
	if session and session.Plot then
		return plots[session.Plot]
	end
	return nil
end

function PlotService.IsShielded(player: Player): boolean
	local data = DataService.Get(player)
	if not data then
		return true
	end
	return data.Tier <= 1 and (data.Stats.Playtime or 0) < GameConfig.NewbieShieldMinutes * 60 and data.Rebirths == 0
end

function PlotService.IsDoorBroken(plot: Plot): boolean
	return plot.DoorBrokenUntil > now()
end

-- Door is open for raiders: broken and the owner isn't protected by the newbie shield.
function PlotService.IsRaidable(plot: Plot): boolean
	local owner = plot.Owner
	if not owner or not PlotService.IsDoorBroken(plot) then
		return false
	end
	return not PlotService.IsShielded(owner)
end

local function setDoorVisual(plot: Plot, broken: boolean)
	local parts = plot.Parts
	if not parts then
		return
	end
	for _, child in parts.Door:GetDescendants() do
		if child:IsA("BasePart") then
			local base = child:GetAttribute("BaseTransparency")
			child.Transparency = if broken then 1 else (if type(base) == "number" then base else 0)
			if child.Name == "Panel" then
				child.CanCollide = not broken
			end
		end
	end
end

local function publishDoor(plot: Plot)
	local broken = PlotService.IsDoorBroken(plot)
	plot.Folder:SetAttribute("DoorBrokenUntil", if broken then plot.DoorBrokenUntil else 0)
	plot.Folder:SetAttribute("DoorOpen", PlotService.IsRaidable(plot))
	setDoorVisual(plot, broken)
	PlotService.DoorChanged:Fire(plot)
end

function PlotService.BreakDoor(plot: Plot, seconds: number)
	plot.DoorBrokenUntil = now() + seconds
	publishDoor(plot)
end

function PlotService.RepairDoor(plot: Plot)
	plot.DoorBrokenUntil = 0
	publishDoor(plot)
end

function PlotService.PublishStats(player: Player)
	local plot = PlotService.ForPlayer(player)
	local data = DataService.Get(player)
	local session = DataService.GetSession(player)
	if not plot or not data or not session then
		return
	end
	plot.Folder:SetAttribute("Tier", data.Tier)
	plot.Folder:SetAttribute("Rebirths", data.Rebirths)
	plot.Folder:SetAttribute("CrystalPower", PlayerStats.CrystalPower(data, session.Passes))
	plot.Folder:SetAttribute("DoorStrength", PlayerStats.DoorStrength(data, session.Passes))
	plot.Folder:SetAttribute("Shielded", PlotService.IsShielded(player))
	plot.Folder:SetAttribute("IronDoorUntil", session.IronDoorUntil)
end

local function buildFor(player: Player, plot: Plot)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if plot.Parts then
		plot.Parts.Model:Destroy()
		plot.Parts = nil
	end
	if plot.Empty then
		plot.Empty:Destroy()
		plot.Empty = nil
	end
	plot.Parts = BaseBuilder.Build(plot.CFrame, data.Tier, data.Rebirths, player.DisplayName, plot.Folder)
	publishDoor(plot)
	PlotService.PublishStats(player)
	PlotService.BaseBuilt:Fire(player, plot)
end

-- Rebuilds the base in the player's current tier theme (after a tier upgrade or rebirth).
function PlotService.Rebuild(player: Player)
	local plot = PlotService.ForPlayer(player)
	if plot then
		buildFor(player, plot)
	end
end

function PlotService.SpawnCFrame(plot: Plot): CFrame
	return plot.CFrame * CFrame.new(0, 4, -GameConfig.BaseSize / 2 + 8) * CFrame.Angles(0, math.rad(180), 0)
end

function PlotService.CrystalPosition(plot: Plot): Vector3
	return (plot.CFrame * CFrame.new(0, BaseBuilder.CrystalHeight, 0)).Position
end

function PlotService.DoorPosition(plot: Plot): Vector3
	return (plot.CFrame * CFrame.new(0, 1, -GameConfig.BaseSize / 2 + 1)).Position
end

-- True when a world position is inside the plot's walls.
function PlotService.Contains(plot: Plot, position: Vector3, margin: number?): boolean
	local localPos = plot.CFrame:PointToObjectSpace(position)
	local half = GameConfig.BaseSize / 2 - (margin or 1.5)
	return math.abs(localPos.X) < half and math.abs(localPos.Z) < half and localPos.Y < 60
end

local function teleportHome(player: Player)
	local plot = PlotService.ForPlayer(player)
	local character = player.Character
	if plot and character then
		character:PivotTo(PlotService.SpawnCFrame(plot))
	end
end
PlotService.TeleportHome = teleportHome

local function assign(player: Player)
	for _, plot in plots do
		if plot.Owner == nil then
			plot.Owner = player
			local session = DataService.GetSession(player)
			if session then
				session.Plot = plot.Index
			end
			plot.Folder:SetAttribute("OwnerId", player.UserId)
			plot.Folder:SetAttribute("OwnerName", player.DisplayName)
			player:SetAttribute("Plot", plot.Index)
			plot.DoorBrokenUntil = 0
			buildFor(player, plot)
			if player.Character then
				teleportHome(player)
			end
			return
		end
	end
	player:Kick("This server is full. Please join another one!")
end

local function unassign(player: Player)
	for _, plot in plots do
		if plot.Owner == player then
			plot.Owner = nil
			plot.DoorBrokenUntil = 0
			plot.Folder:SetAttribute("OwnerId", 0)
			plot.Folder:SetAttribute("OwnerName", "")
			plot.Folder:SetAttribute("DoorOpen", false)
			plot.Folder:SetAttribute("DoorBrokenUntil", 0)
			if plot.Parts then
				plot.Parts.Model:Destroy()
				plot.Parts = nil
			end
			plot.Empty = BaseBuilder.BuildEmpty(plot.CFrame, plot.Folder)
		end
	end
end

local function onRepair(player: Player)
	if not DataService.Throttle(player, "Repair", 0.4) then
		return
	end
	local plot = PlotService.ForPlayer(player)
	local character = player.Character
	if not plot or not character or not PlotService.IsDoorBroken(plot) then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - PlotService.DoorPosition(plot)).Magnitude > 16 then
		return
	end
	local session = DataService.GetSession(player)
	local amount = GameConfig.DoorRepairPerHoldSecond * 1.5
	if session and session.Passes.Fortress then
		amount *= 2
	end
	plot.DoorBrokenUntil -= amount
	if plot.DoorBrokenUntil <= now() then
		PlotService.RepairDoor(plot)
	else
		publishDoor(plot)
	end
end

function PlotService.Init()
	for index = 1, GameConfig.MaxPlots do
		local folder = Instance.new("Folder")
		folder.Name = "Plot" .. index
		folder:SetAttribute("PlotIndex", index)
		folder:SetAttribute("OwnerId", 0)
		folder:SetAttribute("Angle", MapService.PlotAngle(index))
		folder.Parent = MapService.PlotsFolder()
		local plot: Plot = {
			Index = index,
			CFrame = MapService.PlotCFrame(index),
			Folder = folder,
			Owner = nil,
			Parts = nil,
			Empty = nil,
			DoorBrokenUntil = 0,
		}
		plot.Empty = BaseBuilder.BuildEmpty(plot.CFrame, folder)
		plots[index] = plot
	end
end

function PlotService.Start()
	DataService.Loaded:Connect(function(player)
		assign(player)
	end)
	DataService.Releasing:Connect(function(player)
		unassign(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		unassign(player)
	end)

	local function hookCharacter(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			task.wait(0.1)
			teleportHome(player)
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.WalkSpeed = GameConfig.PlayerWalkSpeed
			end
		end)
	end
	Players.PlayerAdded:Connect(hookCharacter)
	for _, player in Players:GetPlayers() do
		hookCharacter(player)
	end

	Net.Event("Repair").OnServerEvent:Connect(onRepair)

	-- Door timers + intruder enforcement.
	task.spawn(function()
		while true do
			task.wait(0.25)
			local t = now()
			for _, plot in plots do
				local owner = plot.Owner
				if not owner then
					continue
				end
				if plot.DoorBrokenUntil > 0 and plot.DoorBrokenUntil <= t then
					PlotService.RepairDoor(plot)
				end
				if PlotService.IsRaidable(plot) then
					continue
				end
				for _, other in Players:GetPlayers() do
					if other == owner then
						continue
					end
					local character = other.Character
					local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root and PlotService.Contains(plot, root.Position) then
						local outside = plot.CFrame * CFrame.new(0, 4, -GameConfig.BaseSize / 2 - 6)
						if character then
							character:PivotTo(outside)
						end
					end
				end
			end
		end
	end)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!strict
-- Grants reward specs (cash, income-scaled cash, boosts) and handles Index set rewards and player settings.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Brainrots = require(Shared.Config.Brainrots)
local Rarities = require(Shared.Config.Rarities)
local Rewards = require(Shared.Config.Rewards)
local BrainrotStats = require(Shared.Modules.BrainrotStats)
local Format = require(Shared.Modules.Format)
local Net = require(Shared.Modules.Net)
local DataService = require(script.Parent.DataService)

local RewardService = {}

-- Applies a reward and returns a description of what was granted.
function RewardService.Grant(player: Player, reward: Rewards.Reward): string
	local data = DataService.Get(player)
	local session = DataService.GetSession(player)
	if not data or not session then
		return ""
	end
	local cash = reward.Cash or 0
	if reward.CashMinutes then
		cash += math.max(reward.MinCash or 0, math.floor(session.IncomeCache * reward.CashMinutes * 60))
	end
	if cash > 0 then
		DataService.AddCash(player, cash)
	end
	if reward.Boosts then
		for name, count in reward.Boosts do
			data.Boosts[name] = (data.Boosts[name] or 0) + count
		end
	end
	DataService.MarkDirty(player)
	return Rewards.Describe(reward, cash, Format.Cash)
end

function RewardService.IndexProgress(data: { Index: { [string]: boolean } }, rarity: number): (number, number)
	local bucket = Brainrots.OfRarity(rarity)
	local found = 0
	for _, def in bucket do
		if data.Index[BrainrotStats.IndexKey(def.Id, "None")] then
			found += 1
		end
	end
	return found, #bucket
end

local function onClaimIndex(player: Player, rarity: unknown): (boolean, string)
	if not DataService.Throttle(player, "ClaimIndex", 0.5) then
		return false, "Slow down!"
	end
	local data = DataService.Get(player)
	if not data or type(rarity) ~= "number" or Rewards.IndexSets[rarity] == nil then
		return false, "Not available"
	end
	local key = tostring(rarity)
	if data.IndexClaimed[key] then
		return false, "Already claimed"
	end
	local found, total = RewardService.IndexProgress(data, rarity)
	if found < total then
		return false, string.format("Discover all %s brainrots first (%d/%d)", Rarities.Get(rarity).Name, found, total)
	end
	data.IndexClaimed[key] = true
	local text = RewardService.Grant(player, Rewards.IndexSets[rarity])
	Net.Event("Effect"):FireClient(player, "Reward", { Text = text })
	return true, "Index reward: " .. text
end

local function onSettings(player: Player, key: unknown, value: unknown)
	if not DataService.Throttle(player, "Settings", 0.2) then
		return
	end
	local data = DataService.Get(player)
	if not data or type(value) ~= "boolean" then
		return
	end
	if key == "Music" then
		data.Settings.Music = value
	elseif key == "Sfx" then
		data.Settings.Sfx = value
	else
		return
	end
	DataService.MarkDirty(player)
end

function RewardService.Start()
	Net.Function("ClaimIndex").OnServerInvoke = onClaimIndex
	Net.Event("Settings").OnServerEvent:Connect(onSettings)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">SyncService</string>
            <string name="Source"><![CDATA[--!strict
-- Sends each player a snapshot of their own state whenever it changes (coalesced), and maintains leaderstats.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Modules.Format)
local Net = require(Shared.Modules.Net)
local PlayerStats = require(script.Parent.Parent.Modules.PlayerStats)
local BrainrotService = require(script.Parent.BrainrotService)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)

local SyncService = {}

local dirty: { [Player]: boolean } = {}
-- Extra fields other services contribute to the snapshot (daily status, shop info, ...).
local providers: { (Player, { [string]: any }) -> () } = {}

function SyncService.AddProvider(provider: (Player, { [string]: any }) -> ())
	table.insert(providers, provider)
end

local function buildState(player: Player): { [string]: any }?
	local data = DataService.Get(player)
	local session = DataService.GetSession(player)
	if not data or not session then
		return nil
	end
	local slotOf: { [string]: number } = {}
	for slot, uid in BrainrotService.PlacedSlots(data) do
		slotOf[uid] = slot
	end
	local brainrots = {}
	for uid, record in data.Brainrots do
		table.insert(brainrots, {
			Uid = uid,
			Id = record.Id,
			Mutation = record.Mutation,
			Size = record.Size,
			Slot = slotOf[uid],
			Income = BrainrotService.Income(record),
		})
	end
	local state: { [string]: any } = {
		Cash = data.Cash,
		LifetimeCash = data.LifetimeCash,
		Tier = data.Tier,
		CrystalLevel = data.CrystalLevel,
		DoorLevel = data.DoorLevel,
		Rebirths = data.Rebirths,
		Income = session.IncomeCache,
		CashMultiplier = session.CashMultiplier,
		CrystalPower = PlayerStats.CrystalPower(data, session.Passes),
		DoorStrength = PlayerStats.DoorStrength(data, session.Passes),
		Charge = session.Charge,
		Brainrots = brainrots,
		SlotsUnlocked = Economy.Slots(data.Tier),
		StorageMax = GameConfig.StorageMax,
		Index = data.Index,
		IndexCount = PlayerStats.IndexCount(data),
		IndexClaimed = data.IndexClaimed,
		Boosts = data.Boosts,
		Overcharge = session.Overcharge,
		IronDoorUntil = session.IronDoorUntil,
		LuckyPending = session.LuckyPending,
		GoldenPending = session.GoldenPending,
		Passes = session.Passes,
		Tutorial = data.Tutorial,
		Stats = data.Stats,
		Settings = data.Settings,
		Plot = session.Plot,
		Shielded = PlotService.IsShielded(player),
		RebirthCost = Economy.RebirthCost(data.Rebirths),
		SessionSeconds = os.clock() - session.JoinTime,
	}
	for _, provider in providers do
		local ok, err = pcall(provider :: any, player, state)
		if not ok then
			warn("[SyncService] provider failed: " .. tostring(err))
		end
	end
	return state
end

local function updateLeaderstats(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		local folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		local cash = Instance.new("StringValue")
		cash.Name = "Cash"
		cash.Parent = folder
		local rebirths = Instance.new("IntValue")
		rebirths.Name = "Rebirths"
		rebirths.Parent = folder
		folder.Parent = player
		stats = folder
	end
	if stats then
		local cash = stats:FindFirstChild("Cash") :: StringValue?
		local rebirths = stats:FindFirstChild("Rebirths") :: IntValue?
		if cash then
			cash.Value = Format.Cash(data.Cash)
		end
		if rebirths then
			rebirths.Value = data.Rebirths
		end
	end
end

function SyncService.Flush(player: Player)
	dirty[player] = nil
	local state = buildState(player)
	if state then
		Net.Event("State"):FireClient(player, state)
		updateLeaderstats(player)
		PlotService.PublishStats(player)
	end
end

function SyncService.Start()
	DataService.Changed:Connect(function(player)
		dirty[player] = true
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			for player in dirty do
				if player.Parent then
					SyncService.Flush(player)
				else
					dirty[player] = nil
				end
			end
		end
	end)
end

return SyncService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">UpgradeService</string>
            <string name="Source"><![CDATA[--!strict
-- Crystal / Door / Base Tier upgrades and Rebirth. All costs and gates come from shared Economy.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Themes = require(Shared.Config.Themes)
local Format = require(Shared.Modules.Format)
local Net = require(Shared.Modules.Net)
local Signal = require(Shared.Modules.Signal)
local BrainrotService = require(script.Parent.BrainrotService)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)

local UpgradeService = {}

UpgradeService.Upgraded = Signal.new() :: Signal.Signal<Player, string>

local function announce(text: string, color: Color3)
	Net.Event("Announce"):FireAllClients(text, color)
end

local function onUpgrade(player: Player, kind: unknown): (boolean, string)
	if not DataService.Throttle(player, "Upgrade", 0.08) then
		return false, "Slow down!"
	end
	local data = DataService.Get(player)
	if not data or type(kind) ~= "string" then
		return false, "Not ready"
	end
	local maxLevel = Economy.MaxLevelForTier(data.Tier)
	if kind == "Crystal" then
		if data.CrystalLevel >= maxLevel then
			return false,
				if data.Tier < Economy.MaxTier then "Crystal maxed! Upgrade your base tier." else "Crystal fully maxed!"
		end
		local cost = Economy.CrystalCost(data.CrystalLevel)
		if not DataService.SpendCash(player, cost) then
			return false, "Need " .. Format.Cash(cost)
		end
		data.CrystalLevel += 1
	elseif kind == "Door" then
		if data.DoorLevel >= maxLevel then
			return false,
				if data.Tier < Economy.MaxTier then "Door maxed! Upgrade your base tier." else "Door fully maxed!"
		end
		local cost = Economy.DoorCost(data.DoorLevel)
		if not DataService.SpendCash(player, cost) then
			return false, "Need " .. Format.Cash(cost)
		end
		data.DoorLevel += 1
	elseif kind == "Tier" then
		if data.Tier >= Economy.MaxTier then
			return false, "Max tier reached! Time to Rebirth."
		end
		if not Economy.CanTierUp(data.Tier, data.CrystalLevel) then
			return false, string.format("Max your crystal first (Lv %d)", Economy.MaxLevelForTier(data.Tier))
		end
		local cost = Economy.TierCost(data.Tier)
		if not DataService.SpendCash(player, cost) then
			return false, "Need " .. Format.Cash(cost)
		end
		BrainrotService.CollectAll(player)
		data.Tier += 1
		PlotService.Rebuild(player)
		local theme = Themes.Get(data.Tier)
		Net.Event("Effect"):FireClient(player, "TierUp", { Tier = data.Tier, Name = theme.Name })
		if data.Tier >= 5 then
			announce(string.format("%s upgraded to %s!", player.DisplayName, theme.Name), theme.Glow)
		end
	else
		return false, "Unknown upgrade"
	end
	DataService.MarkDirty(player)
	UpgradeService.Upgraded:Fire(player, kind)
	return true, "Upgraded!"
end

local function onRebirth(player: Player): (boolean, string)
	if not DataService.Throttle(player, "Rebirth", 1) then
		return false, "Slow down!"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "Not ready"
	end
	if not Economy.CanRebirth(data.Tier, data.CrystalLevel, data.Cash, data.Rebirths) then
		return false,
			string.format(
				"Reach Tier %d, max your crystal and have %s",
				Economy.MaxTier,
				Format.Cash(Economy.RebirthCost(data.Rebirths))
			)
	end
	BrainrotService.CollectAll(player)
	data.Rebirths += 1
	data.Cash = 0
	data.Tier = 1
	data.CrystalLevel = 1
	data.DoorLevel = 1
	-- Keep every brainrot: the best ones go back on the (fewer) tier-1 pedestals, the rest wait in storage.
	PlotService.Rebuild(player)
	BrainrotService.PlaceBest(player)
	Net.Event("Effect"):FireClient(player, "Rebirth", { Rebirths = data.Rebirths })
	announce(
		string.format("%s REBIRTHED! (Rebirth %d)", player.DisplayName, data.Rebirths),
		Color3.fromRGB(255, 120, 230)
	)
	DataService.MarkDirty(player)
	DataService.SaveNow(player)
	UpgradeService.Upgraded:Fire(player, "Rebirth")
	return true, "Rebirthed!"
end

function UpgradeService.Start()
	Net.Function("Upgrade").OnServerInvoke = onUpgrade
	Net.Function("Rebirth").OnServerInvoke = onRebirth
end

return UpgradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">WaveService</string>
            <string name="Source"><![CDATA[--!strict
-- The heart of the game. Every WaveInterval seconds one brainrot per player bursts out of the central portal and
-- marches to its owner's door. CHARGE taps add crystal power; the showdown decides Captured / DoorHeld /
-- DoorBroken. Brainrots that beat a crystal escape and run a lap of the ring road, where any strong enough crystal
-- can beam them. All timing uses server time so clients can animate the exact same motion locally.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Brainrots = require(Shared.Config.Brainrots)
local GameConfig = require(Shared.Config.GameConfig)
local Mutations = require(Shared.Config.Mutations)
local Rarities = require(Shared.Config.Rarities)
local Sizes = require(Shared.Config.Sizes)
local BrainrotStats = require(Shared.Modules.BrainrotStats)
local Net = require(Shared.Modules.Net)
local Signal = require(Shared.Modules.Signal)
local WaveRoll = require(Shared.Modules.WaveRoll)
local PlayerStats = require(script.Parent.Parent.Modules.PlayerStats)
local ServerState = require(script.Parent.Parent.Modules.ServerState)
local BrainrotService = require(script.Parent.BrainrotService)
local DataService = require(script.Parent.DataService)
local MapService = require(script.Parent.MapService)
local PlotService = require(script.Parent.PlotService)

export type Entry = {
	Id: number,
	Plot: number,
	UserId: number,
	Roll: WaveRoll.Roll,
	Start: number,
	Arrive: number,
	Resolve: number,
	Resolved: boolean,
}

local WaveService = {}

WaveService.Resolved = Signal.new() :: Signal.Signal<Player, string, Entry>

local random = Random.new()
local rng: WaveRoll.Rng = {
	NextNumber = function(_self: WaveRoll.Rng): number
		return random:NextNumber()
	end,
}
local nextEntryId = 0
local nextEscapeId = 0
local pending: { [Player]: { Entry } } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function rarityName(roll: WaveRoll.Roll): string
	return Rarities.Get(roll.Rarity).Name
end

local function announce(text: string, color: Color3?)
	Net.Event("Announce"):FireAllClients(text, color or Color3.fromRGB(255, 220, 90))
end
WaveService.Announce = announce

local function walkTime(plotIndex: number, size: string): number
	local distance = (MapService.StopPosition(plotIndex) - MapService.PortalEdge(plotIndex)).Magnitude
	local speed = GameConfig.WalkSpeed / (Sizes.Get(size).Scale ^ 0.35)
	return distance / speed
end

local function serialize(entry: Entry): { [string]: any }
	return {
		Id = entry.Id,
		Plot = entry.Plot,
		UserId = entry.UserId,
		BrainrotId = entry.Roll.Id,
		Mutation = entry.Roll.Mutation,
		Size = entry.Roll.Size,
		Power = entry.Roll.Power,
		Boss = entry.Roll.Boss,
		Guaranteed = entry.Roll.Guaranteed,
		Start = entry.Start,
		Arrive = entry.Arrive,
		Resolve = entry.Resolve,
	}
end

local function rollParams(player: Player): WaveRoll.RollParams?
	local data = DataService.Get(player)
	local session = DataService.GetSession(player)
	if not data or not session then
		return nil
	end
	local params: WaveRoll.RollParams = {
		Tier = data.Tier,
		Rebirths = data.Rebirths,
		Luck = PlayerStats.Luck(session.Passes),
		MutationMult = PlayerStats.MutationMultipliers(session.Passes),
		ForcedMutation = nil,
	}
	if session.GoldenPending then
		params.ForcedMutation = "Gold"
		session.GoldenPending = false
	end
	return params
end

local function makeEntry(player: Player, plotIndex: number, roll: WaveRoll.Roll, startAt: number): Entry
	nextEntryId += 1
	local start = startAt
	local arrive = start + GameConfig.EmergeTime + walkTime(plotIndex, roll.Size)
	return {
		Id = nextEntryId,
		Plot = plotIndex,
		UserId = player.UserId,
		Roll = roll,
		Start = start,
		Arrive = arrive,
		Resolve = arrive + GameConfig.ShowdownTime,
		Resolved = false,
	}
end

local function hasPending(player: Player): boolean
	local list = pending[player]
	if not list then
		return false
	end
	for _, entry in list do
		if not entry.Resolved then
			return true
		end
	end
	return false
end
WaveService.HasPending = hasPending

-- Returns the remaining unresolved entries for a player, clearing finished ones.
local function prune(player: Player)
	local list = pending[player]
	if not list then
		return
	end
	local keep = {}
	for _, entry in list do
		if not entry.Resolved then
			table.insert(keep, entry)
		end
	end
	pending[player] = keep
end

local resolveEntry: (Entry) -> ()

local function schedule(player: Player, entries: { Entry })
	local list = pending[player]
	if not list then
		list = {}
		pending[player] = list
	end
	for _, entry in entries do
		table.insert(list, entry)
		task.delay(math.max(0, entry.Resolve - now()), resolveEntry, entry)
	end
end

local function rollsFor(player: Player, stampede: boolean, tutorial: boolean): { WaveRoll.Roll }
	local data = DataService.Get(player)
	local session = DataService.GetSession(player)
	local params = rollParams(player)
	if not data or not session or not params then
		return {}
	end
	if tutorial then
		return { WaveRoll.Tutorial() }
	end
	session.WaveCount += 1
	local rolls = {}
	local crystal = PlayerStats.CrystalPower(data, session.Passes)
	local isBoss = stampede or (session.WaveCount % GameConfig.BossEvery == 0)
	if session.LuckyPending then
		session.LuckyPending = false
		table.insert(rolls, WaveRoll.RollLucky(rng, params))
	elseif isBoss then
		local minMult = if stampede then 1.3 else GameConfig.BossPowerMin
		local maxMult = if stampede then 2.6 else GameConfig.BossPowerMax
		table.insert(rolls, WaveRoll.RollBoss(rng, params, crystal, minMult, maxMult))
	else
		table.insert(rolls, WaveRoll.RollNormal(rng, params))
	end
	if session.Passes.DoubleWave then
		params.ForcedMutation = nil
		table.insert(rolls, WaveRoll.RollNormal(rng, params))
	end
	return rolls
end

-- Launches a wave for the given players (all players for a global wave, one for a personal wave).
local function launch(targets: { Player }, stampede: boolean, tutorialFor: Player?)
	local serialized = {}
	local startAt = now() + 0.6
	for _, player in targets do
		local plot = PlotService.ForPlayer(player)
		if not plot or not plot.Parts or hasPending(player) then
			continue
		end
		local rolls = rollsFor(player, stampede, player == tutorialFor)
		local entries = {}
		for lane, roll in rolls do
			local entry = makeEntry(player, plot.Index, roll, startAt + (lane - 1) * 1.8)
			table.insert(entries, entry)
			table.insert(serialized, serialize(entry))
		end
		local session = DataService.GetSession(player)
		if session then
			session.Charge = 0
		end
		schedule(player, entries)
	end
	if #serialized > 0 then
		Net.Event("WaveStart"):FireAllClients(serialized, stampede)
	end
end

---------------------------------------------------------------------------------------------------------------
-- Escapes
---------------------------------------------------------------------------------------------------------------

local function canHold(player: Player): boolean
	local data = DataService.Get(player)
	if not data then
		return false
	end
	return BrainrotService.FirstFreeSlot(data) ~= nil or BrainrotService.StorageCount(data) < GameConfig.StorageMax
end

local function startEscape(roll: WaveRoll.Roll, fromPlot: number, fromUserId: number, startAt: number)
	nextEscapeId += 1
	local escapeId = nextEscapeId
	local startAngle = MapService.PlotAngle(fromPlot)
	local dir = if random:NextNumber() < 0.5 then 1 else -1
	local radius = GameConfig.RingRoadRadius
	local speed = GameConfig.EscapeSpeed
	local lapTime = 2 * math.pi * radius / speed * GameConfig.EscapeLaps
	Net.Event("EscapeStart"):FireAllClients({
		Id = escapeId,
		BrainrotId = roll.Id,
		Mutation = roll.Mutation,
		Size = roll.Size,
		Power = roll.Power,
		FromPlot = fromPlot,
		Angle = startAngle,
		Dir = dir,
		Start = startAt,
		Speed = speed,
		Radius = radius,
		LapTime = lapTime,
	})

	local finished = false
	local stepAngle = 2 * math.pi / GameConfig.MaxPlots
	for step = 1, GameConfig.MaxPlots * GameConfig.EscapeLaps do
		local plotIndex = ((fromPlot - 1 + dir * step) % GameConfig.MaxPlots) + 1
		local passTime = startAt + step * stepAngle * radius / speed
		task.delay(math.max(0, passTime - now()), function()
			if finished or plotIndex == fromPlot then
				return
			end
			local plot = PlotService.Get(plotIndex)
			local owner = plot and plot.Owner
			if not plot or not owner or owner.UserId == fromUserId then
				return
			end
			local data = DataService.Get(owner)
			local session = DataService.GetSession(owner)
			if not data or not session or not canHold(owner) then
				return
			end
			local power = PlayerStats.CrystalPower(data, session.Passes)
			if power < roll.Power then
				return
			end
			finished = true
			Net.Event("EscapeEnd"):FireAllClients(escapeId, plotIndex, now())
			task.delay(1.1, function()
				if owner.Parent then
					BrainrotService.Add(owner, roll.Id, roll.Mutation, roll.Size, "Escape")
					DataService.AddStat(owner, "Captures", 1)
				end
			end)
			local def = Brainrots.ById[roll.Id]
			BrainrotService.Notify(owner, string.format("Your crystal beamed an escaped %s!", def.Name), "good")
			if roll.Rarity >= 4 then
				announce(
					string.format(
						"%s's crystal snatched an escaped %s %s!",
						owner.DisplayName,
						string.upper(rarityName(roll)),
						def.Name
					),
					Rarities.Get(roll.Rarity).Color
				)
			end
		end)
	end
	task.delay(math.max(0, startAt + lapTime - now()), function()
		if not finished then
			finished = true
			Net.Event("EscapeEnd"):FireAllClients(escapeId, 0, now())
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- Showdown
---------------------------------------------------------------------------------------------------------------

resolveEntry = function(entry: Entry)
	if entry.Resolved then
		return
	end
	entry.Resolved = true
	local player = Players:GetPlayerByUserId(entry.UserId)
	local plot = PlotService.Get(entry.Plot)
	if not player or not plot or plot.Owner ~= player then
		return
	end
	local data = DataService.Get(player)
	local session = DataService.GetSession(player)
	if not data or not session then
		return
	end
	local roll = entry.Roll
	local def = Brainrots.ById[roll.Id]
	local overcharge = if session.Overcharge then 0.5 else 0
	local crystal = PlayerStats.CrystalPower(data, session.Passes) * (1 + session.Charge + overcharge)
	local outcome: string
	if roll.Guaranteed or roll.Power <= crystal then
		outcome = "Captured"
		task.delay(1.0, function()
			if player.Parent then
				BrainrotService.Add(player, roll.Id, roll.Mutation, roll.Size, if roll.Boss then "Boss" else "Wave")
			end
		end)
		DataService.AddStat(player, "Captures", 1)
		if roll.Boss then
			DataService.AddStat(player, "Bosses", 1)
		end
		local rarity = Rarities.Get(roll.Rarity)
		local mutation = Mutations.Get(roll.Mutation)
		if rarity.Announce or mutation.Announce or roll.Size == "Giant" then
			announce(
				string.format(
					"%s beamed a %s %s!",
					player.DisplayName,
					string.upper(rarity.Name),
					BrainrotStats.DisplayName(roll.Id, roll.Mutation, roll.Size)
				),
				rarity.Color
			)
		end
	else
		local ironDoor = session.IronDoorUntil > os.time()
		local door = PlayerStats.DoorStrength(data, session.Passes)
		if ironDoor or door >= roll.Power then
			outcome = "DoorHeld"
			BrainrotService.Notify(
				player,
				if ironDoor
					then "Your Iron Door held! The brainrot ran off."
					else "Your door held! Upgrade your crystal to beam it next time.",
				"info"
			)
		else
			-- Short delay so the door vanishes exactly when the brainrot slams into it on every client.
			task.delay(0.4, function()
				if plot.Owner == player then
					PlotService.BreakDoor(plot, GameConfig.DoorBrokenTime)
				end
			end)
			DataService.AddStat(player, "DoorsBroken", 1)
			if PlotService.IsShielded(player) then
				outcome = "Shielded"
				BrainrotService.Notify(player, "Your door broke, but your Newbie Shield keeps thieves out!", "shield")
			else
				outcome = "DoorBroken"
				BrainrotService.Notify(
					player,
					"Your door is BROKEN! Hold REPAIR at the door before thieves get in!",
					"bad"
				)
				if roll.Rarity >= 4 or roll.Boss then
					announce(
						string.format("A %s smashed %s's door! RAID!", def.Name, player.DisplayName),
						Color3.fromRGB(255, 90, 90)
					)
				end
			end
		end
		startEscape(roll, entry.Plot, entry.UserId, now() + 1.3)
	end
	if overcharge > 0 then
		session.Overcharge = false
	end
	Net.Event("WaveResult"):FireAllClients({
		Id = entry.Id,
		Plot = entry.Plot,
		Outcome = outcome,
		Crystal = crystal,
		Power = roll.Power,
	})
	prune(player)
	if not hasPending(player) then
		session.Charge = 0
	end
	DataService.MarkDirty(player)
	WaveService.Resolved:Fire(player, outcome, entry)
end

---------------------------------------------------------------------------------------------------------------
-- Input + public API
---------------------------------------------------------------------------------------------------------------

local function onCharge(player: Player)
	local session = DataService.GetSession(player)
	local list = pending[player]
	if not session or not list then
		return
	end
	local t = now()
	local active = false
	for _, entry in list do
		if not entry.Resolved and t >= entry.Start and t <= entry.Resolve - 0.1 then
			active = true
			break
		end
	end
	if not active then
		return
	end
	local clock = os.clock()
	if clock - session.LastTap < GameConfig.ChargeMinTapInterval then
		return
	end
	session.LastTap = clock
	session.Charge = math.min(GameConfig.ChargeMax, session.Charge + GameConfig.ChargePerTap)
end

-- Sends a personal welcome wave to a brand-new player (their guaranteed first brainrot).
function WaveService.SendWelcomeWave(player: Player)
	task.delay(GameConfig.FirstWaveDelay, function()
		if not player.Parent or hasPending(player) then
			return
		end
		if ServerState.NextWaveAt - now() < 12 then
			return
		end
		launch({ player }, false, player)
	end)
end

function WaveService.PendingFor(player: Player): { Entry }
	return pending[player] or {}
end

function WaveService.Start()
	Net.Event("Charge").OnServerEvent:Connect(onCharge)

	Players.PlayerRemoving:Connect(function(player)
		pending[player] = nil
	end)

	PlotService.BaseBuilt:Connect(function(player)
		local data = DataService.Get(player)
		local session = DataService.GetSession(player)
		if data and session and not session.WelcomeSent and (data.Stats.Captures or 0) == 0 then
			session.WelcomeSent = true
			WaveService.SendWelcomeWave(player)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		task.wait(2)
		if player.Parent then
			ServerState.SendTo(player)
		end
	end)

	task.spawn(function()
		ServerState.NextWaveAt = now() + GameConfig.WaveInterval
		ServerState.Broadcast()
		while true do
			local wait = ServerState.NextWaveAt - now()
			if wait > 0 then
				task.wait(wait)
			end
			ServerState.WaveNumber += 1
			local stampede = ServerState.StampedeNextWave
			ServerState.StampedeNextWave = false
			if stampede then
				announce("🐘 STAMPEDE! Every brainrot this wave is a BOSS!", Color3.fromRGB(255, 120, 60))
			end
			ServerState.NextWaveAt = now() + GameConfig.WaveInterval
			ServerState.Broadcast()
			local targets = {}
			for _, player in DataService.Players() do
				table.insert(targets, player)
			end
			launch(targets, stampede, nil)
		end
	end)
end

return WaveService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="41">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="42">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">true</bool>
      <float name="CameraMaxZoomDistance">120</float>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="43">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="44">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Client bootstrap: initialises and starts every controller in order.

local Controllers = script:WaitForChild("Controllers")

type Controller = {
	Init: (() -> ())?,
	Start: (() -> ())?,
}

local order = {
	"StateController",
	"SoundController",
	"EffectsController",
	"WaveController",
	"WorldController",
	"UIController",
}

local loaded: { Controller } = {}
for _, name in order do
	local module = Controllers:FindFirstChild(name)
	if module and module:IsA("ModuleScript") then
		table.insert(loaded, (require :: any)(module) :: Controller)
	else
		warn("[Client] missing controller " .. name)
	end
end

for _, controller in loaded do
	if controller.Init then
		controller.Init()
	end
end
for _, controller in loaded do
	if controller.Start then
		task.spawn(controller.Start)
	end
end
]]></string>
        </Properties>
        <Item class="Folder" referent="45">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--!strict
-- Local juice: camera shake, door debris, flashes, particle bursts, floating cash numbers and confetti.

local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local EffectsController = {}

local shakeIntensity = 0
local shakeUntil = 0
local fx: Folder

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

function EffectsController.Shake(intensity: number, duration: number)
	shakeIntensity = math.max(shakeIntensity, intensity)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end

function EffectsController.Debris(cf: CFrame, size: Vector3, color: Color3, material: Enum.Material)
	local pieces = 14
	for i = 1, pieces do
		local piece = Instance.new("Part")
		piece.Size = Vector3.new(size.X / 4, size.Y / 5, size.Z) * (0.6 + math.random() * 0.6)
		piece.CFrame = cf
			* CFrame.new((math.random() - 0.5) * size.X, (math.random() - 0.5) * size.Y, 0)
			* CFrame.Angles(math.random() * 3, math.random() * 3, math.random() * 3)
		piece.Color = color
		piece.Material = material
		piece.CanCollide = true
		piece.CanQuery = false
		piece.CanTouch = false
		piece.Massless = false
		piece.Parent = fx
		local outward = (cf.LookVector * -1 + Vector3.new(
			(math.random() - 0.5) * 1.5,
			0.8 + math.random(),
			(math.random() - 0.5) * 1.5
		)).Unit
		piece.AssemblyLinearVelocity = outward * (35 + math.random() * 30)
		piece.AssemblyAngularVelocity = Vector3.new(math.random() * 10, math.random() * 10, math.random() * 10)
		task.delay(2 + i * 0.05, function()
			if piece.Parent then
				TweenService:Create(piece, TweenInfo.new(0.6), { Transparency = 1, Size = piece.Size * 0.3 }):Play()
			end
		end)
		Debris:AddItem(piece, 3.2)
	end
	EffectsController.Flash(cf.Position, Color3.fromRGB(255, 200, 120))
end

function EffectsController.Wobble(model: Model)
	local start = model:GetPivot()
	task.spawn(function()
		for i = 1, 8 do
			local offset = (if i % 2 == 0 then 1 else -1) * (9 - i) * 0.05
			model:PivotTo(start * CFrame.new(0, 0, offset) * CFrame.Angles(math.rad(offset * 6), 0, 0))
			task.wait(0.04)
		end
		model:PivotTo(start)
	end)
end

function EffectsController.Flash(position: Vector3, color: Color3)
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.one * 2
	ball.Position = position
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.Material = Enum.Material.Neon
	ball.Color = color
	ball.Transparency = 0.2
	ball.Parent = fx
	TweenService:Create(
		ball,
		TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.one * 14, Transparency = 1 }
	):Play()
	Debris:AddItem(ball, 0.5)
end

function EffectsController.Burst(position: Vector3, color: Color3)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = position
	holder.Parent = fx
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SPARKLE
	emitter.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Speed = NumberRange.new(14, 30)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 3
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(45)
	EffectsController.Flash(position, color)
	Debris:AddItem(holder, 2)
end

function EffectsController.FloatText(position: Vector3, text: string, color: Color3)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = position
	holder.Parent = fx
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(200, 50)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Parent = holder
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Text = text
	label.Parent = billboard
	TweenService:Create(
		holder,
		TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = position + Vector3.new(0, 6, 0) }
	):Play()
	TweenService:Create(
		label,
		TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ TextTransparency = 1, TextStrokeTransparency = 1 }
	):Play()
	Debris:AddItem(holder, 1.3)
end

-- 2D confetti across the screen (tier up, rebirth, big rewards).
function EffectsController.Confetti(screen: ScreenGui)
	for _ = 1, 60 do
		local bit = Instance.new("Frame")
		bit.Size = UDim2.fromOffset(math.random(8, 16), math.random(8, 16))
		bit.Position = UDim2.new(math.random(), 0, -0.05, 0)
		bit.BackgroundColor3 = Color3.fromHSV(math.random(), 0.7, 1)
		bit.BorderSizePixel = 0
		bit.Rotation = math.random(0, 360)
		bit.ZIndex = 50
		bit.Parent = screen
		local fall = TweenService:Create(
			bit,
			TweenInfo.new(1.6 + math.random() * 1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{
				Position = UDim2.new(bit.Position.X.Scale + (math.random() - 0.5) * 0.3, 0, 1.1, 0),
				Rotation = bit.Rotation + math.random(-360, 360),
			}
		)
		fall:Play()
		Debris:AddItem(bit, 3)
	end
end

function EffectsController.Init()
	fx = Instance.new("Folder")
	fx.Name = "LocalFX"
	fx.Parent = Workspace
end

function EffectsController.Start()
	RunService:BindToRenderStep("BrainrotShake", Enum.RenderPriority.Camera.Value + 1, function()
		local clock = os.clock()
		if clock >= shakeUntil then
			shakeIntensity = 0
			return
		end
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		local remaining = (shakeUntil - clock)
		local strength = shakeIntensity * math.clamp(remaining * 3, 0, 1)
		camera.CFrame *= CFrame.new((math.random() - 0.5) * strength, (math.random() - 0.5) * strength, 0)
	end)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[--!strict
-- Plays configured sounds (2D or positional) and the background music loop. Slots with empty ids are skipped.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared.Config.Sounds)

local SoundController = {}

local sfxEnabled = true
local musicEnabled = true
local music: Sound? = nil
local pool: { [string]: Sound } = {}

local function assetId(id: string): string
	return "rbxassetid://" .. id
end

function SoundController.Play(name: string, position: Vector3?)
	if not sfxEnabled then
		return
	end
	local def = Sounds[name]
	if not def or def.Id == "" then
		return
	end
	if position then
		local holder = Instance.new("Part")
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		holder.Transparency = 1
		holder.Size = Vector3.one
		holder.Position = position
		holder.Parent = Workspace
		local sound = Instance.new("Sound")
		sound.SoundId = assetId(def.Id)
		sound.Volume = def.Volume
		sound.PlaybackSpeed = def.Pitch or 1
		sound.RollOffMaxDistance = 260
		sound.RollOffMinDistance = 20
		sound.Parent = holder
		sound:Play()
		task.delay(6, function()
			holder:Destroy()
		end)
		return
	end
	local sound = pool[name]
	if not sound then
		local created = Instance.new("Sound")
		created.SoundId = assetId(def.Id)
		created.Volume = def.Volume
		created.PlaybackSpeed = def.Pitch or 1
		created.Parent = SoundService
		pool[name] = created
		sound = created
	end
	if sound then
		sound.TimePosition = 0
		sound:Play()
	end
end

function SoundController.SetSfx(enabled: boolean)
	sfxEnabled = enabled
end

function SoundController.SetMusic(enabled: boolean)
	musicEnabled = enabled
	if music then
		if enabled then
			music:Resume()
		else
			music:Pause()
		end
	end
end

function SoundController.Start()
	local def = Sounds.Music
	if def.Id ~= "" then
		local sound = Instance.new("Sound")
		sound.Name = "Music"
		sound.SoundId = assetId(def.Id)
		sound.Volume = def.Volume
		sound.Looped = true
		sound.Parent = SoundService
		music = sound
		if musicEnabled then
			sound:Play()
		end
	end
end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">StateController</string>
              <string name="Source"><![CDATA[--!strict
-- Holds the latest server snapshot for the local player plus server-wide info, and exposes change signals.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Modules.Net)
local Signal = require(Shared.Modules.Signal)

local StateController = {}

StateController.Changed = Signal.new() :: Signal.Signal<{ [string]: any }>
StateController.InfoChanged = Signal.new() :: Signal.Signal<{ [string]: any }>

local state: { [string]: any }? = nil
local info: { [string]: any } = {
	NextWaveAt = 0,
	ActiveEvent = "",
	EventEndsAt = 0,
	NextEventName = "",
	NextEventAt = 0,
	ServerLuckUntil = 0,
	ServerLuckBy = "",
	WeekendBoost = false,
}

function StateController.Get(): { [string]: any }?
	return state
end

function StateController.Info(): { [string]: any }
	return info
end

function StateController.Now(): number
	return Workspace:GetServerTimeNow()
end

function StateController.HasPass(name: string): boolean
	local current = state
	return current ~= nil and current.Passes ~= nil and current.Passes[name] == true
end

function StateController.Start()
	Net.Event("State").OnClientEvent:Connect(function(newState: { [string]: any })
		state = newState
		StateController.Changed:Fire(newState)
	end)
	Net.Event("ServerInfo").OnClientEvent:Connect(function(newInfo: { [string]: any })
		info = newInfo
		StateController.InfoChanged:Fire(newInfo)
	end)
end

return StateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
-- Builds the ScreenGui, scales it for the device, registers panels and wires server events to the HUD.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Modules.Format)
local Net = require(Shared.Modules.Net)
local UI = script.Parent.Parent.UI
local BrainrotsPanel = require(UI.BrainrotsPanel)
local Hud = require(UI.Hud)
local IndexPanel = require(UI.IndexPanel)
local Kit = require(UI.Kit)
local Panels = require(UI.Panels)
local SettingsPanel = require(UI.SettingsPanel)
local UpgradePanel = require(UI.UpgradePanel)
local EffectsController = require(script.Parent.EffectsController)
local SoundController = require(script.Parent.SoundController)
local StateController = require(script.Parent.StateController)
local WaveController = require(script.Parent.WaveController)
local WorldController = require(script.Parent.WorldController)

local LocalPlayer = Players.LocalPlayer

local UIController = {}

-- Other controllers can intercept menu clicks for panels they own (shop, daily, ...).
local menuHandlers: { [string]: () -> () } = {}

function UIController.OnMenu(name: string, handler: () -> ())
	menuHandlers[name] = handler
end

function UIController.Toast(text: string, kind: string?)
	Hud.Toast(text, kind)
	if kind == "bad" or kind == "warn" then
		SoundController.Play("Error")
	end
end

local function computeScale(): number
	local camera = Workspace.CurrentCamera
	if not camera then
		return 1
	end
	local size = camera.ViewportSize
	return math.clamp(math.min(size.X / 1100, size.Y / 620), 0.55, 1.25)
end

local function applyScale()
	local scale = computeScale()
	Hud.SetScale(scale)
	Panels.SetScale(scale)
end

local function tryCharge()
	if Hud.TryCharge() then
		Net.Event("Charge"):FireServer()
		SoundController.Play("Charge")
	end
end

function UIController.Start()
	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	local screen = Kit.new("ScreenGui", {
		Name = "BrainrotUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})

	Hud.Create(screen)
	Panels.Init(screen)
	UpgradePanel.Register(UIController.Toast)
	BrainrotsPanel.Register(UIController.Toast)
	IndexPanel.Register(UIController.Toast)
	SettingsPanel.Register()

	applyScale()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
	end

	Hud.MenuClicked:Connect(function(name)
		SoundController.Play("Click")
		local handler = menuHandlers[name]
		if handler then
			handler()
		else
			Panels.Toggle(name)
		end
	end)
	WorldController.KioskTriggered:Connect(function()
		Panels.Open("Upgrade")
	end)

	Hud.BoostPressed:Connect(function(name)
		local state = StateController.Get()
		local count = state and state.Boosts and state.Boosts[name] or 0
		local handler = menuHandlers["Boost:" .. name]
		if count <= 0 and handler then
			handler()
			return
		end
		local ok, message = Net.Function("UseBoost"):InvokeServer(name)
		UIController.Toast(message, if ok then "good" else "warn")
		if ok then
			SoundController.Play("Upgrade")
		end
	end)
	Hud.RepairOfferPressed:Connect(function()
		local handler = menuHandlers["InstantRepair"]
		if handler then
			handler()
		end
	end)
	Hud.ChargePressed:Connect(tryCharge)
	ContextActionService:BindAction("BrainrotCharge", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			tryCharge()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.F, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonX)

	StateController.Changed:Connect(function(state)
		Hud.SetState(state)
		Panels.Refresh(state)
		Hud.SetBadge("Index", IndexPanel.HasClaimable(state))
		local settings = state.Settings or {}
		SoundController.SetMusic(settings.Music ~= false)
		SoundController.SetSfx(settings.Sfx ~= false)
	end)

	Net.Event("Notify").OnClientEvent:Connect(function(text: string, kind: string?)
		UIController.Toast(text, kind)
	end)
	Net.Event("Announce").OnClientEvent:Connect(function(text: string, color: Color3?)
		Hud.Announce(text, color)
		SoundController.Play("Announce")
	end)
	Net.Event("Effect").OnClientEvent:Connect(function(kind: string, payload: { [string]: any })
		if kind == "Collect" then
			local character = LocalPlayer.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				EffectsController.FloatText(
					root.Position + Vector3.new(0, 3, 0),
					"+" .. Format.Cash(payload.Amount),
					Kit.Colors.Cash
				)
			end
			SoundController.Play("Collect")
		elseif kind == "TierUp" then
			EffectsController.Confetti(screen)
			Hud.Announce(string.format("🏰 TIER %d: %s!", payload.Tier, payload.Name), Kit.Colors.Yellow)
			SoundController.Play("TierUp")
		elseif kind == "Reward" then
			EffectsController.Confetti(screen)
			Hud.Announce("🎁 " .. tostring(payload.Text), Kit.Colors.Yellow)
			SoundController.Play("Reward")
		elseif kind == "Rebirth" then
			EffectsController.Confetti(screen)
			Hud.Announce(string.format("♻️ REBIRTH %d!", payload.Rebirths), Kit.Colors.Pink)
			SoundController.Play("TierUp")
		end
	end)

	WaveController.LocalIncoming:Connect(function(data)
		Hud.AddIncoming(data)
		if data.Boss then
			Hud.Announce("👑 BOSS BRAINROT INCOMING! CHARGE!", Kit.Colors.Orange)
		end
	end)
	WaveController.LocalResult:Connect(function(result)
		Hud.ResolveIncoming(result)
		if result.Outcome == "Captured" then
			Hud.Announce("✨ BEAMED! ✨", Kit.Colors.Green)
			SoundController.Play("Reward")
		elseif result.Outcome == "DoorBroken" then
			Hud.Announce("💥 DOOR SMASHED! REPAIR IT!", Kit.Colors.Red)
			SoundController.Play("Alarm")
		elseif result.Outcome == "Shielded" then
			Hud.Announce("🛡️ SHIELD SAVED YOU!", Color3.fromRGB(80, 220, 255))
		else
			Hud.Announce("🚪 DOOR HELD!", Kit.Colors.Orange)
		end
	end)

	RunService.Heartbeat:Connect(function()
		Hud.Update(StateController.Info())
	end)
end

return UIController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">WaveController</string>
              <string name="Source"><![CDATA[--!strict
-- Renders every wave brainrot and escaped brainrot locally from server timings: emerge from the portal, march
-- to the door, crystal beam struggle, then capture (sucked into the crystal) or the door smash + escape lap.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Brainrots = require(Shared.Config.Brainrots)
local GameConfig = require(Shared.Config.GameConfig)
local Rarities = require(Shared.Config.Rarities)
local Sizes = require(Shared.Config.Sizes)
local BrainrotBuilder = require(Shared.Modules.BrainrotBuilder)
local Format = require(Shared.Modules.Format)
local MapGeometry = require(Shared.Modules.MapGeometry)
local Net = require(Shared.Modules.Net)
local Signal = require(Shared.Modules.Signal)
local EffectsController = require(script.Parent.EffectsController)
local SoundController = require(script.Parent.SoundController)

local LocalPlayer = Players.LocalPlayer

local WaveController = {}

WaveController.LocalIncoming = Signal.new() :: Signal.Signal<{ [string]: any }>
WaveController.LocalResult = Signal.new() :: Signal.Signal<{ [string]: any }>

local WAVE_SCALE = 1.3

type Walker = {
	Data: { [string]: any },
	Model: Model,
	Root: BasePart,
	Height: number,
	Mode: string, -- "Walk" | "Capture" | "Smash" | "Escape" | "Done"
	ModeStart: number,
	Beam: Beam?,
	Target: Attachment?,
	CaptureFrom: CFrame?,
	CapturePlot: number?,
	Heading: CFrame?,
}

local walkers: { [number]: Walker } = {}
local escapes: { [number]: Walker } = {}
local fxFolder: Folder

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function plotFolder(index: number): Instance?
	local plots = Workspace:FindFirstChild("Plots")
	return plots and plots:FindFirstChild("Plot" .. index)
end

local function crystalAttachment(index: number): (Attachment?, Color3)
	local folder = plotFolder(index)
	local base = folder and folder:FindFirstChild("Base")
	local crystal = base and base:FindFirstChild("Crystal")
	local core = crystal and crystal:FindFirstChild("Core")
	local attachment = core and core:FindFirstChild("BeamOrigin") :: Attachment?
	local light = core and core:FindFirstChildOfClass("PointLight")
	return attachment, if light then light.Color else Color3.fromRGB(150, 220, 255)
end

local function doorModel(index: number): Model?
	local folder = plotFolder(index)
	local base = folder and folder:FindFirstChild("Base")
	return base and base:FindFirstChild("Door") :: Model?
end

local function makeTag(model: Model, root: BasePart, data: { [string]: any }, height: number, escaped: boolean)
	local def = Brainrots.Get(data.BrainrotId)
	local rarity = Rarities.Get(if def then def.Rarity else 1)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Tag"
	billboard.Size = UDim2.fromOffset(220, 90)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, height + 2.2, 0)
	billboard.MaxDistance = 220
	billboard.LightInfluence = 0
	billboard.AlwaysOnTop = false
	billboard.Parent = root
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Parent = billboard
	local function line(text: string, color: Color3, order: number, h: number)
		local label = Instance.new("TextLabel")
		label.LayoutOrder = order
		label.Size = UDim2.new(1, 0, h, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = color
		label.TextStrokeTransparency = 0
		label.Text = text
		label.Parent = billboard
	end
	if escaped then
		line("ESCAPED!", Color3.fromRGB(255, 90, 90), 0, 0.2)
	elseif data.Boss then
		line("👑 BOSS 👑", Color3.fromRGB(255, 120, 60), 0, 0.22)
	end
	local tags = {}
	if data.Size ~= "Normal" then
		table.insert(tags, string.upper(data.Size))
	end
	if data.Mutation ~= "None" then
		table.insert(tags, string.upper(data.Mutation))
	end
	table.insert(tags, string.upper(rarity.Name))
	line(table.concat(tags, " · "), rarity.Color, 1, 0.2)
	line(if def then def.Name else "???", Color3.new(1, 1, 1), 2, 0.3)
	line("⚡ " .. Format.Short(data.Power), Color3.fromRGB(255, 230, 90), 3, 0.28)
	if data.UserId == LocalPlayer.UserId and not escaped then
		billboard.AlwaysOnTop = true
		line("▼ YOURS ▼", Color3.fromRGB(120, 255, 140), 4, 0.18)
	end
	model:SetAttribute("TagHeight", height)
end

local function spawnModel(data: { [string]: any }, escaped: boolean): (Model, BasePart, number)
	local scale = Sizes.Get(data.Size).Scale * WAVE_SCALE
	local model = BrainrotBuilder.Build(data.BrainrotId, { Mutation = data.Mutation, Scale = scale })
	local root = model.PrimaryPart :: BasePart
	local height = (model:GetAttribute("Height") :: number?) or 5
	makeTag(model, root, data, height, escaped)
	local attachment = Instance.new("Attachment")
	attachment.Name = "BeamTarget"
	attachment.Position = Vector3.new(0, height * 0.55, 0)
	attachment.Parent = root
	model.Parent = fxFolder
	return model, root, height
end

local function startBeam(walker: Walker, plotIndex: number)
	local origin, color = crystalAttachment(plotIndex)
	local target = walker.Root:FindFirstChild("BeamTarget") :: Attachment?
	if not origin or not target then
		return
	end
	local beam = Instance.new("Beam")
	beam.Attachment0 = origin
	beam.Attachment1 = target
	beam.Width0 = 1.6
	beam.Width1 = 3.2
	beam.Color = ColorSequence.new(Color3.new(1, 1, 1), color)
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Segments = 12
	beam.Transparency = NumberSequence.new(0.05)
	beam.Parent = walker.Root
	walker.Beam = beam
end

local function stopBeam(walker: Walker)
	if walker.Beam then
		walker.Beam:Destroy()
		walker.Beam = nil
	end
end

local function destroyWalker(walker: Walker)
	walker.Mode = "Done"
	stopBeam(walker)
	walker.Model:Destroy()
end

local function smashDoor(plotIndex: number, broken: boolean)
	local door = doorModel(plotIndex)
	local panel = door and door:FindFirstChild("Panel") :: BasePart?
	if not panel then
		return
	end
	if broken then
		EffectsController.Debris(panel.CFrame, panel.Size, panel.Color, panel.Material)
		SoundController.Play("DoorBreak", panel.Position)
	else
		if door then
			EffectsController.Wobble(door)
		end
		SoundController.Play("DoorBlock", panel.Position)
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root and (root.Position - panel.Position).Magnitude < 80 then
		EffectsController.Shake(if broken then 0.9 else 0.4, 0.45)
	end
end

local function onWaveStart(entries: { { [string]: any } }, stampede: boolean)
	for _, data in entries do
		local model, root, height = spawnModel(data, false)
		local walker: Walker = {
			Data = data,
			Model = model,
			Root = root,
			Height = height,
			Mode = "Walk",
			ModeStart = data.Start,
			Beam = nil,
			Target = nil,
			CaptureFrom = nil,
			CapturePlot = nil,
			Heading = nil,
		}
		walkers[data.Id] = walker
		model:PivotTo(CFrame.new(0, -50, 0))
		if data.UserId == LocalPlayer.UserId then
			WaveController.LocalIncoming:Fire(data)
		end
	end
	SoundController.Play(if stampede then "Stampede" else "WaveHorn")
end

local function onWaveResult(result: { [string]: any })
	local walker = walkers[result.Id]
	if walker then
		local outcome = result.Outcome
		walker.ModeStart = now()
		if outcome == "Captured" then
			walker.Mode = "Capture"
			walker.CaptureFrom = walker.Root.CFrame
			walker.CapturePlot = result.Plot
			if not walker.Beam then
				startBeam(walker, result.Plot)
			end
			SoundController.Play("Capture", walker.Root.Position)
		else
			walker.Mode = "Smash"
			walker.CaptureFrom = walker.Root.CFrame
			stopBeam(walker)
			EffectsController.Flash(
				walker.Root.Position + Vector3.new(0, walker.Height * 0.5, 0),
				Color3.fromRGB(255, 70, 70)
			)
			local broken = outcome == "DoorBroken" or outcome == "Shielded"
			task.delay(0.4, function()
				smashDoor(result.Plot, broken)
			end)
		end
	end
	if walker and walker.Data.UserId == LocalPlayer.UserId then
		WaveController.LocalResult:Fire(result)
	end
end

local function onEscapeStart(data: { [string]: any })
	local model, root, height = spawnModel(data, true)
	local walker: Walker = {
		Data = data,
		Model = model,
		Root = root,
		Height = height,
		Mode = "Escape",
		ModeStart = data.Start,
		Beam = nil,
		Target = nil,
		CaptureFrom = nil,
		CapturePlot = nil,
		Heading = nil,
	}
	escapes[data.Id] = walker
	model:PivotTo(CFrame.new(MapGeometry.RingPosition(data.Angle, data.Radius)))
	-- Clean up the wave walker that is handing over to this escape.
	for id, wave in walkers do
		if wave.Data.Plot == data.FromPlot and wave.Mode == "Smash" then
			destroyWalker(wave)
			walkers[id] = nil
		end
	end
	task.delay(math.max(0, data.Start + data.LapTime + 6 - now()), function()
		local current = escapes[data.Id]
		if current and current.Mode ~= "Done" then
			destroyWalker(current)
			escapes[data.Id] = nil
		end
	end)
end

local function onEscapeEnd(escapeId: number, plotIndex: number, _time: number)
	local walker = escapes[escapeId]
	if not walker then
		return
	end
	walker.ModeStart = now()
	walker.CaptureFrom = walker.Root.CFrame
	if plotIndex > 0 then
		walker.Mode = "Capture"
		walker.CapturePlot = plotIndex
		startBeam(walker, plotIndex)
		SoundController.Play("Capture", walker.Root.Position)
	else
		walker.Mode = "Sink"
	end
end

local function waddle(t: number, speed: number): (number, number)
	local phase = t * speed
	return math.abs(math.sin(phase)) * 0.45, math.sin(phase) * math.rad(9)
end

local function update()
	local t = now()
	for id, walker in walkers do
		local data = walker.Data
		local mode = walker.Mode
		if mode == "Walk" then
			local edge = MapGeometry.PortalEdge(data.Plot)
			local stop = MapGeometry.StopPosition(data.Plot)
			local dir = (stop - edge).Unit
			local heading = CFrame.lookAt(Vector3.zero, dir)
			if t < data.Start then
				walker.Model:PivotTo(CFrame.new(edge - Vector3.new(0, walker.Height + 2, 0)) * heading.Rotation)
			elseif t < data.Start + GameConfig.EmergeTime then
				local alpha = (t - data.Start) / GameConfig.EmergeTime
				local eased = 1 - (1 - alpha) ^ 3
				local y = -walker.Height - 1 + (walker.Height + 1.3) * eased
				walker.Model:PivotTo(
					CFrame.new(edge + Vector3.new(0, y, 0))
						* heading.Rotation
						* CFrame.Angles(0, alpha * math.pi * 2, 0)
				)
			elseif t < data.Arrive then
				local alpha = (t - data.Start - GameConfig.EmergeTime)
					/ (data.Arrive - data.Start - GameConfig.EmergeTime)
				local pos = edge:Lerp(stop, alpha)
				local bob, sway = waddle(t, 9)
				walker.Model:PivotTo(
					CFrame.new(pos + Vector3.new(0, bob, 0)) * heading.Rotation * CFrame.Angles(0, 0, sway)
				)
			else
				if not walker.Beam and t < data.Resolve then
					startBeam(walker, data.Plot)
				end
				local shake = math.sin(t * 40) * 0.12
				walker.Model:PivotTo(
					CFrame.new(stop + Vector3.new(shake, math.abs(math.sin(t * 13)) * 0.3, 0))
						* heading.Rotation
						* CFrame.Angles(0, 0, math.sin(t * 25) * 0.08)
				)
				if walker.Beam then
					walker.Beam.CurveSize0 = math.sin(t * 17) * 2
					walker.Beam.CurveSize1 = math.cos(t * 13) * 2
					walker.Beam.Width1 = 3 + math.sin(t * 30) * 0.8
				end
				if t > data.Resolve + 4 then
					destroyWalker(walker)
					walkers[id] = nil
				end
			end
		elseif mode == "Capture" then
			local origin = crystalAttachment(walker.CapturePlot or data.Plot)
			local from = walker.CaptureFrom or walker.Root.CFrame
			local alpha = math.clamp((t - walker.ModeStart) / 1.0, 0, 1)
			if origin and alpha < 1 then
				local eased = alpha * alpha
				local target = origin.WorldPosition - Vector3.new(0, walker.Height * 0.3 * (1 - eased), 0)
				local pos = from.Position:Lerp(target, eased) + Vector3.new(0, math.sin(alpha * math.pi) * 6, 0)
				walker.Model:PivotTo(CFrame.new(pos) * from.Rotation * CFrame.Angles(0, alpha * math.pi * 6, 0))
				walker.Model:ScaleTo(math.max(0.05, 1 - eased * 0.95))
			else
				if origin then
					EffectsController.Burst(
						origin.WorldPosition,
						Rarities.Get((Brainrots.Get(data.BrainrotId) or Brainrots.List[1]).Rarity).Color
					)
				end
				destroyWalker(walker)
				walkers[id] = nil
			end
		elseif mode == "Smash" then
			local from = walker.CaptureFrom or walker.Root.CFrame
			local door = MapGeometry.DoorPosition(data.Plot)
			local alpha = math.clamp((t - walker.ModeStart) / 0.4, 0, 1)
			local pos = from.Position:Lerp(Vector3.new(door.X, from.Position.Y, door.Z), alpha * 0.55)
			walker.Model:PivotTo(CFrame.new(pos) * from.Rotation * CFrame.Angles(math.rad(-15) * alpha, 0, 0))
			if t - walker.ModeStart > 4 then
				destroyWalker(walker)
				walkers[id] = nil
			end
		end
	end

	for id, walker in escapes do
		local data = walker.Data
		if walker.Mode == "Escape" then
			local elapsed = math.max(0, t - data.Start)
			local angle = data.Angle + data.Dir * data.Speed * elapsed / data.Radius
			local pos = MapGeometry.RingPosition(angle, data.Radius)
			local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle)) * data.Dir
			local bob, sway = waddle(t, 14)
			walker.Model:PivotTo(CFrame.lookAt(pos, pos + tangent) * CFrame.new(0, bob, 0) * CFrame.Angles(0, 0, sway))
		elseif walker.Mode == "Capture" then
			local origin = crystalAttachment(walker.CapturePlot or 1)
			local from = walker.CaptureFrom or walker.Root.CFrame
			local alpha = math.clamp((t - walker.ModeStart) / 1.0, 0, 1)
			if origin and alpha < 1 then
				local eased = alpha * alpha
				local pos = from.Position:Lerp(origin.WorldPosition, eased)
					+ Vector3.new(0, math.sin(alpha * math.pi) * 6, 0)
				walker.Model:PivotTo(CFrame.new(pos) * from.Rotation * CFrame.Angles(0, alpha * math.pi * 6, 0))
				walker.Model:ScaleTo(math.max(0.05, 1 - eased * 0.95))
			else
				if origin then
					EffectsController.Burst(origin.WorldPosition, Color3.fromRGB(255, 255, 255))
				end
				destroyWalker(walker)
				escapes[id] = nil
			end
		elseif walker.Mode == "Sink" then
			local from = walker.CaptureFrom or walker.Root.CFrame
			local alpha = math.clamp((t - walker.ModeStart) / 2.5, 0, 1)
			local center = Vector3.new(0, 0.3 - alpha * 8, 0)
			local pos = from.Position:Lerp(center, alpha)
			walker.Model:PivotTo(CFrame.lookAt(pos, Vector3.new(0, pos.Y, 0) + Vector3.new(0.01, 0, 0)))
			if alpha >= 1 then
				destroyWalker(walker)
				escapes[id] = nil
			end
		end
	end
end

function WaveController.Init()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "WaveFX"
	fxFolder.Parent = Workspace
end

function WaveController.Start()
	Net.Event("WaveStart").OnClientEvent:Connect(onWaveStart)
	Net.Event("WaveResult").OnClientEvent:Connect(onWaveResult)
	Net.Event("EscapeStart").OnClientEvent:Connect(onEscapeStart)
	Net.Event("EscapeEnd").OnClientEvent:Connect(onEscapeEnd)
	RunService.RenderStepped:Connect(update)
end

return WaveController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">WorldController</string>
              <string name="Source"><![CDATA[--!strict
-- Local world behaviour: lets the owner walk through their own door, adds owner-only prompts (repair, upgrade
-- kiosk) and raid prompts on other bases, spins crystals, animates idle brainrots and shows crystal/door stats.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Modules.Format)
local Net = require(Shared.Modules.Net)
local Signal = require(Shared.Modules.Signal)

local LocalPlayer = Players.LocalPlayer

local WorldController = {}

WorldController.KioskTriggered = Signal.new() :: Signal.Signal<()>

type CrystalEntry = { Core: BasePart, Base: CFrame, Phase: number }
type BrainrotEntry = { Model: Model, Root: BasePart, Base: CFrame, Phase: number, Rainbow: { BasePart }? }

local crystals: { [Instance]: CrystalEntry } = {}
local brainrots: { [Model]: BrainrotEntry } = {}
local stealPrompts: { [Model]: ProximityPrompt } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function myPlot(): number?
	local value = LocalPlayer:GetAttribute("Plot")
	return if type(value) == "number" then value else nil
end

local function isMine(folder: Instance): boolean
	return folder:GetAttribute("PlotIndex") == myPlot()
end

local function setupStatsBillboard(folder: Instance, core: BasePart)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "CrystalStats"
	billboard.Size = UDim2.fromOffset(200, 64)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 7, 0)
	billboard.MaxDistance = 260
	billboard.LightInfluence = 0
	billboard.Parent = core
	local name = Instance.new("TextLabel")
	name.Name = "Owner"
	name.Size = UDim2.new(1, 0, 0.4, 0)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0
	name.Parent = billboard
	local stats = Instance.new("TextLabel")
	stats.Name = "Stats"
	stats.Position = UDim2.fromScale(0, 0.42)
	stats.Size = UDim2.new(1, 0, 0.58, 0)
	stats.BackgroundTransparency = 1
	stats.Font = Enum.Font.FredokaOne
	stats.TextScaled = true
	stats.TextColor3 = Color3.fromRGB(150, 220, 255)
	stats.TextStrokeTransparency = 0
	stats.Parent = billboard
	local function refresh()
		local ownerName = folder:GetAttribute("OwnerName")
		name.Text = if type(ownerName) == "string" then ownerName else ""
		local crystal = (folder:GetAttribute("CrystalPower") :: number?) or 0
		local door = (folder:GetAttribute("DoorStrength") :: number?) or 0
		stats.Text = string.format("💎 %s   🚪 %s", Format.Short(crystal), Format.Short(door))
	end
	refresh()
	folder:GetAttributeChangedSignal("CrystalPower"):Connect(refresh)
	folder:GetAttributeChangedSignal("DoorStrength"):Connect(refresh)
	folder:GetAttributeChangedSignal("OwnerName"):Connect(refresh)
end

local function setupOwnerPrompts(base: Instance)
	if base:GetAttribute("LocalOwnerSetup") then
		return
	end
	base:SetAttribute("LocalOwnerSetup", true)
	local door = base:FindFirstChild("Door")
	local panel = door and door:FindFirstChild("Panel") :: BasePart?
	if panel then
		-- Owner walks straight through their own door (collision is only disabled in this client's physics).
		panel.CanCollide = false
		panel:GetPropertyChangedSignal("CanCollide"):Connect(function()
			if panel.CanCollide then
				panel.CanCollide = false
			end
		end)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "RepairPrompt"
		prompt.ActionText = "Repair Door"
		prompt.ObjectText = "Your Door"
		prompt.HoldDuration = 0.5
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.Enabled = false
		prompt.Parent = panel
		prompt.Triggered:Connect(function()
			Net.Event("Repair"):FireServer()
		end)
		task.spawn(function()
			while prompt.Parent do
				local folder = base.Parent
				local brokenUntil = folder and (folder:GetAttribute("DoorBrokenUntil") :: number?) or 0
				prompt.Enabled = brokenUntil > now()
				task.wait(0.25)
			end
		end)
	end
	local kiosk = base:FindFirstChild("Kiosk") :: BasePart?
	if kiosk then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Upgrade"
		prompt.ObjectText = "Base"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = kiosk
		prompt.Triggered:Connect(function()
			WorldController.KioskTriggered:Fire()
		end)
	end
end

local function updateStealPrompt(model: Model)
	local prompt = stealPrompts[model]
	if not prompt then
		return
	end
	local plotIndex = model:GetAttribute("PlotIndex")
	local plots = Workspace:FindFirstChild("Plots")
	local folder = plots and type(plotIndex) == "number" and plots:FindFirstChild("Plot" .. plotIndex)
	local open = folder ~= nil and folder:GetAttribute("DoorOpen") == true
	local immuneUntil = (model:GetAttribute("StealImmuneUntil") :: number?) or 0
	prompt.Enabled = open and os.time() >= immuneUntil and LocalPlayer:GetAttribute("Carrying") ~= true
end

local function trackBrainrot(model: Model)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local rainbow: { BasePart }? = nil
	if model:GetAttribute("Rainbow") then
		local list = {}
		for _, child in model:GetDescendants() do
			if child:IsA("BasePart") and child ~= root and not child:GetAttribute("KeepColor") then
				table.insert(list, child)
			end
		end
		rainbow = list
	end
	brainrots[model] = { Model = model, Root = root, Base = root.CFrame, Phase = math.random() * 10, Rainbow = rainbow }
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(Workspace) then
			brainrots[model] = nil
			stealPrompts[model] = nil
		end
	end)
	if model:GetAttribute("OwnerId") ~= LocalPlayer.UserId then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "StealPrompt"
		prompt.ActionText = "STEAL"
		prompt.ObjectText = model.Name
		prompt.HoldDuration = GameConfig.StealHoldDuration
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Enabled = false
		prompt.Parent = root
		prompt.Triggered:Connect(function()
			Net.Event("Steal"):FireServer(model:GetAttribute("PlotIndex"), model:GetAttribute("Slot"))
		end)
		stealPrompts[model] = prompt
		updateStealPrompt(model)
	end
end

local function watchBase(folder: Instance, base: Instance)
	local crystal = base:WaitForChild("Crystal", 10)
	local core = crystal and crystal:WaitForChild("Core", 10) :: BasePart?
	if core then
		crystals[base] = { Core = core, Base = core.CFrame, Phase = math.random() * 10 }
		setupStatsBillboard(folder, core)
	end
	if isMine(folder) then
		setupOwnerPrompts(base)
	end
	local function onChild(child: Instance)
		if child:IsA("Model") and child:GetAttribute("Uid") ~= nil then
			trackBrainrot(child)
		end
	end
	for _, child in base:GetChildren() do
		onChild(child)
	end
	base.ChildAdded:Connect(onChild)
	base.AncestryChanged:Connect(function()
		if not base:IsDescendantOf(Workspace) then
			crystals[base] = nil
		end
	end)
end

local function watchPlot(folder: Instance)
	folder.ChildAdded:Connect(function(child)
		if child.Name == "Base" then
			task.defer(watchBase, folder, child)
		end
	end)
	local existing = folder:FindFirstChild("Base")
	if existing then
		task.spawn(watchBase, folder, existing)
	end
	folder:GetAttributeChangedSignal("DoorOpen"):Connect(function()
		for model in stealPrompts do
			if model:GetAttribute("PlotIndex") == folder:GetAttribute("PlotIndex") then
				updateStealPrompt(model)
			end
		end
	end)
end

local function update()
	local t = os.clock()
	for _, entry in crystals do
		entry.Core.CFrame = entry.Base
			* CFrame.new(0, math.sin(t * 1.5 + entry.Phase) * 0.6, 0)
			* CFrame.Angles(0, t * 0.7 + entry.Phase, 0)
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cameraPos = camera.CFrame.Position
	local animated = 0
	for _, entry in brainrots do
		if animated > 90 then
			break
		end
		if (entry.Base.Position - cameraPos).Magnitude < 110 then
			animated += 1
			local phase = t * 2.2 + entry.Phase
			entry.Root.CFrame = entry.Base
				* CFrame.new(0, math.abs(math.sin(phase)) * 0.3, 0)
				* CFrame.Angles(0, math.sin(phase * 0.5) * 0.12, math.sin(phase) * 0.04)
			local rainbow = entry.Rainbow
			if rainbow then
				for i, part in rainbow do
					part.Color = Color3.fromHSV((t * 0.25 + i * 0.07) % 1, 0.75, 1)
				end
			end
		end
	end
end

function WorldController.Start()
	local plots = Workspace:WaitForChild("Plots")
	for _, folder in plots:GetChildren() do
		watchPlot(folder)
	end
	plots.ChildAdded:Connect(watchPlot)
	LocalPlayer:GetAttributeChangedSignal("Plot"):Connect(function()
		local index = myPlot()
		local folder = index and plots:FindFirstChild("Plot" .. index)
		local base = folder and folder:FindFirstChild("Base")
		if base then
			setupOwnerPrompts(base)
		end
	end)
	LocalPlayer:GetAttributeChangedSignal("Carrying"):Connect(function()
		for model in stealPrompts do
			updateStealPrompt(model)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			for model in stealPrompts do
				updateStealPrompt(model)
			end
		end
	end)
	RunService.RenderStepped:Connect(update)
end

return WorldController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="52">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">BrainrotsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Inventory: every owned brainrot, placed or in storage, with Place / Store / Sell and Place Best.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Brainrots = require(Shared.Config.Brainrots)
local Economy = require(Shared.Config.Economy)
local Rarities = require(Shared.Config.Rarities)
local BrainrotBuilder = require(Shared.Modules.BrainrotBuilder)
local BrainrotStats = require(Shared.Modules.BrainrotStats)
local Format = require(Shared.Modules.Format)
local Net = require(Shared.Modules.Net)
local Kit = require(script.Parent.Kit)
local Panels = require(script.Parent.Panels)

local BrainrotsPanel = {}

function BrainrotsPanel.Register(toast: (string, string?) -> ())
	Panels.Register("Brainrots", "🎒 Your Brainrots", Vector2.new(780, 480), function(content)
		local header = Kit.new("Frame", {
			Size = UDim2.new(1, 0, 0, 50),
			BackgroundTransparency = 1,
			Parent = content,
		})
		local summary = Kit.label({
			Text = "",
			Size = UDim2.new(0.6, 0, 1, -8),
			Position = UDim2.fromOffset(4, 4),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 22,
			Parent = header,
		})
		Kit.button({
			Text = "⭐ Place Best",
			Color = Kit.Colors.Yellow,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -4, 0, 0),
			Size = UDim2.fromOffset(200, 46),
			TextSize = 24,
			Parent = header,
			OnClick = function()
				local ok, message = Net.Function("Inventory"):InvokeServer("PlaceBest")
				toast(message, if ok then "good" else "warn")
			end,
		})

		local scroll = Kit.new("ScrollingFrame", {
			Position = UDim2.fromOffset(0, 56),
			Size = UDim2.new(1, 0, 1, -56),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 8,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Parent = content,
		})
		Kit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(176, 200),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = scroll,
		})
		Kit.padding(4).Parent = scroll

		local signature = ""

		local function act(action: string, uid: string)
			local ok, message = Net.Function("Inventory"):InvokeServer(action, uid)
			toast(message, if ok then "good" else "warn")
		end

		local function refresh(state: { [string]: any })
			local list = state.Brainrots or {}
			table.sort(list, function(a, b)
				if (a.Slot ~= nil) ~= (b.Slot ~= nil) then
					return a.Slot ~= nil
				end
				return a.Income > b.Income
			end)
			local placed = 0
			for _, item in list do
				if item.Slot then
					placed += 1
				end
			end
			summary.Text = string.format(
				"On pedestals: %d/%d · Storage: %d/%d",
				placed,
				state.SlotsUnlocked or Economy.Slots(state.Tier),
				#list - placed,
				state.StorageMax or 50
			)
			local parts = {}
			for _, item in list do
				table.insert(parts, item.Uid .. ":" .. tostring(item.Slot))
			end
			local newSignature = table.concat(parts, ",")
			if newSignature == signature then
				return
			end
			signature = newSignature
			for _, child in scroll:GetChildren() do
				if child:IsA("Frame") then
					child:Destroy()
				end
			end
			local mult = state.CashMultiplier or 1
			for order, item in list do
				local def = Brainrots.Get(item.Id)
				local rarity = Rarities.Get(if def then def.Rarity else 1)
				local card = Kit.panelFrame({
					LayoutOrder = order,
					BackgroundColor3 = Kit.darken(rarity.Color, 0.6),
					Parent = scroll,
				})
				local preview = Kit.new("Frame", {
					Size = UDim2.new(1, -12, 0, 78),
					Position = UDim2.fromOffset(6, 6),
					BackgroundTransparency = 1,
					Parent = card,
				})
				task.spawn(function()
					local model = BrainrotBuilder.Build(item.Id, { Mutation = item.Mutation, Effects = false })
					Kit.viewport(model, UDim2.fromScale(1, 1)).Parent = preview
				end)
				Kit.label({
					Text = BrainrotStats.DisplayName(item.Id, item.Mutation, item.Size),
					Size = UDim2.new(1, -10, 0, 36),
					Position = UDim2.fromOffset(5, 86),
					TextColor3 = rarity.Color,
					TextWrapped = true,
					MaxTextSize = 18,
					Parent = card,
				})
				Kit.label({
					Text = Format.Cash(item.Income * mult) .. "/s",
					Size = UDim2.new(1, -10, 0, 20),
					Position = UDim2.fromOffset(5, 122),
					TextColor3 = Kit.Colors.Cash,
					MaxTextSize = 18,
					Parent = card,
				})
				local buttons = Kit.new("Frame", {
					Size = UDim2.new(1, -10, 0, 44),
					Position = UDim2.new(0, 5, 1, -50),
					BackgroundTransparency = 1,
					Parent = card,
				})
				Kit.list(Enum.FillDirection.Horizontal, 6).Parent = buttons
				local uid: string = item.Uid
				if item.Slot then
					Kit.button({
						Text = "📦",
						Color = Kit.Colors.Blue,
						Size = UDim2.new(0.5, -3, 1, 0),
						LayoutOrder = 1,
						TextSize = 22,
						Parent = buttons,
						OnClick = function()
							act("Store", uid)
						end,
					})
				else
					Kit.button({
						Text = "Place",
						Color = Kit.Colors.Green,
						Size = UDim2.new(0.5, -3, 1, 0),
						LayoutOrder = 1,
						TextSize = 20,
						Parent = buttons,
						OnClick = function()
							act("Place", uid)
						end,
					})
				end
				local sellText = "💰" .. Format.Short(Economy.SellValue(item.Income * mult))
				local armed = false
				local sellButton: TextButton
				sellButton = Kit.button({
					Text = sellText,
					Color = Kit.Colors.Orange,
					Size = UDim2.new(0.5, -3, 1, 0),
					LayoutOrder = 2,
					TextSize = 18,
					Parent = buttons,
					OnClick = function()
						-- Rare brainrots need a second tap so nobody sells a Legendary by accident.
						if rarity.Index >= 4 and not armed then
							armed = true
							sellButton.Text = "Sure?"
							task.delay(2.5, function()
								armed = false
								if sellButton.Parent then
									sellButton.Text = sellText
								end
							end)
							return
						end
						act("Sell", uid)
					end,
				})
			end
		end

		return {
			Refresh = refresh,
			OnOpen = function()
				signature = ""
			end,
		}
	end)
end

return BrainrotsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Always-on HUD: cash, wave timer, incoming brainrot card + CHARGE button, boosts, menu, door alarm, toasts and
-- server announcements. Layout is mobile-first: big touch targets, nothing under the thumbstick or jump button.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Brainrots = require(Shared.Config.Brainrots)
local GameConfig = require(Shared.Config.GameConfig)
local Rarities = require(Shared.Config.Rarities)
local BrainrotBuilder = require(Shared.Modules.BrainrotBuilder)
local Format = require(Shared.Modules.Format)
local Signal = require(Shared.Modules.Signal)
local Kit = require(script.Parent.Kit)

local LocalPlayer = Players.LocalPlayer

local Hud = {}

Hud.MenuClicked = Signal.new() :: Signal.Signal<string>
Hud.ChargePressed = Signal.new() :: Signal.Signal<()>
Hud.BoostPressed = Signal.new() :: Signal.Signal<string>
Hud.RepairOfferPressed = Signal.new() :: Signal.Signal<()>

local screen: ScreenGui
local scaled: { UIScale } = {}

-- Elements
local cashLabel: TextLabel
local incomeLabel: TextLabel
local waveTitle: TextLabel
local waveTimer: TextLabel
local wavePill: Frame
local eventBanner: Frame
local eventLabel: TextLabel
local incomingCard: Frame
local incomingName: TextLabel
local incomingTags: TextLabel
local incomingPower: TextLabel
local incomingCrystal: TextLabel
local incomingBarFill: Frame
local incomingHint: TextLabel
local incomingViewport: Frame
local chargeButton: TextButton
local chargeRing: Frame
local chargeLabel: TextLabel
local boostBar: Frame
local boostButtons: { [string]: TextButton } = {}
local doorAlert: Frame
local doorAlertLabel: TextLabel
local toastHolder: Frame
local announceLabel: TextLabel
local menuButtons: { [string]: TextButton } = {}
local giftButton: TextButton

local state: { [string]: any }? = nil
local incoming: { { [string]: any } } = {}
local predictedCharge = 0
local lastTap = 0
local announceToken = 0

local function addScale(gui: GuiObject): UIScale
	local s = Kit.new("UIScale", { Parent = gui })
	table.insert(scaled, s)
	return s
end

function Hud.SetScale(value: number)
	for _, s in scaled do
		s.Scale = value
	end
end

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function pill(props: Kit.Props): Frame
	local frame = Kit.panelFrame(props)
	Kit.gradient(Kit.Colors.PanelLight, Kit.Colors.Panel).Parent = frame
	return frame
end

local function buildTop()
	local cashPill = pill({
		Name = "Cash",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(270, 70),
		Parent = screen,
	})
	addScale(cashPill)
	cashLabel = Kit.label({
		Name = "Amount",
		Text = "$0",
		Size = UDim2.new(1, -16, 0, 44),
		Position = UDim2.fromOffset(8, 2),
		TextColor3 = Kit.Colors.Cash,
		MaxTextSize = 42,
		Parent = cashPill,
	})
	incomeLabel = Kit.label({
		Name = "Income",
		Text = "+$0/s",
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.fromOffset(8, 46),
		TextColor3 = Kit.Colors.Muted,
		MaxTextSize = 20,
		Parent = cashPill,
	})

	wavePill = pill({
		Name = "Wave",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 6),
		Size = UDim2.fromOffset(210, 70),
		Parent = screen,
	})
	addScale(wavePill)
	waveTitle = Kit.label({
		Text = "🌊 NEXT WAVE",
		Size = UDim2.new(1, -12, 0, 24),
		Position = UDim2.fromOffset(6, 6),
		TextColor3 = Kit.Colors.Blue,
		MaxTextSize = 24,
		Parent = wavePill,
	})
	waveTimer = Kit.label({
		Text = "0:50",
		Size = UDim2.new(1, -12, 0, 34),
		Position = UDim2.fromOffset(6, 30),
		MaxTextSize = 34,
		Parent = wavePill,
	})

	eventBanner = pill({
		Name = "Event",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 82),
		Size = UDim2.fromOffset(360, 40),
		Visible = false,
		Parent = screen,
	})
	addScale(eventBanner)
	eventLabel = Kit.label({
		Text = "",
		Size = UDim2.new(1, -12, 1, -6),
		Position = UDim2.fromOffset(6, 3),
		TextColor3 = Kit.Colors.Yellow,
		MaxTextSize = 26,
		Parent = eventBanner,
	})
end

local MENU = {
	{ Name = "Upgrade", Icon = "⬆️", Color = Kit.Colors.Green },
	{ Name = "Shop", Icon = "🛒", Color = Kit.Colors.Yellow },
	{ Name = "Brainrots", Icon = "🎒", Color = Kit.Colors.Blue },
	{ Name = "Index", Icon = "📖", Color = Kit.Colors.Purple },
	{ Name = "Daily", Icon = "📅", Color = Kit.Colors.Pink },
	{ Name = "Codes", Icon = "🎟️", Color = Kit.Colors.Orange },
	{ Name = "Settings", Icon = "⚙️", Color = Kit.Colors.Grey },
}

local function buildMenu()
	local menu = Kit.new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.42, 0),
		Size = UDim2.fromOffset(150, 420),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	addScale(menu)
	local grid = Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(68, 68),
		CellPadding = UDim2.fromOffset(8, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = menu,
	})
	grid.FillDirectionMaxCells = 2
	for i, item in MENU do
		local button = Kit.button({
			Name = item.Name,
			Text = item.Icon,
			Color = item.Color,
			LayoutOrder = i,
			TextSize = 34,
			Parent = menu,
			OnClick = function()
				Hud.MenuClicked:Fire(item.Name)
			end,
		})
		Kit.label({
			Name = "Caption",
			Text = item.Name,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, 6),
			Size = UDim2.new(1, 6, 0, 18),
			MaxTextSize = 16,
			Parent = button,
		})
		local badge = Kit.new("Frame", {
			Name = "Badge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(22, 22),
			BackgroundColor3 = Kit.Colors.Red,
			Visible = false,
			Parent = button,
		}, { Kit.corner(11), Kit.stroke(2) })
		Kit.label({ Text = "!", Size = UDim2.fromScale(1, 1), MaxTextSize = 18, Parent = badge })
		menuButtons[item.Name] = button
	end

	giftButton = Kit.button({
		Name = "Gift",
		Text = "🎁 Gift in 0:00",
		Color = Kit.Colors.Pink,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0, 8, 0, 58),
		Size = UDim2.fromOffset(170, 44),
		TextSize = 22,
		Parent = screen,
		OnClick = function()
			Hud.MenuClicked:Fire("Gifts")
		end,
	})
	addScale(giftButton)
end

function Hud.SetBadge(name: string, visible: boolean)
	local button = menuButtons[name]
	local badge = button and button:FindFirstChild("Badge") :: Frame?
	if badge then
		badge.Visible = visible
	end
end

function Hud.SetGiftText(text: string, ready: boolean)
	giftButton.Text = text
	Kit.setButtonColor(giftButton, if ready then Kit.Colors.Green else Kit.Colors.Pink)
end

local function buildIncoming()
	incomingCard = pill({
		Name = "Incoming",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 84),
		Size = UDim2.fromOffset(300, 176),
		Visible = false,
		Parent = screen,
	})
	addScale(incomingCard)
	incomingViewport = Kit.new("Frame", {
		Name = "Preview",
		Size = UDim2.fromOffset(96, 96),
		Position = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Color3.fromRGB(20, 18, 40),
		Parent = incomingCard,
	}, { Kit.corner(12) })
	incomingTags = Kit.label({
		Text = "",
		Size = UDim2.new(1, -112, 0, 20),
		Position = UDim2.fromOffset(106, 8),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		Parent = incomingCard,
	})
	incomingName = Kit.label({
		Text = "",
		Size = UDim2.new(1, -112, 0, 30),
		Position = UDim2.fromOffset(106, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 26,
		Parent = incomingCard,
	})
	incomingPower = Kit.label({
		Text = "⚡ 0",
		Size = UDim2.new(0.5, -60, 0, 26),
		Position = UDim2.fromOffset(106, 62),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Kit.Colors.Yellow,
		MaxTextSize = 24,
		Parent = incomingCard,
	})
	incomingCrystal = Kit.label({
		Text = "💎 0",
		AnchorPoint = Vector2.new(1, 0),
		Size = UDim2.new(0.5, -50, 0, 26),
		Position = UDim2.new(1, -8, 0, 62),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Kit.Colors.Blue,
		MaxTextSize = 24,
		Parent = incomingCard,
	})
	local bar = Kit.new("Frame", {
		Name = "Bar",
		Size = UDim2.new(1, -16, 0, 24),
		Position = UDim2.fromOffset(8, 108),
		BackgroundColor3 = Color3.fromRGB(20, 18, 40),
		Parent = incomingCard,
	}, { Kit.corner(12), Kit.stroke(2) })
	incomingBarFill = Kit.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0.5, 1),
		BackgroundColor3 = Kit.Colors.Green,
		Parent = bar,
	}, { Kit.corner(12) })
	Kit.new("Frame", {
		Name = "Marker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 4, 1, 8),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = bar,
	})
	incomingHint = Kit.label({
		Text = "TAP CHARGE!",
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.fromOffset(8, 138),
		TextColor3 = Kit.Colors.Yellow,
		MaxTextSize = 26,
		Parent = incomingCard,
	})
end

local function buildCharge()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	chargeButton = Kit.new("TextButton", {
		Name = "Charge",
		AnchorPoint = Vector2.new(1, 1),
		Position = if touch then UDim2.new(1, -24, 1, -170) else UDim2.new(1, -30, 1, -30),
		Size = UDim2.fromOffset(150, 150),
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		Parent = screen,
	}, {
		Kit.corner(75),
		Kit.stroke(5),
		Kit.gradient(Color3.fromRGB(120, 230, 255), Color3.fromRGB(40, 110, 230)),
	})
	addScale(chargeButton)
	Kit.bouncy(chargeButton)
	chargeRing = Kit.new("Frame", {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1.12, 1.12),
		BackgroundTransparency = 1,
		Parent = chargeButton,
	}, { Kit.corner(90), Kit.stroke(6, Kit.Colors.Yellow) })
	chargeLabel = Kit.label({
		Text = "⚡\nCHARGE",
		Size = UDim2.fromScale(0.85, 0.7),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		MaxTextSize = 32,
		Parent = chargeButton,
	})
	local keyHint = Kit.label({
		Name = "KeyHint",
		Text = if UserInputService.GamepadEnabled then "[R2]" else "[F]",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 4),
		Size = UDim2.fromOffset(80, 22),
		MaxTextSize = 20,
		TextColor3 = Kit.Colors.Muted,
		Visible = not touch,
		Parent = chargeButton,
	})
	keyHint.Visible = not touch
	chargeButton.Activated:Connect(function()
		Hud.ChargePressed:Fire()
	end)

	boostBar = Kit.new("Frame", {
		Name = "Boosts",
		AnchorPoint = Vector2.new(1, 1),
		Position = if touch then UDim2.new(1, -190, 1, -170) else UDim2.new(1, -196, 1, -30),
		Size = UDim2.fromOffset(240, 70),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	addScale(boostBar)
	Kit.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom).Parent =
		boostBar
	for i, boost in
		{
			{ Name = "Overcharge", Icon = "⚡+", Color = Kit.Colors.Blue },
			{ Name = "IronDoor", Icon = "🛡️", Color = Kit.Colors.Grey },
			{ Name = "LuckyWave", Icon = "🍀", Color = Kit.Colors.Green },
		}
	do
		local button = Kit.button({
			Name = boost.Name,
			Text = boost.Icon,
			Color = boost.Color,
			Size = UDim2.fromOffset(66, 66),
			LayoutOrder = i,
			TextSize = 30,
			Parent = boostBar,
			OnClick = function()
				Hud.BoostPressed:Fire(boost.Name)
			end,
		})
		local count = Kit.new("Frame", {
			Name = "Count",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 6, 0, -6),
			Size = UDim2.fromOffset(28, 24),
			BackgroundColor3 = Kit.Colors.Red,
			Parent = button,
		}, { Kit.corner(10), Kit.stroke(2) })
		Kit.label({ Name = "Text", Text = "0", Size = UDim2.fromScale(1, 1), MaxTextSize = 18, Parent = count })
		boostButtons[boost.Name] = button
	end
end

local function buildAlerts()
	doorAlert = Kit.panelFrame({
		Name = "DoorAlert",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 128),
		Size = UDim2.fromOffset(440, 96),
		BackgroundColor3 = Color3.fromRGB(150, 25, 35),
		Visible = false,
		Parent = screen,
	})
	addScale(doorAlert)
	doorAlertLabel = Kit.label({
		Text = "🚨 DOOR BROKEN 0:40",
		Size = UDim2.new(1, -16, 0, 34),
		Position = UDim2.fromOffset(8, 6),
		MaxTextSize = 32,
		Parent = doorAlert,
	})
	Kit.label({
		Text = "Go to your door and hold REPAIR!",
		Size = UDim2.new(0.6, -12, 0, 40),
		Position = UDim2.fromOffset(8, 46),
		TextColor3 = Color3.fromRGB(255, 220, 220),
		MaxTextSize = 20,
		Parent = doorAlert,
	})
	Kit.button({
		Name = "InstantRepair",
		Text = "🔧 Fix Now",
		Color = Kit.Colors.Green,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 44),
		Size = UDim2.new(0.4, -8, 0, 44),
		TextSize = 22,
		Parent = doorAlert,
		OnClick = function()
			Hud.RepairOfferPressed:Fire()
		end,
	})

	toastHolder = Kit.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(520, 240),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	addScale(toastHolder)
	Kit.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom).Parent =
		toastHolder

	announceLabel = Kit.label({
		Name = "Announce",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.3, 0),
		Size = UDim2.new(0.8, 0, 0, 52),
		MaxTextSize = 44,
		TextTransparency = 1,
		Parent = screen,
	})
	addScale(announceLabel)
end

function Hud.Create(gui: ScreenGui)
	screen = gui
	buildTop()
	buildMenu()
	buildIncoming()
	buildCharge()
	buildAlerts()
end

local TOAST_COLORS: { [string]: Color3 } = {
	info = Kit.Colors.Blue,
	good = Kit.Colors.Green,
	bad = Kit.Colors.Red,
	warn = Kit.Colors.Orange,
	new = Kit.Colors.Pink,
	shield = Color3.fromRGB(60, 210, 230),
	reward = Kit.Colors.Yellow,
}

function Hud.Toast(text: string, kind: string?)
	local color = TOAST_COLORS[kind or "info"] or Kit.Colors.Blue
	local toast = Kit.panelFrame({
		Size = UDim2.fromOffset(500, 44),
		BackgroundColor3 = Kit.darken(color, 0.35),
		LayoutOrder = math.floor(os.clock() * 100),
		Parent = toastHolder,
	})
	Kit.label({
		Text = text,
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		MaxTextSize = 22,
		Parent = toast,
	})
	Kit.popIn(toast)
	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
	task.delay(4, function()
		if toast.Parent then
			Kit.tween(toast, 0.3, { BackgroundTransparency = 1 })
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

function Hud.Announce(text: string, color: Color3?)
	announceToken += 1
	local token = announceToken
	announceLabel.Text = text
	announceLabel.TextColor3 = color or Kit.Colors.Yellow
	announceLabel.TextTransparency = 0
	local stroke = announceLabel:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 0
	end
	Kit.popIn(announceLabel)
	task.delay(3.5, function()
		if token == announceToken then
			Kit.tween(announceLabel, 0.5, { TextTransparency = 1 })
			if stroke then
				Kit.tween(stroke, 0.5, { Transparency = 1 })
			end
		end
	end)
end

function Hud.ScreenGui(): ScreenGui
	return screen
end

function Hud.ChargeButton(): GuiButton
	return chargeButton
end

function Hud.MenuButton(name: string): GuiButton?
	return menuButtons[name]
end

function Hud.BoostButton(name: string): GuiButton?
	return boostButtons[name]
end

local function setIncomingPreview(data: { [string]: any })
	for _, child in incomingViewport:GetChildren() do
		if child:IsA("ViewportFrame") then
			child:Destroy()
		end
	end
	local model = BrainrotBuilder.Build(data.BrainrotId, { Mutation = data.Mutation, Effects = false })
	local viewport = Kit.viewport(model, UDim2.fromScale(1, 1))
	viewport.Parent = incomingViewport
end

function Hud.AddIncoming(data: { [string]: any })
	table.insert(incoming, data)
	table.sort(incoming, function(a, b)
		return a.Resolve < b.Resolve
	end)
	if #incoming == 1 then
		predictedCharge = 0
	end
	local first = incoming[1]
	if first == data then
		setIncomingPreview(data)
	end
end

function Hud.ResolveIncoming(result: { [string]: any })
	for i, data in incoming do
		if data.Id == result.Id then
			table.remove(incoming, i)
			break
		end
	end
	if #incoming == 0 then
		predictedCharge = 0
	else
		setIncomingPreview(incoming[1])
	end
end

-- Local prediction so the bar reacts instantly; the server applies the same rule authoritatively.
function Hud.TryCharge(): boolean
	local first = incoming[1]
	local t = now()
	if not first or t < first.Start or t > first.Resolve - 0.1 then
		return false
	end
	local clock = os.clock()
	if clock - lastTap < GameConfig.ChargeMinTapInterval then
		return false
	end
	lastTap = clock
	predictedCharge = math.min(GameConfig.ChargeMax, predictedCharge + GameConfig.ChargePerTap)
	Kit.tween(chargeRing, 0.05, { Size = UDim2.fromScale(1.25, 1.25) })
	task.delay(0.06, function()
		Kit.tween(chargeRing, 0.15, { Size = UDim2.fromScale(1.12, 1.12) })
	end)
	return true
end

function Hud.HasIncoming(): boolean
	return #incoming > 0
end

function Hud.SetState(newState: { [string]: any })
	state = newState
	cashLabel.Text = Format.Cash(newState.Cash)
	incomeLabel.Text = "+" .. Format.Cash(newState.Income or 0) .. "/s"
	for name, button in boostButtons do
		local count = (newState.Boosts and newState.Boosts[name]) or 0
		local countFrame = button:FindFirstChild("Count")
		local text = countFrame and countFrame:FindFirstChild("Text") :: TextLabel?
		if text then
			text.Text = if count > 0 then tostring(count) else "+"
		end
		if countFrame and countFrame:IsA("Frame") then
			countFrame.BackgroundColor3 = if count > 0 then Kit.Colors.Red else Kit.Colors.Green
		end
	end
	local over = boostButtons.Overcharge
	if over then
		local stroke = over:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if newState.Overcharge then Kit.Colors.Yellow else Kit.Colors.Stroke
			stroke.Thickness = if newState.Overcharge then 5 else 3
		end
	end
end

local function updateIncoming()
	local first = incoming[1]
	local current = state
	if not first or not current then
		incomingCard.Visible = false
		chargeLabel.Text = "⚡\nCHARGE"
		chargeButton.Visible = false
		return
	end
	chargeButton.Visible = true
	incomingCard.Visible = true
	local def = Brainrots.Get(first.BrainrotId)
	local rarity = Rarities.Get(if def then def.Rarity else 1)
	local tags = { string.upper(rarity.Name) }
	if first.Size ~= "Normal" then
		table.insert(tags, 1, string.upper(first.Size))
	end
	if first.Mutation ~= "None" then
		table.insert(tags, 1, string.upper(first.Mutation))
	end
	if first.Boss then
		table.insert(tags, 1, "👑 BOSS")
	end
	incomingTags.Text = table.concat(tags, " · ")
	incomingTags.TextColor3 = rarity.Color
	incomingName.Text = if def then def.Name else "???"
	local over = if current.Overcharge then 0.5 else 0
	local crystal = (current.CrystalPower or 0) * (1 + predictedCharge + over)
	local power = first.Power
	incomingPower.Text = "⚡ " .. Format.Short(power)
	incomingCrystal.Text = "💎 " .. Format.Short(crystal)
	local ratio = crystal / math.max(power, 1)
	incomingBarFill.Size = UDim2.fromScale(math.clamp(ratio / 2, 0.02, 1), 1)
	local winning = first.Guaranteed or ratio >= 1
	incomingBarFill.BackgroundColor3 = if winning
		then Kit.Colors.Green
		else (if ratio > 0.75 then Kit.Colors.Orange else Kit.Colors.Red)
	local t = now()
	local pulse = 0.5 + 0.5 * math.sin(os.clock() * 10)
	if first.Guaranteed then
		incomingHint.Text = "✨ GUARANTEED BEAM ✨"
		incomingHint.TextColor3 = Kit.Colors.Green
	elseif winning then
		incomingHint.Text = "YOU'LL BEAM IT! ✅"
		incomingHint.TextColor3 = Kit.Colors.Green
	elseif predictedCharge >= GameConfig.ChargeMax - 0.001 then
		incomingHint.Text = if current.Overcharge then "TOO STRONG! 😱" else "USE OVERCHARGE ⚡+"
		incomingHint.TextColor3 = Kit.Colors.Red
	else
		incomingHint.Text = "TAP CHARGE FAST!"
		incomingHint.TextColor3 = Kit.Colors.Yellow:Lerp(Kit.Colors.Red, pulse)
	end
	local active = t >= first.Start and t <= first.Resolve - 0.1
	chargeLabel.Text = if active
		then string.format("⚡\n+%d%%", math.floor(predictedCharge * 100 + 0.5))
		else "⚡\nGET READY"
	chargeRing.Rotation = (os.clock() * 120) % 360
	local overButton = boostButtons.Overcharge
	if overButton then
		local scale = overButton:FindFirstChildOfClass("UIScale")
		if scale and not winning and not current.Overcharge then
			scale.Scale = 1 + 0.08 * pulse
		elseif scale then
			scale.Scale = 1
		end
	end
end

local function updateWave(info: { [string]: any })
	local t = now()
	if #incoming > 0 then
		waveTitle.Text = "🚨 INCOMING!"
		waveTitle.TextColor3 = Kit.Colors.Red
		local first = incoming[1]
		waveTimer.Text = if t < first.Arrive then "Arrives " .. Format.Clock(first.Arrive - t) else "BEAMING!"
		return
	end
	local stampede = info.StampedeNextWave
	waveTitle.Text = if stampede then "🐘 STAMPEDE IN" else "🌊 NEXT WAVE"
	waveTitle.TextColor3 = if stampede then Kit.Colors.Orange else Kit.Colors.Blue
	local remaining = (info.NextWaveAt or 0) - t
	waveTimer.Text = Format.Clock(math.max(0, remaining))
end

local function updateEvent(info: { [string]: any })
	local t = now()
	local text = ""
	if info.ActiveEvent and info.ActiveEvent ~= "" and (info.EventEndsAt or 0) > t then
		local names: { [string]: string } = {
			GoldenHour = "✨ GOLDEN HOUR",
			RainbowRain = "🌈 RAINBOW RAIN",
			CashRush = "💸 2X CASH RUSH",
			LuckyHour = "🍀 LUCKY HOUR",
		}
		text = (names[info.ActiveEvent] or info.ActiveEvent) .. " · " .. Format.Clock(info.EventEndsAt - t)
	elseif (info.ServerLuckUntil or 0) > os.time() then
		text = string.format(
			"🍀 SERVER LUCK x2 by %s · %s",
			info.ServerLuckBy or "?",
			Format.Clock(info.ServerLuckUntil - os.time())
		)
	elseif info.WeekendBoost then
		text = "🎉 WEEKEND 2X CASH!"
	end
	eventBanner.Visible = text ~= ""
	eventLabel.Text = text
end

local function updateDoor()
	local plotIndex = LocalPlayer:GetAttribute("Plot")
	local plots = Workspace:FindFirstChild("Plots")
	local folder = plots and type(plotIndex) == "number" and plots:FindFirstChild("Plot" .. plotIndex)
	if not folder then
		doorAlert.Visible = false
		return
	end
	local brokenUntil = (folder:GetAttribute("DoorBrokenUntil") :: number?) or 0
	local remaining = brokenUntil - now()
	if remaining > 0 then
		doorAlert.Visible = true
		local shielded = folder:GetAttribute("Shielded") == true
		doorAlertLabel.Text =
			string.format("%s DOOR BROKEN %s", if shielded then "🛡️" else "🚨", Format.Clock(remaining))
		doorAlert.BackgroundColor3 = if shielded
			then Color3.fromRGB(30, 110, 140)
			else Color3.fromRGB(150 + 40 * math.sin(os.clock() * 8), 25, 35)
	else
		doorAlert.Visible = false
	end
end

function Hud.Update(info: { [string]: any })
	updateIncoming()
	updateWave(info)
	updateEvent(info)
	updateDoor()
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">IndexPanel</string>
              <string name="Source"><![CDATA[--!strict
-- The Index (collection book): every brainrot by rarity, discovered or "???", mutation stamps, the +cash bonus
-- and one-time rewards for completing a rarity.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Brainrots = require(Shared.Config.Brainrots)
local Economy = require(Shared.Config.Economy)
local Mutations = require(Shared.Config.Mutations)
local Rarities = require(Shared.Config.Rarities)
local Rewards = require(Shared.Config.Rewards)
local BrainrotBuilder = require(Shared.Modules.BrainrotBuilder)
local BrainrotStats = require(Shared.Modules.BrainrotStats)
local Net = require(Shared.Modules.Net)
local Kit = require(script.Parent.Kit)
local Panels = require(script.Parent.Panels)

local IndexPanel = {}

type Card = {
	Frame: Frame,
	Name: TextLabel,
	Preview: Frame,
	Stamps: { [string]: Frame },
	Shown: string, -- "none" | "silhouette" | "model"
}

local function silhouette(model: Model)
	for _, child in model:GetDescendants() do
		if child:IsA("BasePart") then
			child.Color = Color3.fromRGB(25, 22, 45)
			child.Material = Enum.Material.SmoothPlastic
			child.Reflectance = 0
		end
	end
end

function IndexPanel.Register(toast: (string, string?) -> ())
	Panels.Register("Index", "📖 Brainrot Index", Vector2.new(800, 490), function(content)
		local header = Kit.label({
			Text = "",
			Size = UDim2.new(1, 0, 0, 30),
			TextColor3 = Kit.Colors.Cash,
			MaxTextSize = 24,
			Parent = content,
		})
		local scroll = Kit.new("ScrollingFrame", {
			Position = UDim2.fromOffset(0, 36),
			Size = UDim2.new(1, 0, 1, -36),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 8,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			Parent = content,
		})
		Kit.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top).Parent =
			scroll

		local cards: { [string]: Card } = {}
		local sections: { [number]: { Progress: TextLabel, Claim: TextButton } } = {}

		for _, rarity in Rarities.List do
			local bucket = Brainrots.OfRarity(rarity.Index)
			local rows = math.ceil(#bucket / 6)
			local section = Kit.new("Frame", {
				Name = rarity.Name,
				LayoutOrder = rarity.Index,
				Size = UDim2.new(1, -12, 0, 52 + rows * 138),
				BackgroundTransparency = 1,
				Parent = scroll,
			})
			local bar = Kit.panelFrame({
				Size = UDim2.new(1, 0, 0, 44),
				BackgroundColor3 = Kit.darken(
					if rarity.Index == 8 then Color3.fromRGB(90, 90, 90) else rarity.Color,
					0.45
				),
				Parent = section,
			})
			Kit.label({
				Text = rarity.Name,
				Size = UDim2.new(0.3, 0, 1, -8),
				Position = UDim2.fromOffset(10, 4),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = if rarity.Index == 8 then Color3.new(1, 1, 1) else rarity.Color,
				MaxTextSize = 26,
				Parent = bar,
			})
			local progress = Kit.label({
				Text = "0/0",
				Size = UDim2.new(0.3, 0, 1, -10),
				Position = UDim2.new(0.3, 0, 0, 5),
				MaxTextSize = 22,
				Parent = bar,
			})
			local reward = Rewards.IndexSets[rarity.Index]
			local claim = Kit.button({
				Text = "🎁 " .. Rewards.Describe(reward),
				Color = Kit.Colors.Grey,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -6, 0.5, 0),
				Size = UDim2.new(0.4, -10, 1, -10),
				TextSize = 18,
				Parent = bar,
				OnClick = function()
					local ok, message = Net.Function("ClaimIndex"):InvokeServer(rarity.Index)
					toast(message, if ok then "reward" else "warn")
				end,
			})
			sections[rarity.Index] = { Progress = progress, Claim = claim }

			local grid = Kit.new("Frame", {
				Position = UDim2.fromOffset(0, 52),
				Size = UDim2.new(1, 0, 1, -52),
				BackgroundTransparency = 1,
				Parent = section,
			})
			Kit.new("UIGridLayout", {
				CellSize = UDim2.new(1 / 6, -8, 0, 128),
				CellPadding = UDim2.fromOffset(8, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
				Parent = grid,
			})
			for order, def in bucket do
				local card = Kit.panelFrame({
					LayoutOrder = order,
					BackgroundColor3 = Color3.fromRGB(40, 36, 76),
					Parent = grid,
				})
				local preview = Kit.new("Frame", {
					Size = UDim2.new(1, -8, 0, 76),
					Position = UDim2.fromOffset(4, 4),
					BackgroundTransparency = 1,
					Parent = card,
				})
				local name = Kit.label({
					Text = "???",
					Size = UDim2.new(1, -6, 0, 28),
					Position = UDim2.fromOffset(3, 80),
					TextWrapped = true,
					MaxTextSize = 15,
					Parent = card,
				})
				local stampRow = Kit.new("Frame", {
					Size = UDim2.new(1, -8, 0, 14),
					Position = UDim2.new(0, 4, 1, -18),
					BackgroundTransparency = 1,
					Parent = card,
				})
				Kit.list(Enum.FillDirection.Horizontal, 4).Parent = stampRow
				local stamps: { [string]: Frame } = {}
				for i, mutation in Mutations.List do
					if mutation.Name ~= "None" and mutation.Color then
						stamps[mutation.Name] = Kit.new("Frame", {
							LayoutOrder = i,
							Size = UDim2.fromOffset(14, 14),
							BackgroundColor3 = mutation.Color,
							BackgroundTransparency = 0.85,
							Parent = stampRow,
						}, { Kit.corner(7) })
					end
				end
				cards[def.Id] = { Frame = card, Name = name, Preview = preview, Stamps = stamps, Shown = "none" }
			end
		end

		local function setPreview(card: Card, id: string, discovered: boolean)
			local wanted = if discovered then "model" else "silhouette"
			if card.Shown == wanted then
				return
			end
			card.Shown = wanted
			for _, child in card.Preview:GetChildren() do
				child:Destroy()
			end
			local model = BrainrotBuilder.Build(id, { Effects = false })
			if not discovered then
				silhouette(model)
			end
			Kit.viewport(model, UDim2.fromScale(1, 1)).Parent = card.Preview
		end

		local function refresh(state: { [string]: any })
			local index = state.Index or {}
			local claimed = state.IndexClaimed or {}
			local discoveredCount = 0
			for _, def in Brainrots.List do
				local card = cards[def.Id]
				local discovered = index[BrainrotStats.IndexKey(def.Id, "None")] == true
				if discovered then
					discoveredCount += 1
				end
				card.Name.Text = if discovered then def.Name else "???"
				card.Name.TextColor3 = if discovered then Rarities.Get(def.Rarity).Color else Kit.Colors.Muted
				setPreview(card, def.Id, discovered)
				for mutationName, stamp in card.Stamps do
					stamp.BackgroundTransparency = if index[BrainrotStats.IndexKey(def.Id, mutationName)]
						then 0
						else 0.85
				end
			end
			header.Text = string.format(
				"Discovered %d / %d  ·  +%d%% cash from your Index",
				discoveredCount,
				#Brainrots.List,
				math.floor(discoveredCount * Economy.IndexBonusPerEntry * 100 + 0.5)
			)
			for rarityIndex, section in sections do
				local bucket = Brainrots.OfRarity(rarityIndex)
				local found = 0
				for _, def in bucket do
					if index[BrainrotStats.IndexKey(def.Id, "None")] then
						found += 1
					end
				end
				section.Progress.Text = string.format("%d / %d", found, #bucket)
				local isClaimed = claimed[tostring(rarityIndex)] == true
				if isClaimed then
					section.Claim.Text = "✅ Claimed"
					Kit.setButtonColor(section.Claim, Kit.Colors.Grey)
				else
					section.Claim.Text = "🎁 " .. Rewards.Describe(Rewards.IndexSets[rarityIndex])
					Kit.setButtonColor(section.Claim, if found >= #bucket then Kit.Colors.Green else Kit.Colors.Grey)
				end
			end
		end

		return { Refresh = refresh }
	end)
end

-- True when any completed rarity set is waiting to be claimed (drives the menu badge).
function IndexPanel.HasClaimable(state: { [string]: any }): boolean
	local index = state.Index or {}
	local claimed = state.IndexClaimed or {}
	for rarityIndex in Rewards.IndexSets do
		if not claimed[tostring(rarityIndex)] then
			local bucket = Brainrots.OfRarity(rarityIndex)
			local found = 0
			for _, def in bucket do
				if index[BrainrotStats.IndexKey(def.Id, "None")] then
					found += 1
				end
			end
			if #bucket > 0 and found >= #bucket then
				return true
			end
		end
	end
	return false
end

return IndexPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- Tiny declarative UI kit: consistent chunky, kid-friendly style that scales from phones to TVs.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Kit = {}

Kit.Font = Enum.Font.FredokaOne
Kit.Colors = {
	Panel = Color3.fromRGB(32, 30, 64),
	PanelLight = Color3.fromRGB(52, 48, 98),
	Stroke = Color3.fromRGB(14, 12, 30),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(190, 185, 230),
	Yellow = Color3.fromRGB(255, 205, 50),
	Green = Color3.fromRGB(70, 215, 110),
	Blue = Color3.fromRGB(60, 170, 255),
	Pink = Color3.fromRGB(255, 80, 200),
	Red = Color3.fromRGB(255, 80, 80),
	Orange = Color3.fromRGB(255, 150, 40),
	Purple = Color3.fromRGB(150, 90, 255),
	Grey = Color3.fromRGB(120, 120, 140),
	Cash = Color3.fromRGB(120, 255, 120),
}

export type Props = { [string]: any }

-- Creates an instance with properties and children. Children may be instances or arrays of instances.
function Kit.new(className: string, props: Props?, children: { any }?): any
	local instance = Instance.new(className)
	if props then
		for key, value in props do
			if key ~= "Parent" then
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			if typeof(child) == "Instance" then
				child.Parent = instance
			end
		end
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Kit.corner(radius: number?): any
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Kit.stroke(thickness: number?, color: Color3?): any
	return Kit.new("UIStroke", {
		Thickness = thickness or 3,
		Color = color or Kit.Colors.Stroke,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Kit.textStroke(thickness: number?): any
	return Kit.new("UIStroke", {
		Thickness = thickness or 2,
		Color = Kit.Colors.Stroke,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function Kit.padding(px: number): any
	return Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

function Kit.gradient(top: Color3, bottom: Color3): any
	return Kit.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = 90,
	})
end

function Kit.list(
	direction: Enum.FillDirection,
	spacing: number,
	hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?
): any
	return Kit.new("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, spacing),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Center,
	})
end

function Kit.label(props: Props): TextLabel
	local defaults: Props = {
		BackgroundTransparency = 1,
		Font = Kit.Font,
		TextColor3 = Kit.Colors.Text,
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 28),
	}
	for key, value in props do
		defaults[key] = value
	end
	local label = Kit.new("TextLabel", defaults)
	Kit.textStroke(2).Parent = label
	local constraint = Kit.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 40, MinTextSize = 8 })
	constraint.Parent = label
	return label
end

local function lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end
Kit.lighten = lighten

local function darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end
Kit.darken = darken

-- Press feedback: squish on press, pop back on release.
function Kit.bouncy(button: GuiButton)
	local scale = button:FindFirstChildOfClass("UIScale") or Kit.new("UIScale", { Parent = button })
	local function tweenTo(value: number, time: number)
		TweenService
			:Create(scale, TweenInfo.new(time, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = value })
			:Play()
	end
	button.MouseButton1Down:Connect(function()
		tweenTo(0.9, 0.08)
	end)
	button.MouseButton1Up:Connect(function()
		tweenTo(1, 0.2)
	end)
	button.MouseLeave:Connect(function()
		tweenTo(1, 0.2)
	end)
	button.MouseEnter:Connect(function()
		if not UserInputService.TouchEnabled then
			tweenTo(1.05, 0.12)
		end
	end)
end

export type ButtonOptions = {
	Text: string,
	Color: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	LayoutOrder: number?,
	TextSize: number?,
	Parent: Instance?,
	Name: string?,
	OnClick: (() -> ())?,
}

function Kit.button(options: ButtonOptions): TextButton
	local color = options.Color or Kit.Colors.Green
	local button = Kit.new("TextButton", {
		Name = options.Name or "Button",
		Size = options.Size or UDim2.fromOffset(160, 52),
		Position = options.Position or UDim2.new(),
		AnchorPoint = options.AnchorPoint or Vector2.zero,
		LayoutOrder = options.LayoutOrder or 0,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = options.Text,
		Font = Kit.Font,
		TextColor3 = Kit.Colors.Text,
		TextScaled = true,
		Selectable = true,
	}, {
		Kit.corner(14),
		Kit.stroke(3),
		Kit.gradient(lighten(color, 0.2), darken(color, 0.15)),
		Kit.new("UITextSizeConstraint", { MaxTextSize = options.TextSize or 30, MinTextSize = 8 }),
		Kit.new("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			PaddingTop = UDim.new(0, 4),
			PaddingBottom = UDim.new(0, 4),
		}),
	})
	Kit.textStroke(2).Parent = button
	Kit.bouncy(button)
	if options.OnClick then
		local callback = options.OnClick
		button.Activated:Connect(function()
			callback()
		end)
	end
	if options.Parent then
		button.Parent = options.Parent
	end
	return button
end

function Kit.setButtonColor(button: GuiObject, color: Color3)
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = ColorSequence.new(lighten(color, 0.2), darken(color, 0.15))
	end
end

function Kit.panelFrame(props: Props): Frame
	local defaults: Props = {
		BackgroundColor3 = Kit.Colors.Panel,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
	}
	for key, value in props do
		defaults[key] = value
	end
	local frame = Kit.new("Frame", defaults, {
		Kit.corner(16),
		Kit.stroke(3),
	})
	return frame
end

function Kit.tween(
	instance: Instance,
	time: number,
	goal: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goal
	)
	tween:Play()
	return tween
end

-- Pop-in animation for a GuiObject that has (or gets) a UIScale.
function Kit.popIn(gui: GuiObject)
	local scale = gui:FindFirstChildOfClass("UIScale") or Kit.new("UIScale", { Parent = gui })
	scale.Scale = 0.6
	Kit.tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- A ViewportFrame showing a 3D model, slowly turning.
function Kit.viewport(model: Model, size: UDim2, distanceScale: number?): ViewportFrame
	local viewport = Kit.new("ViewportFrame", {
		Size = size,
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 200, 210),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-1, -1.5, -1),
	})
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	model.Parent = viewport
	local _, extents = model:GetBoundingBox()
	local radius = extents.Magnitude / 2
	local height = (model:GetAttribute("Height") :: number?) or extents.Y
	local focus = model:GetPivot().Position + Vector3.new(0, height / 2, 0)
	local distance = radius / math.tan(math.rad(15)) * (distanceScale or 1.05)
	camera.CFrame = CFrame.lookAt(focus + Vector3.new(0, radius * 0.35, -distance), focus)
	return viewport
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!strict
-- Modal panel manager: one centred panel at a time with a dimmed backdrop, title bar and close button.

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Modules.Signal)
local Kit = require(script.Parent.Kit)

export type PanelApi = {
	Refresh: ((state: { [string]: any }) -> ())?,
	OnOpen: (() -> ())?,
	OnClose: (() -> ())?,
}

type Entry = {
	Name: string,
	Title: string,
	Root: Frame,
	Api: PanelApi,
	Size: Vector2,
}

local Panels = {}

Panels.Opened = Signal.new() :: Signal.Signal<string>
Panels.Closed = Signal.new() :: Signal.Signal<string>

local screen: ScreenGui
local backdrop: TextButton
local entries: { [string]: Entry } = {}
local current: Entry? = nil
local lastState: { [string]: any }? = nil
local scale = 1

function Panels.Init(gui: ScreenGui)
	screen = gui
	backdrop = Kit.new("TextButton", {
		Name = "Backdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 20,
		Selectable = false,
		Parent = screen,
	})
	backdrop.Activated:Connect(function()
		Panels.Close()
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.ButtonB then
			Panels.Close()
		end
	end)
end

function Panels.SetScale(value: number)
	scale = value
	for _, entry in entries do
		local uiScale = entry.Root:FindFirstChild("PanelScale") :: UIScale?
		if uiScale then
			uiScale.Scale = scale
		end
	end
end

-- Registers a panel. build(content) fills the content frame and returns callbacks.
function Panels.Register(
	name: string,
	title: string,
	size: Vector2,
	build: (content: Frame, close: () -> ()) -> PanelApi
)
	local root = Kit.panelFrame({
		Name = name .. "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(size.X, size.Y),
		Visible = false,
		ZIndex = 21,
		Parent = screen,
	})
	Kit.new("UIScale", { Name = "PanelScale", Scale = scale, Parent = root })
	Kit.gradient(Kit.Colors.PanelLight, Kit.Colors.Panel).Parent = root

	local titleBar = Kit.new("Frame", {
		Name = "TitleBar",
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = root,
	})
	Kit.label({
		Name = "Title",
		Text = title,
		Size = UDim2.new(1, -120, 1, -8),
		Position = UDim2.fromOffset(16, 6),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Kit.Colors.Yellow,
		MaxTextSize = 36,
		ZIndex = 23,
		Parent = titleBar,
	})
	local closeButton = Kit.button({
		Name = "Close",
		Text = "✕",
		Color = Kit.Colors.Red,
		Size = UDim2.fromOffset(48, 44),
		Position = UDim2.new(1, -56, 0, 6),
		Parent = titleBar,
		OnClick = function()
			Panels.Close()
		end,
	})
	closeButton.ZIndex = 23

	local content = Kit.new("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(12, 58),
		Size = UDim2.new(1, -24, 1, -70),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = root,
	})
	local api = build(content, function()
		Panels.Close()
	end)
	entries[name] = { Name = name, Title = title, Root = root, Api = api, Size = size }
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("GuiObject") and descendant.ZIndex < 22 then
			descendant.ZIndex = 22
		end
	end
	root.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("GuiObject") and descendant.ZIndex < 22 then
			descendant.ZIndex = 22
		end
	end)
end

function Panels.Open(name: string)
	local entry = entries[name]
	if not entry then
		return
	end
	if current and current ~= entry then
		current.Root.Visible = false
		if current.Api.OnClose then
			current.Api.OnClose()
		end
		Panels.Closed:Fire(current.Name)
	end
	current = entry
	backdrop.Visible = true
	entry.Root.Visible = true
	Kit.popIn(entry.Root)
	if entry.Api.OnOpen then
		entry.Api.OnOpen()
	end
	local state = lastState
	if state and entry.Api.Refresh then
		entry.Api.Refresh(state)
	end
	if UserInputService.GamepadEnabled then
		local close = entry.Root:FindFirstChild("Close", true)
		if close and close:IsA("GuiObject") then
			GuiService.SelectedObject = close
		end
	end
	Panels.Opened:Fire(name)
end

function Panels.Close()
	local entry = current
	if not entry then
		return
	end
	entry.Root.Visible = false
	backdrop.Visible = false
	current = nil
	if entry.Api.OnClose then
		entry.Api.OnClose()
	end
	GuiService.SelectedObject = nil
	Panels.Closed:Fire(entry.Name)
end

function Panels.Toggle(name: string)
	if current and current.Name == name then
		Panels.Close()
	else
		Panels.Open(name)
	end
end

function Panels.IsOpen(name: string?): boolean
	if name == nil then
		return current ~= nil
	end
	return current ~= nil and current.Name == name
end

function Panels.Refresh(state: { [string]: any })
	lastState = state
	local entry = current
	if entry and entry.Api.Refresh then
		entry.Api.Refresh(state)
	end
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">SettingsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Settings: music and sound effect toggles (saved to the player's profile).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Modules.Net)
local Kit = require(script.Parent.Kit)
local Panels = require(script.Parent.Panels)

local SettingsPanel = {}

function SettingsPanel.Register()
	Panels.Register("Settings", "⚙️ Settings", Vector2.new(460, 300), function(content)
		Kit.list(Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top).Parent =
			content
		local toggles: { [string]: TextButton } = {}
		local values: { [string]: boolean } = { Music = true, Sfx = true }
		for order, entry in { { Key = "Music", Label = "🎵 Music" }, { Key = "Sfx", Label = "🔊 Sound Effects" } } do
			local row = Kit.new("Frame", {
				LayoutOrder = order,
				Size = UDim2.new(1, -20, 0, 60),
				BackgroundTransparency = 1,
				Parent = content,
			})
			Kit.label({
				Text = entry.Label,
				Size = UDim2.new(0.6, 0, 1, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxTextSize = 28,
				Parent = row,
			})
			local key = entry.Key
			toggles[key] = Kit.button({
				Text = "ON",
				Color = Kit.Colors.Green,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(120, 50),
				Parent = row,
				OnClick = function()
					values[key] = not values[key]
					Net.Event("Settings"):FireServer(key, values[key])
				end,
			})
		end
		Kit.label({
			LayoutOrder = 10,
			Text = "Beam a Brainrot · made with love",
			Size = UDim2.new(1, -20, 0, 24),
			TextColor3 = Kit.Colors.Muted,
			MaxTextSize = 18,
			Parent = content,
		})

		local function refresh(state: { [string]: any })
			local settings = state.Settings or {}
			for key, button in toggles do
				local on = settings[key] ~= false
				values[key] = on
				button.Text = if on then "ON" else "OFF"
				Kit.setButtonColor(button, if on then Kit.Colors.Green else Kit.Colors.Grey)
			end
		end
		return { Refresh = refresh }
	end)
end

return SettingsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">UpgradePanel</string>
              <string name="Source"><![CDATA[--!strict
-- Upgrade panel: Crystal (catch power), Door (raid defence), Base Tier (new theme + pedestals) and Rebirth.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Themes = require(Shared.Config.Themes)
local Format = require(Shared.Modules.Format)
local Net = require(Shared.Modules.Net)
local Kit = require(script.Parent.Kit)
local Panels = require(script.Parent.Panels)

local UpgradePanel = {}

type Card = {
	Frame: Frame,
	Level: TextLabel,
	Stat: TextLabel,
	Button: TextButton,
}

local function makeCard(
	parent: Instance,
	order: number,
	icon: string,
	title: string,
	color: Color3,
	onClick: () -> ()
): Card
	local frame = Kit.panelFrame({
		Name = title,
		LayoutOrder = order,
		Size = UDim2.new(1 / 3, -8, 1, 0),
		BackgroundColor3 = Kit.darken(color, 0.55),
		Parent = parent,
	})
	Kit.label({
		Text = icon,
		Size = UDim2.new(1, 0, 0, 52),
		Position = UDim2.fromOffset(0, 8),
		MaxTextSize = 48,
		Parent = frame,
	})
	Kit.label({
		Text = title,
		Size = UDim2.new(1, -12, 0, 30),
		Position = UDim2.fromOffset(6, 62),
		TextColor3 = color,
		MaxTextSize = 28,
		Parent = frame,
	})
	local level = Kit.label({
		Text = "Lv 1",
		Size = UDim2.new(1, -12, 0, 24),
		Position = UDim2.fromOffset(6, 94),
		MaxTextSize = 22,
		Parent = frame,
	})
	local stat = Kit.label({
		Text = "",
		Size = UDim2.new(1, -12, 0, 48),
		Position = UDim2.fromOffset(6, 122),
		TextColor3 = Kit.Colors.Muted,
		MaxTextSize = 20,
		TextWrapped = true,
		Parent = frame,
	})
	local button = Kit.button({
		Text = "$0",
		Color = color,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -20, 0, 54),
		TextSize = 26,
		Parent = frame,
		OnClick = onClick,
	})
	return { Frame = frame, Level = level, Stat = stat, Button = button }
end

function UpgradePanel.Register(toast: (string, string?) -> ())
	Panels.Register("Upgrade", "⬆️ Upgrade Your Base", Vector2.new(760, 470), function(content)
		local row = Kit.new("Frame", {
			Size = UDim2.new(1, 0, 1, -76),
			BackgroundTransparency = 1,
			Parent = content,
		})
		Kit.list(Enum.FillDirection.Horizontal, 12).Parent = row

		local function request(kind: string)
			local ok, message = Net.Function("Upgrade"):InvokeServer(kind)
			toast(message, if ok then "good" else "warn")
		end

		local crystal = makeCard(row, 1, "💎", "Crystal", Kit.Colors.Blue, function()
			request("Crystal")
		end)
		local door = makeCard(row, 2, "🚪", "Door", Kit.Colors.Orange, function()
			request("Door")
		end)
		local tier = makeCard(row, 3, "🏰", "Base Tier", Kit.Colors.Purple, function()
			request("Tier")
		end)

		local rebirthBar = Kit.panelFrame({
			Name = "Rebirth",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 64),
			BackgroundColor3 = Color3.fromRGB(70, 30, 80),
			Parent = content,
		})
		local rebirthText = Kit.label({
			Text = "",
			Size = UDim2.new(0.66, -12, 1, -12),
			Position = UDim2.fromOffset(10, 6),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 22,
			TextWrapped = true,
			Parent = rebirthBar,
		})
		local armed = false
		local rebirthButton: TextButton
		rebirthButton = Kit.button({
			Text = "♻️ REBIRTH",
			Color = Kit.Colors.Pink,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.new(0.33, -8, 1, -14),
			TextSize = 26,
			Parent = rebirthBar,
			OnClick = function()
				-- Rebirth resets cash and upgrades, so it takes a confirming second tap.
				if not armed then
					armed = true
					rebirthButton.Text = "TAP TO CONFIRM"
					task.delay(3, function()
						armed = false
						if rebirthButton.Parent then
							rebirthButton.Text = "♻️ REBIRTH"
						end
					end)
					return
				end
				armed = false
				rebirthButton.Text = "♻️ REBIRTH"
				local ok, message = Net.Function("Rebirth"):InvokeServer()
				toast(message, if ok then "good" else "warn")
			end,
		})

		local function refresh(state: { [string]: any })
			local tierNow: number = state.Tier
			local maxLevel = Economy.MaxLevelForTier(tierNow)
			local passes = state.Passes or {}
			local mult = 1 + (state.Rebirths or 0) * Economy.RebirthPowerBonus

			local crystalMult = mult * (if passes.SuperCrystal then 1.25 else 1)
			crystal.Level.Text = string.format("Lv %d / %d", state.CrystalLevel, maxLevel)
			if state.CrystalLevel >= maxLevel then
				crystal.Stat.Text = string.format("💎 %s\nMAXED for this tier", Format.Short(state.CrystalPower))
				crystal.Button.Text = "MAX"
				Kit.setButtonColor(crystal.Button, Kit.Colors.Grey)
			else
				local nextPower = Economy.CrystalPower(state.CrystalLevel + 1, crystalMult)
				local cost = Economy.CrystalCost(state.CrystalLevel)
				crystal.Stat.Text = string.format(
					"💎 %s → %s\nBeam stronger brainrots",
					Format.Short(state.CrystalPower),
					Format.Short(nextPower)
				)
				crystal.Button.Text = Format.Cash(cost)
				Kit.setButtonColor(crystal.Button, if state.Cash >= cost then Kit.Colors.Green else Kit.Colors.Grey)
			end

			local doorMult = mult * (if passes.Fortress then 1.5 else 1)
			door.Level.Text = string.format("Lv %d / %d", state.DoorLevel, maxLevel)
			if state.DoorLevel >= maxLevel then
				door.Stat.Text = string.format("🚪 %s\nMAXED for this tier", Format.Short(state.DoorStrength))
				door.Button.Text = "MAX"
				Kit.setButtonColor(door.Button, Kit.Colors.Grey)
			else
				local nextStrength = Economy.DoorStrength(state.DoorLevel + 1, doorMult)
				local cost = Economy.DoorCost(state.DoorLevel)
				door.Stat.Text = string.format(
					"🚪 %s → %s\nStops raids",
					Format.Short(state.DoorStrength),
					Format.Short(nextStrength)
				)
				door.Button.Text = Format.Cash(cost)
				Kit.setButtonColor(door.Button, if state.Cash >= cost then Kit.Colors.Green else Kit.Colors.Grey)
			end

			local theme = Themes.Get(tierNow)
			tier.Level.Text = string.format("Tier %d · %s", tierNow, theme.Name)
			if tierNow >= Economy.MaxTier then
				tier.Stat.Text = "MAX TIER!\nRebirth for more power"
				tier.Button.Text = "MAX"
				Kit.setButtonColor(tier.Button, Kit.Colors.Grey)
			else
				local nextTheme = Themes.Get(tierNow + 1)
				local cost = Economy.TierCost(tierNow)
				local ready = Economy.CanTierUp(tierNow, state.CrystalLevel)
				tier.Stat.Text = if ready
					then string.format(
						"→ %s\n%d pedestals + rarer brainrots",
						nextTheme.Name,
						Economy.Slots(tierNow + 1)
					)
					else string.format("Max your crystal\n(Lv %d) to unlock", maxLevel)
				tier.Button.Text = if ready then Format.Cash(cost) else "🔒"
				Kit.setButtonColor(
					tier.Button,
					if ready and state.Cash >= cost then Kit.Colors.Green else Kit.Colors.Grey
				)
			end

			local canRebirth = Economy.CanRebirth(tierNow, state.CrystalLevel, state.Cash, state.Rebirths or 0)
			rebirthText.Text = string.format(
				"♻️ Rebirth %d → +%d%% cash, +%d%% power, keep your brainrots! Needs Tier %d, max crystal, %s",
				(state.Rebirths or 0) + 1,
				math.floor(Economy.RebirthCashBonus * 100),
				math.floor(Economy.RebirthPowerBonus * 100),
				Economy.MaxTier,
				Format.Cash(Economy.RebirthCost(state.Rebirths or 0))
			)
			Kit.setButtonColor(rebirthButton, if canRebirth then Kit.Colors.Pink else Kit.Colors.Grey)
		end

		return { Refresh = refresh }
	end)
end

return UpgradePanel
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
