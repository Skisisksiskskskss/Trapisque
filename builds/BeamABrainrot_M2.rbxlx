        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Pure economy formulas. Tuned with the pacing simulation in tests/economy.spec.luau (see DECISIONS.md).

local Economy = {}

Economy.MaxTier = 10
Economy.LevelsPerTier = 10
Economy.SlotsPerTier = { 4, 6, 8, 10, 12, 14, 16, 18, 21, 24 }

Economy.CrystalBase = 12
Economy.DoorBase = 20
Economy.PowerGrowth = 1.12
Economy.CrystalCostBase = 22
Economy.CostGrowth = 1.165
Economy.DoorCostFactor = 0.8
Economy.TierCostBase = 600
Economy.TierCostGrowth = 6.5
Economy.RebirthCostBase = 1e9
Economy.RebirthCostGrowth = 3
Economy.RebirthCashBonus = 0.5
Economy.RebirthPowerBonus = 0.15
Economy.IndexBonusPerEntry = 0.02 -- +2% cash per unique brainrot discovered

export type Multipliers = {
	cash: number,
	crystal: number,
	door: number,
	luck: number,
}

function Economy.MaxLevelForTier(tier: number): number
	return tier * Economy.LevelsPerTier
end

function Economy.Slots(tier: number): number
	local clamped = math.clamp(tier, 1, Economy.MaxTier)
	return Economy.SlotsPerTier[clamped]
end

function Economy.CrystalPower(level: number, mult: number): number
	return Economy.CrystalBase * Economy.PowerGrowth ^ (level - 1) * mult
end

function Economy.DoorStrength(level: number, mult: number): number
	return Economy.DoorBase * Economy.PowerGrowth ^ (level - 1) * mult
end

function Economy.CrystalCost(level: number): number
	return math.floor(Economy.CrystalCostBase * Economy.CostGrowth ^ (level - 1))
end

function Economy.DoorCost(level: number): number
	return math.floor(Economy.CrystalCost(level) * Economy.DoorCostFactor)
end

function Economy.TierCost(tier: number): number
	return math.floor(Economy.TierCostBase * Economy.TierCostGrowth ^ (tier - 1))
end

function Economy.RebirthCost(rebirths: number): number
	return Economy.RebirthCostBase * Economy.RebirthCostGrowth ^ rebirths
end

function Economy.CanTierUp(tier: number, crystalLevel: number): boolean
	return tier < Economy.MaxTier and crystalLevel >= Economy.MaxLevelForTier(tier)
end

function Economy.CanRebirth(tier: number, crystalLevel: number, cash: number, rebirths: number): boolean
	return tier >= Economy.MaxTier
		and crystalLevel >= Economy.MaxLevelForTier(Economy.MaxTier)
		and cash >= Economy.RebirthCost(rebirths)
end

-- Sell value of a brainrot: 60 seconds of its income, so selling is a convenience, never a money printer.
function Economy.SellValue(incomePerSecond: number): number
	return math.floor(incomePerSecond * 60)
end

-- Cash pack amount: N seconds of the player's current income, never below the floor.
function Economy.ScaledCash(incomePerSecond: number, seconds: number, floor: number): number
	return math.max(floor, math.floor(incomePerSecond * seconds))
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Global tuning constants. Every number a designer might want to tweak lives here or in Economy.

local GameConfig = {
	MaxPlots = 8,

	-- Map geometry (studs)
	PortalRadius = 14,
	BaseFrontRadius = 92, -- distance from map centre to the base's front wall
	BaseSize = 64, -- square plot edge
	RingRoadRadius = 84, -- escaped brainrots run a lap on this circle
	BeamStopDistance = 9, -- brainrot stops this far in front of the door for the showdown

	-- Wave timing (seconds)
	WaveInterval = 50,
	EmergeTime = 1.4,
	WalkSpeed = 11, -- studs per second
	ShowdownTime = 2.2,
	BossEvery = 5,
	FirstWaveDelay = 6, -- newcomer personal wave
	BossPowerMin = 1.1, -- boss power relative to the player's crystal power
	BossPowerMax = 2.2,

	-- Charging
	ChargePerTap = 0.02,
	ChargeMax = 0.30,
	ChargeMinTapInterval = 0.05,

	-- Doors / raids
	DoorBrokenTime = 40,
	DoorRepairPerHoldSecond = 4, -- seconds removed from the broken timer per second of holding REPAIR
	NewbieShieldMinutes = 10,

	-- Stealing
	StealHoldDuration = 1.2,
	CarrySpeedMultiplier = 0.7,
	CarryTimeout = 45,
	StealImmunitySeconds = 60, -- a freshly stolen brainrot cannot be re-stolen for this long

	-- Bonk
	BonkRange = 9,
	BonkCooldown = 0.9,
	BonkKnockback = 55,

	-- Escaped brainrots
	EscapeSpeed = 16,
	EscapeLaps = 1,

	-- Storage
	StorageMax = 50,

	-- Offline
	OfflineRate = 0.5,
	OfflineCapHours = 8,
	OfflineCapHoursVip = 12,
	OfflineMinSeconds = 120,

	-- Saving
	AutosaveInterval = 60,
	DataStoreName = "BeamABrainrot_PlayerData_v1",

	-- Base character speed
	PlayerWalkSpeed = 20,
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Mutations</string>
            <string name="Source"><![CDATA[--!strict
-- Mutations recolour a brainrot and multiply its income and power.

export type Mutation = {
	Name: string,
	Chance: number, -- percent per wave
	IncomeMult: number,
	PowerMult: number,
	Color: Color3?,
	Material: Enum.Material?,
	Announce: boolean,
}

local list: { Mutation } = {
	{ Name = "None", Chance = 0, IncomeMult = 1, PowerMult = 1, Announce = false },
	{
		Name = "Gold",
		Chance = 4,
		IncomeMult = 2,
		PowerMult = 1.25,
		Color = Color3.fromRGB(255, 200, 40),
		Material = Enum.Material.Foil,
		Announce = false,
	},
	{
		Name = "Diamond",
		Chance = 1.2,
		IncomeMult = 3,
		PowerMult = 1.5,
		Color = Color3.fromRGB(150, 230, 255),
		Material = Enum.Material.Glass,
		Announce = false,
	},
	{
		Name = "Rainbow",
		Chance = 0.35,
		IncomeMult = 5,
		PowerMult = 2,
		Color = Color3.fromRGB(255, 80, 200),
		Material = Enum.Material.Neon,
		Announce = true,
	},
	{
		Name = "Galaxy",
		Chance = 0.05,
		IncomeMult = 10,
		PowerMult = 3,
		Color = Color3.fromRGB(70, 30, 140),
		Material = Enum.Material.Neon,
		Announce = true,
	},
}

local byName: { [string]: Mutation } = {}
for _, mutation in list do
	byName[mutation.Name] = mutation
end

local Mutations = {
	List = list,
	ByName = byName,
}

function Mutations.Get(name: string): Mutation
	return byName[name] or byName.None
end

return Mutations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[--!strict
-- Gamepasses and developer products. After creating them in the Creator Dashboard, paste each numeric id into
-- Id below (README.md lists exact names, prices and descriptions). Price is only a display fallback: the shop
-- shows the live Robux price from MarketplaceService once an id is set.

export type Pass = {
	Key: string,
	Id: number,
	Name: string,
	Price: number,
	Icon: string,
	Description: string,
}

export type Product = {
	Key: string,
	Id: number,
	Name: string,
	Price: number,
	Icon: string,
	Description: string,
	Category: string, -- "Boost" | "Cash" | "Server" | "Hidden"
	Random: boolean, -- paid random item: odds must be shown, hidden where restricted
}

local passes: { Pass } = {
	{
		Key = "VIP",
		Id = 0,
		Name = "VIP",
		Price = 249,
		Icon = "👑",
		Description = "+25% cash, +10% luck, VIP name tag and a free Overcharge every day",
	},
	{
		Key = "DoubleCash",
		Id = 0,
		Name = "2x Cash",
		Price = 399,
		Icon = "💸",
		Description = "Double all cash from your brainrots, forever",
	},
	{
		Key = "AutoCollect",
		Id = 0,
		Name = "Auto Collect",
		Price = 149,
		Icon = "🧲",
		Description = "Cash goes straight to your wallet - no pads to touch",
	},
	{
		Key = "DoubleWave",
		Id = 0,
		Name = "Double Wave",
		Price = 499,
		Icon = "👯",
		Description = "TWO brainrots march to your base every wave",
	},
	{
		Key = "SuperCrystal",
		Id = 0,
		Name = "Super Crystal",
		Price = 299,
		Icon = "💎",
		Description = "+25% crystal power forever",
	},
	{
		Key = "Fortress",
		Id = 0,
		Name = "Fortress Door",
		Price = 199,
		Icon = "🏰",
		Description = "+50% door strength and 2x faster repairs",
	},
}

local products: { Product } = {
	{
		Key = "Overcharge1",
		Id = 0,
		Name = "Overcharge",
		Price = 19,
		Icon = "⚡",
		Description = "+50% crystal power for one wave",
		Category = "Boost",
		Random = false,
	},
	{
		Key = "Overcharge5",
		Id = 0,
		Name = "Overcharge x5",
		Price = 79,
		Icon = "⚡",
		Description = "5 Overcharges (+50% crystal power each)",
		Category = "Boost",
		Random = false,
	},
	{
		Key = "IronDoor",
		Id = 0,
		Name = "Iron Door",
		Price = 35,
		Icon = "🛡️",
		Description = "Your door can't break for 5 minutes",
		Category = "Boost",
		Random = false,
	},
	{
		Key = "LuckyWave",
		Id = 0,
		Name = "Lucky Wave",
		Price = 49,
		Icon = "🍀",
		Description = "Your next brainrot is from your top rarity or better and is guaranteed to be beamed",
		Category = "Boost",
		Random = true,
	},
	{
		Key = "InstantRepair",
		Id = 0,
		Name = "Instant Repair",
		Price = 15,
		Icon = "🔧",
		Description = "Fix your broken door right now",
		Category = "Hidden",
		Random = false,
	},
	{
		Key = "ServerLuck",
		Id = 0,
		Name = "Server Luck",
		Price = 99,
		Icon = "🍀",
		Description = "2x luck for EVERYONE in the server for 15 minutes (your name is announced)",
		Category = "Server",
		Random = false,
	},
	{
		Key = "CashSmall",
		Id = 0,
		Name = "Cash Bag",
		Price = 29,
		Icon = "💵",
		Description = "15 minutes of your income",
		Category = "Cash",
		Random = false,
	},
	{
		Key = "CashMedium",
		Id = 0,
		Name = "Cash Stack",
		Price = 99,
		Icon = "💰",
		Description = "1 hour of your income",
		Category = "Cash",
		Random = false,
	},
	{
		Key = "CashLarge",
		Id = 0,
		Name = "Cash Vault",
		Price = 299,
		Icon = "🏦",
		Description = "5 hours of your income",
		Category = "Cash",
		Random = false,
	},
	{
		Key = "DoubleOffline",
		Id = 0,
		Name = "Double Offline Cash",
		Price = 29,
		Icon = "🌙",
		Description = "Doubles the cash your brainrots made while you were away",
		Category = "Hidden",
		Random = false,
	},
}

-- Cash pack sizes: seconds of current income and the minimum amount.
local cashPacks: { [string]: { Seconds: number, Floor: number } } = {
	CashSmall = { Seconds = 15 * 60, Floor = 5000 },
	CashMedium = { Seconds = 60 * 60, Floor = 25000 },
	CashLarge = { Seconds = 5 * 60 * 60, Floor = 150000 },
}

local passByKey: { [string]: Pass } = {}
local passById: { [number]: Pass } = {}
for _, pass in passes do
	passByKey[pass.Key] = pass
	if pass.Id ~= 0 then
		passById[pass.Id] = pass
	end
end

local productByKey: { [string]: Product } = {}
local productById: { [number]: Product } = {}
for _, product in products do
	productByKey[product.Key] = product
	if product.Id ~= 0 then
		productById[product.Id] = product
	end
end

local Products = {
	Passes = passes,
	Products = products,
	PassByKey = passByKey,
	PassById = passById,
	ProductByKey = productByKey,
	ProductById = productById,
	CashPacks = cashPacks,
	-- Optional: your Roblox group id. Members get a daily bonus; 0 disables the group reward.
	GroupId = 0,
}

return Products
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Rarities</string>
            <string name="Source"><![CDATA[--!strict
-- Rarity tiers. Power and income are per-rarity baselines; each brainrot multiplies them by its own factor.

export type Rarity = {
	Index: number,
	Name: string,
	Color: Color3,
	Weight: number,
	BasePower: number,
	BaseIncome: number,
	UnlockTier: number,
	Announce: boolean,
}

local list: { Rarity } = {
	{
		Index = 1,
		Name = "Common",
		Color = Color3.fromRGB(190, 190, 190),
		Weight = 60,
		BasePower = 10,
		BaseIncome = 1,
		UnlockTier = 1,
		Announce = false,
	},
	{
		Index = 2,
		Name = "Uncommon",
		Color = Color3.fromRGB(90, 215, 90),
		Weight = 25,
		BasePower = 40,
		BaseIncome = 4,
		UnlockTier = 1,
		Announce = false,
	},
	{
		Index = 3,
		Name = "Rare",
		Color = Color3.fromRGB(60, 150, 255),
		Weight = 10,
		BasePower = 120,
		BaseIncome = 14,
		UnlockTier = 2,
		Announce = false,
	},
	{
		Index = 4,
		Name = "Epic",
		Color = Color3.fromRGB(175, 85, 255),
		Weight = 4,
		BasePower = 400,
		BaseIncome = 50,
		UnlockTier = 3,
		Announce = false,
	},
	{
		Index = 5,
		Name = "Legendary",
		Color = Color3.fromRGB(255, 195, 40),
		Weight = 1.2,
		BasePower = 3500,
		BaseIncome = 300,
		UnlockTier = 5,
		Announce = true,
	},
	{
		Index = 6,
		Name = "Mythic",
		Color = Color3.fromRGB(255, 70, 70),
		Weight = 0.3,
		BasePower = 30000,
		BaseIncome = 2000,
		UnlockTier = 7,
		Announce = true,
	},
	{
		Index = 7,
		Name = "Brainrot God",
		Color = Color3.fromRGB(255, 120, 230),
		Weight = 0.06,
		BasePower = 300000,
		BaseIncome = 15000,
		UnlockTier = 9,
		Announce = true,
	},
	{
		Index = 8,
		Name = "Secret",
		Color = Color3.fromRGB(20, 20, 20),
		Weight = 0.01,
		BasePower = 2500000,
		BaseIncome = 90000,
		UnlockTier = 10,
		Announce = true,
	},
}

local byName: { [string]: Rarity } = {}
for _, rarity in list do
	byName[rarity.Name] = rarity
end

local Rarities = {
	List = list,
	ByName = byName,
	Count = #list,
}

function Rarities.Get(index: number): Rarity
	local rarity = list[index]
	assert(rarity ~= nil, "unknown rarity index " .. tostring(index))
	return rarity
end

-- Highest rarity index that can appear for a base tier (Secret also unlocks after the first rebirth).
function Rarities.HighestUnlocked(tier: number, rebirths: number): number
	local highest = 1
	for _, rarity in list do
		if rarity.UnlockTier <= tier then
			highest = rarity.Index
		end
	end
	if rebirths >= 1 then
		highest = math.max(highest, list[#list].Index)
	end
	return highest
end

-- The rarities that normal waves draw from: the highest unlocked and the two below it.
function Rarities.Window(tier: number, rebirths: number): { number }
	local hi = Rarities.HighestUnlocked(tier, rebirths)
	-- Secret is a jackpot add-on, never the anchor of the window.
	local anchor = hi
	if hi == #list and Rarities.HighestUnlocked(tier, 0) < hi then
		anchor = Rarities.HighestUnlocked(tier, 0)
	elseif hi == #list then
		anchor = hi - 1
	end
	local lo = math.max(1, anchor - 2)
	local window = {}
	for i = lo, anchor do
		table.insert(window, i)
	end
	if hi > anchor then
		table.insert(window, hi)
	end
	return window
end

return Rarities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Reward specs used by daily rewards, playtime gifts, codes and Index completion.
-- CashMinutes pays N minutes of the player's current income (never below MinCash) so rewards stay meaningful at
-- every stage of the game.

export type Reward = {
	Cash: number?,
	CashMinutes: number?,
	MinCash: number?,
	Boosts: { [string]: number }?,
}

local Rewards = {}

Rewards.BoostNames = {
	Overcharge = "Overcharge",
	IronDoor = "Iron Door",
	LuckyWave = "Lucky Wave",
	GoldenWave = "Golden Wave",
	InstantRepair = "Instant Repair",
}

Rewards.BoostIcons = {
	Overcharge = "⚡",
	IronDoor = "🛡️",
	LuckyWave = "🍀",
	GoldenWave = "✨",
	InstantRepair = "🔧",
}

-- Index: completing every brainrot of a rarity (base form) unlocks a one-time reward.
Rewards.IndexSets = {
	[1] = { Boosts = { Overcharge = 3 } },
	[2] = { Boosts = { Overcharge = 3, IronDoor = 1 } },
	[3] = { Boosts = { LuckyWave = 1, Overcharge = 2 } },
	[4] = { Boosts = { LuckyWave = 2, IronDoor = 2 } },
	[5] = { Boosts = { GoldenWave = 2, LuckyWave = 2 } },
	[6] = { Boosts = { LuckyWave = 3, GoldenWave = 2 } },
	[7] = { Boosts = { LuckyWave = 5, GoldenWave = 3 } },
	[8] = { Boosts = { LuckyWave = 8, GoldenWave = 5 } },
} :: { [number]: Reward }

-- Short human-readable summary, e.g. "3x ⚡ Overcharge + $12K".
function Rewards.Describe(reward: Reward, cashAmount: number?, formatCash: ((number) -> string)?): string
	local parts = {}
	if cashAmount and cashAmount > 0 and formatCash then
		table.insert(parts, formatCash(cashAmount))
	elseif reward.CashMinutes then
		table.insert(parts, string.format("%d min of cash", reward.CashMinutes))
	elseif reward.Cash and formatCash then
		table.insert(parts, formatCash(reward.Cash))
	end
	if reward.Boosts then
		local names = {}
		for name in reward.Boosts do
			table.insert(names, name)
		end
		table.sort(names)
		for _, name in names do
			local count = reward.Boosts[name]
			table.insert(
				parts,
				string.format("%dx %s %s", count, Rewards.BoostIcons[name] or "", Rewards.BoostNames[name] or name)
			)
		end
	end
	return table.concat(parts, " + ")
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Sizes</string>
            <string name="Source"><![CDATA[--!strict
-- Size traits. Bigger brainrots are worth more and hit harder.

export type Size = {
	Name: string,
	Weight: number,
	Mult: number, -- power and income multiplier
	Scale: number, -- visual scale while walking (pedestal display is clamped)
}

local list: { Size } = {
	{ Name = "Normal", Weight = 75, Mult = 1, Scale = 1 },
	{ Name = "Big", Weight = 18, Mult = 2, Scale = 1.35 },
	{ Name = "Huge", Weight = 6, Mult = 4, Scale = 1.8 },
	{ Name = "Giant", Weight = 1, Mult = 10, Scale = 2.6 },
}

local byName: { [string]: Size } = {}
for _, size in list do
	byName[size.Name] = size
end

local Sizes = {
	List = list,
	ByName = byName,
}

function Sizes.Get(name: string): Size
	return byName[name] or byName.Normal
end

return Sizes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--!strict
-- Sound slots. Paste a Creator Store audio id (numbers only) into Id; empty ids are skipped silently.
-- See ASSETS.md for what to search for each slot.

export type SoundDef = {
	Id: string,
	Volume: number,
	Pitch: number?,
}

local Sounds: { [string]: SoundDef } = {
	Music = { Id = "", Volume = 0.25 },
	WaveHorn = { Id = "", Volume = 0.5 },
	Stampede = { Id = "", Volume = 0.7 },
	Capture = { Id = "", Volume = 0.6 },
	DoorBreak = { Id = "", Volume = 0.8 },
	DoorBlock = { Id = "", Volume = 0.6 },
	Charge = { Id = "", Volume = 0.35 },
	Collect = { Id = "", Volume = 0.45 },
	Upgrade = { Id = "", Volume = 0.5 },
	TierUp = { Id = "", Volume = 0.7 },
	Click = { Id = "", Volume = 0.35 },
	Error = { Id = "", Volume = 0.4 },
	Bonk = { Id = "", Volume = 0.6 },
	Steal = { Id = "", Volume = 0.6 },
	Alarm = { Id = "", Volume = 0.6 },
	Reward = { Id = "", Volume = 0.6 },
	Announce = { Id = "", Volume = 0.5 },
}

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Themes</string>
            <string name="Source"><![CDATA[--!strict
